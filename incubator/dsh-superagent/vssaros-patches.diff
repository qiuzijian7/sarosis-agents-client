+    const file = join(tree(), 'tapd.env')
+    writeFileSync(file, [
+      '# copied from SaroasisStudioSystem/.env.example',
+      'TAPD_CLIENT_ID="cid"',
+      "TAPD_CLIENT_SECRET='secret'",
+      'TAPD_API_TOKEN=tok',
+      'PORT=8765',
+      'FEISHU_APP_SECRET=do-not-leak',
