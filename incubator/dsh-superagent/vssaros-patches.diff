+export class FeishuConsumerExit extends Error {
+  constructor(readonly code: number | null, readonly ready: boolean, readonly diagnostic: string) {
+    super(`Feishu event consumer exited (${code}, ready=${ready}): ${diagnostic}`)
+  }
+}
