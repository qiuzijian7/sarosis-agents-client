+/**
+ * VsSaros patch: synchronous ownership of the state directory.
+ *
+ * `proper-lockfile`'s sync API forbids `retries` (`toSyncOptions` throws ESYNC) and only
+ * reclaims a lock once its mtime is older than `stale`. A Host that is killed and started again
+ * within that window therefore fails with `Lock file is already being held` and never recovers,
+ * even though the process that held the lock is gone. This helper recognises such orphaned locks
+ * before acquiring, while still refusing a second Runtime in the same process (upstream contract).
+ */
+import { readFileSync, realpathSync, rmSync, statSync, writeFileSync } from 'node:fs'
+import { lockSync } from 'proper-lockfile'
+
+/** A lock is stale after this long without an mtime refresh; `proper-lockfile`'s own default. */
+const STALE_MS = 10_000
+/** Refresh the lock's mtime this often so a busy event loop cannot make a live lock look dead. */
+const UPDATE_MS = 2_000
+/** Never block startup longer than this waiting for a lock whose owner cannot be identified. */
+const MAX_WAIT_MS = STALE_MS + 2_000
+
+export interface StateLockOptions {
+  staleMs?: number
+  maxWaitMs?: number
+  /** Overridable so tests need not really sleep. */
+  sleep?: (ms: number) => void
+}
+
+const sleepSync = (ms: number): void => {
+  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, Math.max(1, Math.round(ms)))
+}
+
+/** Whether a process with this pid still exists; EPERM means it does, we just may not signal it. */
+const alive = (pid: number): boolean => {
+  try { process.kill(pid, 0); return true } catch (error) {
+    return (error as NodeJS.ErrnoException).code === 'EPERM'
+  }
+}
+
+/** The pid recorded by the process that last owned the lock, if the record is readable. */
+const ownerOf = (file: string): number | undefined => {
+  try {
+    const pid = Number(JSON.parse(readFileSync(file, 'utf8')).pid)
+    return Number.isInteger(pid) && pid > 0 ? pid : undefined
+  } catch { return undefined }
+}
+
+const mtimeOf = (file: string): number | undefined => {
+  try { return statSync(file).mtimeMs } catch { return undefined }
+}
+
+const codeOf = (error: unknown): string | undefined => (error as NodeJS.ErrnoException | undefined)?.code
+
+/**
+ * Acquire the state-directory lock synchronously, reclaiming a lock only when its recorded owner
+ * process is gone (a killed Host) or its mtime is past `staleMs`. A live owner is refused at once,
+ * so a second Runtime in this process cannot open the same database. Throws the original
+ * `ELOCKED` error when an unidentifiable live lock outlasts `maxWaitMs`.
+ */
+export function acquireStateLock(stateDir: string, onCompromised: (error: Error) => void,
+  options: StateLockOptions = {}): () => void {
+  const staleMs = options.staleMs ?? STALE_MS
+  const maxWaitMs = options.maxWaitMs ?? MAX_WAIT_MS
+  const sleep = options.sleep ?? sleepSync
+  // `proper-lockfile` resolves the target with realpath before building `${file}.lock`; match it.
+  const canonical = realpathSync(stateDir)
+  const lockDir = `${canonical}.lock`
+  const ownerFile = `${canonical}.lock.owner`
+  // Read before acquiring: a lock directory found on entry carries this owner's pid.
+  let previousOwner = ownerOf(ownerFile)
+
+  const reclaim = (): boolean => {
+    const mtime = mtimeOf(lockDir)
+    if (mtime === undefined) return true // The lock disappeared between attempts.
+    if (previousOwner !== undefined && !alive(previousOwner)) {
+      // The process that held the lock is gone: its lock is an orphan.
+      previousOwner = undefined
+      rmSync(lockDir, { recursive: true, force: true })
+      return true
+    }
+    if (Date.now() - mtime >= staleMs) {
+      // Old enough that even proper-lockfile would remove it on its next acquire.
+      rmSync(lockDir, { recursive: true, force: true })
+      return true
+    }
+    return false
+  }
+
+  let waited = 0
+  for (;;) {
+    let release: () => void
+    try {
+      release = lockSync(stateDir, { stale: staleMs, update: UPDATE_MS, onCompromised })
+    } catch (error) {
+      if (codeOf(error) !== 'ELOCKED') throw error
+      if (reclaim()) continue
+      // A live owner keeps the lock: refuse at once, as upstream requires for a second Runtime.
+      if (previousOwner !== undefined && alive(previousOwner)) throw error
+      const mtime = mtimeOf(lockDir) ?? Date.now()
+      const slice = Math.min(Math.max(staleMs - (Date.now() - mtime) + 50, 50), 500)
+      if (waited + slice > maxWaitMs) throw error
+      sleep(slice)
+      waited += slice
+      continue
+    }
+    // Best effort: lets the next process recognise a dead owner without waiting for `staleMs`.
+    try { writeFileSync(ownerFile, JSON.stringify({ pid: process.pid })) } catch { /* Read-only parent: fall back to mtime. */ }
+    return release
+  }
+}
diff --git a/incubator/dsh-superagent/src/app/tapd-webhook.ts b/src/app/tapd-webhook.ts
new file mode 100644
index 00000000000..e4dccac1e6d
--- /dev/null
+++ b/src/app/tapd-webhook.ts
@@ -0,0 +1,185 @@
+/**
+ * VsSaros addition: the optional TAPD Webhook ingress, a fast lane on top of the TAPD Source's polling.
+ *
+ * TAPD's Open Platform POSTs a flat event record (`event`, `workspace_id`, `id`, `event_id`/`queue_id`, `secret`) to
+ * `/orchestrator/webhook/tapd` in JSON or x-www-form-urlencoded form; automation rules may nest the record under
+ * `event` instead. The event carries IDs only, so the item is reread through `TapdApi`, matched against the configured
+ * watches, and only then received. Deletions, comments and every event outside a watch are ignored; polling still owns
+ * comment follow-up and read cursors, so it must stay on.
+ */
+import { createHash, timingSafeEqual } from 'node:crypto'
+import type { IncomingMessage } from 'node:http'
+import { sameName } from '../infra/text.ts'
+import { KV } from '../kv.ts'
+import type { SourceContext } from '../sources/host.ts'
+import { itemThread, itemTrigger, resolvedConfig, signatureOf } from '../sources/tapd.ts'
+import { TAPD_SOURCE, TAPD_TYPES, tapdApi, watchWorkspace,
+  type TapdApi, type TapdConfig, type TapdItem, type TapdType, type TapdWatch } from '../sources/tapd-api.ts'
+import { cleanOwner, platformMembers, refreshPlatformMembers } from '../sources/tapd-members.ts'
+
+/** Fixed path on the loopback Web server; TAPD needs an intranet gateway or reverse proxy to reach it. */
+export const TAPD_WEBHOOK_PATH = '/orchestrator/webhook/tapd'
+const MAX_BODY = 128 * 1024
+const MAX_SEEN = 512
+
+const text = (value: unknown): string => value === undefined || value === null ? '' : String(value)
+const first = (...values: unknown[]): string => {
+  for (const value of values) { const as = text(value); if (as) return as }
+  return ''
+}
+const message = (error: unknown): string => error instanceof Error ? error.message : String(error)
+
+/** An ignorable delivery, or an item/status event whose IDs are complete enough to reread the item. */
+export type TapdWebhookEvent =
+  | { kind: 'ignored'; eventId: string; secret: string; reason: string }
+  | { kind: 'item' | 'status'; eventId: string; secret: string; reason: ''; workspace: string; type: TapdType; id: string }
+
+/**
+ * Reads the shapes TAPD documents (and the nested shape of an automation rule) without trusting the event body: only
+ * a story, bug or task ID in a numeric workspace reaches the Source. Duplicate keys are `event_id`, else `queue_id`,
+ * else a digest of the record so a replay without either is still idempotent.
+ */
+export function parseTapdWebhook(payload: unknown): TapdWebhookEvent | undefined {
+  if (!payload || typeof payload !== 'object' || Array.isArray(payload)) return undefined
+  const raw = payload as Record<string, unknown>
+  const nested = raw.event && typeof raw.event === 'object' && !Array.isArray(raw.event)
+    ? raw.event as Record<string, unknown> : undefined
+  const name = typeof raw.event === 'string' ? raw.event : ''
+  const [objectName, action = ''] = name.split('::')
+  const object = first(objectName, nested?.object_type)
+  const workspace = first(raw.workspace_id, nested?.workspace_id)
+  const id = first(raw.id, nested?.id,
+    nested?.new && typeof nested.new === 'object' ? (nested.new as Record<string, unknown>).id : undefined)
+  const secret = first(raw.secret, nested?.secret)
+  const eventId = first(raw.event_id, raw.queue_id, nested?.event_id, nested?.queue_id)
+    || createHash('sha256').update([name, object, workspace, id, text(raw.created), text(raw.current_user)].join('\u0000')).digest('hex').slice(0, 32)
+
+  const type = (TAPD_TYPES as readonly string[]).includes(object) ? object as TapdType : undefined
+  // TAPD documents comment, attachment, iteration and many other events. Polling follows comments; none of these
+  // bypass the watches, so answer 200 instead of letting TAPD retry a delivery it cannot use.
+  const ignored = (reason: string): TapdWebhookEvent => ({ kind: 'ignored', eventId, secret, reason })
+  if (!type || action === 'delete') return ignored(!type ? `unsupported object ${object || '(none)'}` : 'deleted item')
+  if (!/^\d+$/.test(workspace) || !/^\d+$/.test(id)) return undefined
+  if (action && !['create', 'update', 'status_change'].includes(action)) return ignored(`unsupported event ${name}`)
+  const kind = action === 'status_change' || /(^|,)status(,|$)/.test(text(raw.change_fields)) ? 'status' : 'item'
+  return { kind, eventId, secret, reason: '', workspace, type, id }
+}
+
+/** Constant-time comparison of the configured secret with the body field, a header or a query parameter. */
+export function secretMatches(expected: string, ...given: (string | undefined)[]): boolean {
+  if (!expected) return false
+  const wanted = Buffer.from(expected, 'utf8')
+  return given.some(candidate => {
+    const bytes = Buffer.from(candidate ?? '', 'utf8')
+    return bytes.length === wanted.length && timingSafeEqual(bytes, wanted)
+  })
+}
+
+/** A Webhook event is received only when the reread item still falls inside one of the watches' filters. */
+export function watchMatches(config: TapdConfig, watch: TapdWatch,
+  event: { workspace: string; type: TapdType; id: string }, item: TapdItem): boolean {
+  if (watchWorkspace(config, watch) !== event.workspace || watch.type !== event.type) return false
+  if (watch.item && watch.item !== event.id) return false
+  if (watch.status && watch.status !== item.status) return false
+  const owner = cleanOwner(watch.owner)
+  if (owner && !item.owners.some(candidate => sameName(candidate, owner))) return false
+  if (watch.iteration && watch.iteration !== item.iteration) return false
+  return true
+}
+
+/** TAPD defaults to form data, so a body that is not JSON is read as `x-www-form-urlencoded`. */
+async function readWebhookBody(req: IncomingMessage): Promise<unknown> {
+  let size = 0
+  const chunks: Buffer[] = []
+  for await (const chunk of req) {
+    const bytes = Buffer.from(chunk)
+    size += bytes.length
+    if (size > MAX_BODY) throw new Error(`Webhook body exceeds ${MAX_BODY} bytes`)
+    chunks.push(bytes)
+  }
+  const body = Buffer.concat(chunks).toString('utf8')
+  // TAPD's developer console probes the URL with an empty body; treat it as an empty record rather than bad JSON.
+  if (!body.trim()) return {}
+  try { return JSON.parse(body) as unknown }
+  catch {
+    if (/json/i.test(text(req.headers['content-type']))) throw new Error('The Webhook body is not JSON')
+    return Object.fromEntries(new URLSearchParams(body)) as unknown
+  }
+}
+
+export interface TapdWebhookDeps {
+  /** The TAPD Source's context; the management route builds it through `SourceHost.context`. */
+  context(): SourceContext
+  /** How the item is reread; tests pass a stand-in. */
+  api?(config: TapdConfig, ctx: SourceContext): TapdApi
+}
+export interface TapdWebhookResult { status: number; body: Record<string, unknown> }
+
+/**
+ * Verifies the shared secret, deduplicates `event_id`/`queue_id`, rereads the item and receives one Trigger. Nothing
+ * is stored until the item was read and received, so a failed reread can be retried by TAPD without losing the event.
+ */
+export async function handleTapdWebhook(req: IncomingMessage, deps: TapdWebhookDeps): Promise<TapdWebhookResult> {
+  const ctx = deps.context()
+  const config = ctx.config<TapdConfig>(TAPD_SOURCE)
+  // The endpoint does not exist while off; a half-configured Webhook refuses every delivery rather than accepting it.
+  if (!config || !config.webhook) return { status: 404, body: { error: 'TAPD Webhook is off' } }
+  if (!config.webhookSecret) return { status: 503, body: { error: 'TAPD Webhook secret is not set' } }
+  // The developer console checks the URL's reachability before saving it. A GET/HEAD or an empty POST carries no
+  // event and no secret: answer it without reading the Source. Any delivery with event fields below still needs the
+  // secret, so a probe cannot be used to push a change into the orchestrator.
+  if (req.method === 'GET' || req.method === 'HEAD') return { status: 200, body: { ok: true } }
+  let payload: unknown
+  try { payload = await readWebhookBody(req) }
+  catch (error) { return { status: 400, body: { error: message(error) } } }
+  if (!payload || typeof payload !== 'object' || Array.isArray(payload))
+    return { status: 400, body: { error: 'Unrecognised TAPD Webhook payload' } }
+  const fields = payload as Record<string, unknown>
+  if (!fields.event && !fields.id && !fields.workspace_id && !fields.secret)
+    return { status: 200, body: { ok: true } }
+  const url = new URL(req.url ?? TAPD_WEBHOOK_PATH, 'http://localhost')
+  if (!secretMatches(config.webhookSecret, first(fields.secret), first(req.headers['x-tapd-secret']),
+    url.searchParams.get('secret') ?? undefined)) return { status: 401, body: { error: 'Invalid TAPD Webhook secret' } }
+
+  const event = parseTapdWebhook(payload)
+  if (!event) return { status: 400, body: { error: 'Unrecognised TAPD Webhook payload' } }
+  if (event.kind === 'ignored') return { status: 200, body: { ignored: event.reason } }
+  await ctx.ready
+  if ((ctx.state.get(KV.tapd.webhookSeen) ?? []).includes(event.eventId))
+    return { status: 200, body: { duplicate: true } }
+
+  let item: TapdItem | undefined
+  try {
+    const api = deps.api?.(config, ctx) ?? tapdApi(config, ctx.commands)
+    item = (await api.items(event.type, event.workspace, { id: event.id })).find(row => row.id === event.id)
+  } catch (error) { return { status: 502, body: { error: `TAPD item reread failed: ${message(error)}` } } }
+  // A deleted item, or one the account may not read: polling decides what to do with it.
+  if (!item) return { status: 200, body: { ignored: 'item not found' } }
+
+  // The Webhook runs in the main bundle, which has its own member-table cache; refresh it before resolving aliases.
+  if (config.memberApi && !platformMembers(config.memberApi)) {
+    try { await refreshPlatformMembers(config.memberApi) } catch { /* static mappings still work */ }
+  }
+  const resolved = resolvedConfig(config)
+  const watch = resolved.watches.find(candidate => watchMatches(resolved, candidate, event, item!))
+  if (!watch) return { status: 200, body: { ignored: 'no matching watch' } }
+  const trigger = itemTrigger(item, event.kind, resolved, watch)
+  const subscribed = (ctx.threads.get(`${TAPD_SOURCE}:${itemThread(item)}`)?.subscriptions.length ?? 0) > 0
+  // The same admission rule as pollWatch: an "assigned/@ only" watch takes in no unaddressed changes.
+  if (resolved.agent && watch.mode === 'assigned' && !trigger.addressed && !subscribed)
+    return { status: 200, body: { ignored: 'not addressed' } }
+
+  const outcome = await ctx.receive(trigger)
+  ctx.atomic(() => {
+    // Remember the item only when a watch state already exists: creating one here would make the next poll treat
+    // every other item in the list as new. The cursor itself is left to polling, which must not skip a change.
+    const state = ctx.state.get(KV.tapd.watch(watch.name))
+    if (state?.signature === signatureOf(resolved, watch)) {
+      ctx.state.set(KV.tapd.watch(watch.name),
+        { ...state, items: { ...state.items, [item!.id]: { owners: item!.owners, status: item!.status } } })
+    }
+    const seen = ctx.state.get(KV.tapd.webhookSeen) ?? []
+    ctx.state.set(KV.tapd.webhookSeen, [...seen, event.eventId].slice(-MAX_SEEN))
+  })
+  return { status: 200, body: { received: outcome, event: event.kind, watch: watch.name, item: item.id } }
+}
diff --git a/incubator/dsh-superagent/src/app/team.ts b/src/app/team.ts
new file mode 100644
index 00000000000..eba1ac852f7
--- /dev/null
+++ b/src/app/team.ts
@@ -0,0 +1,510 @@
+/**
+ * VsSaros addition: team plans of the main Session (the supervisor). A plan is a goal split into steps, each given to a VsSaros Bot;
+ * a step runs once the steps it waits for are done, at most `TEAM_PARALLEL` at a time per plan. The Bots run the steps through the
+ * in-process team bus of vssaros-agents (`Symbol.for('vssaros.team')`), which reports each one when its Bot's turn ends; the report
+ * reaches the main Session as a relay, so it can add steps, ask a person, or answer the request.
+ *
+ * Plans, steps, the Bots taking part, every exchange, the Bots the supervisor created and the drafts waiting for a person are
+ * kept in `team_*` tables of the orchestrator database (prefixed so an old database's schema 6 `task` table is never reused).
+ */
+import { randomUUID } from 'node:crypto'
+import type { Store } from './store.ts'
+
+/** At most this many steps of one plan run at once. */
+export const TEAM_PARALLEL = 3
+/** At most this many Bots the supervisor may create for one plan, and in total. */
+export const TEAM_BOTS_PER_PLAN = 3
+export const TEAM_BOTS_GLOBAL = 20
+/** At most this many steps in one plan, counting those added later. */
+export const TEAM_STEPS_MAX = 12
+/** Tool names whose draft needs a person's approval before the Bot is created. */
+export const HIGH_RISK_TOOLS = /^(bash|pwsh|shell|exec|terminal|git|feishu|im|mail|email|webhook|http|fetch|network|credential|secret|write|deploy|publish|send)/i
+/** An exchange chain of one step (give, report, give again…) stops at this many hops. */
+export const TEAM_HOPS_MAX = 6
+/** A report kept on a step and relayed to the main Session is cut at this many characters; the Bot's session has it all. */
+const REPORT_KEEP = 2000
+
+/** A Bot as the team bus lists it. */
+export interface BotCard {
+  id: string; name: string; role?: string; description: string; skills: string[]; tools: string[]
+  delegatable: boolean; source: 'builtin' | 'custom'; origin?: 'supervisor'
+}
+/** A draft the supervisor asks the Bots plugin to write into its roster. */
+export interface BotDraft {
+  id: string; name: string; description?: string; role?: string; skills?: string[]; tools?: string[]; persona: string
+}
+/** A Bot the supervisor created, kept in the team tables for quota and display. */
+export interface CreatedBot extends BotDraft { planId?: string; preset: string; file: string; at: string }
+/** A high-risk Bot draft waiting for a person in the panel. */
+export interface BotApproval {
+  id: string; planId?: string; draft: BotDraft; risk: string[]; state: 'pending' | 'approved' | 'rejected'; at: string; decidedAt?: string
+}
+/** The Bots plugin creates the Bot; unavailable in older versions of vssaros-agents. */
+export interface CreatedBotView { id: string; name: string; preset: string; file: string }
+/** One assignment of a step to a Bot, as the team bus reports it. */
+export interface AssignmentView {
+  id: string; botId: string; botName: string; sessionId: string
+  status: 'running' | 'done' | 'cancelled'; report: string | null; error: string | null
+}
+/** The in-process team bus of vssaros-agents (0.2.319+); duck-typed so this package does not depend on the Bots package. */
+export interface TeamBus {
+  version: 1
+  available(): boolean
+  listBots(): Promise<BotCard[]>
+  delegate(input: { bot: string; task: string; cwd?: string; fromName?: string }): Promise<AssignmentView>
+  createBot?(input: { draft: BotDraft }): Promise<CreatedBotView>
+  /** VsSaros addition: an external Bot in the Bots roster whose Session is owned by this plugin. */
+  registerExternalBot?(spec: { id: string; name: string; role?: string; description?: string; icon?: string
+    onMessage: (message: { from: string | null; text: string; hop: number; session?: string }) => void | Promise<void> }): () => void
+  get(id: string): Promise<AssignmentView | undefined>
+  cancel(id: string, reason?: string): Promise<AssignmentView>
+  subscribe(listener: (view: AssignmentView) => void | Promise<void>): () => void
+}
+export const TEAM_BUS_KEY = Symbol.for('vssaros.team')
+/** Only one Team in a process may consume the bus's reports; a hot reload disposes the previous subscriber first. */
+const TEAM_SUBSCRIPTION_KEY = Symbol.for('vssaros.team.subscription')
+/** The team bus when vssaros-agents runs in this Host, in the shape it publishes. */
+export function sharedTeamBus(root: object = globalThis): TeamBus | undefined {
+  const bus = (root as Record<symbol, Partial<TeamBus> | undefined>)[TEAM_BUS_KEY]
+  return bus && bus.version === 1 && typeof bus.delegate === 'function' && typeof bus.subscribe === 'function'
+    && typeof bus.available === 'function' ? bus as TeamBus : undefined
+}
+
+export type StepState = 'pending' | 'running' | 'done' | 'failed' | 'cancelled' | 'skipped'
+export interface TeamStep {
+  id: string; planId: string; title: string; spec: string; bot: string; after: string[]; state: StepState
+  hop: number; /** Attempts, when a step was given again after a failure. */ att?: number
+  assignmentId?: string; sessionId?: string; botId?: string; botName?: string
+  report?: string; error?: string; startedAt?: string; endedAt?: string
+}
+export type PlanStatus = 'running' | 'done' | 'failed' | 'cancelled'
+export interface TeamPlan { id: string; goal: string; ticketId?: string; cwd?: string; status: PlanStatus; createdAt: string; endedAt?: string }
+export type ExchangeKind = 'give' | 'report' | 'failed' | 'cancel' | 'system'
+export interface TeamExchange { seq: number; planId: string; stepId?: string; hop: number; from: string; to: string; kind: ExchangeKind; text: string; at: string }
+/** A plan with its steps, Bots and exchanges, as the panel and the main Session read it. */
+export interface PlanView extends TeamPlan { steps: TeamStep[]; bots: string[]; exchanges: TeamExchange[]; running: number }
+/** A step as the main Session describes it; `after` names other steps of the same call or of the plan by `key`. */
+export interface StepInput { key: string; title: string; spec: string; bot: string; after?: string[] }
+
+/** A plan the main Session cannot make or change as given; answered to it with the reason. */
+export class TeamError extends Error {}
+
+const now = () => new Date().toISOString()
+const SUPERVISOR = 'SuperAgent'
+
+/** The four team tables in the orchestrator database; the Store opens the database and owns its transactions. */
+export class TeamStore {
+  constructor(private readonly store: Pick<Store, 'db' | 'atomic'>) {
+    store.db.exec(`
+      CREATE TABLE IF NOT EXISTS team_plan (id TEXT PRIMARY KEY, status TEXT NOT NULL, value TEXT NOT NULL);
+      CREATE TABLE IF NOT EXISTS team_task (id TEXT PRIMARY KEY, plan TEXT NOT NULL, value TEXT NOT NULL);
+      CREATE TABLE IF NOT EXISTS team_member (plan TEXT NOT NULL, bot TEXT NOT NULL, at TEXT NOT NULL, PRIMARY KEY (plan, bot));
+      CREATE TABLE IF NOT EXISTS team_exchange (seq INTEGER PRIMARY KEY AUTOINCREMENT, plan TEXT NOT NULL, value TEXT NOT NULL);
+      CREATE TABLE IF NOT EXISTS team_bot (id TEXT PRIMARY KEY, plan TEXT NOT NULL, value TEXT NOT NULL, at TEXT NOT NULL);
+      CREATE TABLE IF NOT EXISTS team_approval (id TEXT PRIMARY KEY, state TEXT NOT NULL, value TEXT NOT NULL, at TEXT NOT NULL);
+      CREATE INDEX IF NOT EXISTS team_task_plan ON team_task(plan);
+      CREATE INDEX IF NOT EXISTS team_exchange_plan ON team_exchange(plan, seq);
+      CREATE INDEX IF NOT EXISTS team_bot_plan ON team_bot(plan);
+      CREATE INDEX IF NOT EXISTS team_approval_state ON team_approval(state, at);
+    `)
+  }
+  atomic<T>(run: () => T): T { return this.store.atomic(run) }
+  plan(id: string): TeamPlan | undefined {
+    const row = this.store.db.prepare('SELECT value FROM team_plan WHERE id=?').get(id)
+    return row ? JSON.parse(String(row.value)) as TeamPlan : undefined
+  }
+  savePlan(plan: TeamPlan): void {
+    this.store.db.prepare('INSERT INTO team_plan VALUES (?,?,?) ON CONFLICT(id) DO UPDATE SET status=excluded.status, value=excluded.value')
+      .run(plan.id, plan.status, JSON.stringify(plan))
+  }
+  /** Newest first. */
+  plans(limit = 20): TeamPlan[] {
+    return this.store.db.prepare('SELECT value FROM team_plan ORDER BY rowid DESC LIMIT ?').all(limit).map(row => JSON.parse(String(row.value)) as TeamPlan)
+  }
+  running(): TeamPlan[] {
+    return this.store.db.prepare("SELECT value FROM team_plan WHERE status='running' ORDER BY rowid").all().map(row => JSON.parse(String(row.value)) as TeamPlan)
+  }
+  /** In the order they were added. */
+  steps(planId: string): TeamStep[] {
+    return this.store.db.prepare('SELECT value FROM team_task WHERE plan=? ORDER BY rowid').all(planId).map(row => JSON.parse(String(row.value)) as TeamStep)
+  }
+  saveStep(step: TeamStep): void {
+    this.store.db.prepare('INSERT INTO team_task VALUES (?,?,?) ON CONFLICT(id) DO UPDATE SET value=excluded.value').run(`${step.planId}/${step.id}`, step.planId, JSON.stringify(step))
+  }
+  join(planId: string, bot: string): void { this.store.db.prepare('INSERT OR IGNORE INTO team_member VALUES (?,?,?)').run(planId, bot, now()) }
+  bots(planId: string): string[] { return this.store.db.prepare('SELECT bot FROM team_member WHERE plan=? ORDER BY at').all(planId).map(row => String(row.bot)) }
+  exchange(entry: Omit<TeamExchange, 'seq' | 'at'>): void {
+    this.store.db.prepare('INSERT INTO team_exchange (plan, value) VALUES (?,?)').run(entry.planId, JSON.stringify({ ...entry, at: now() }))
+  }
+  exchanges(planId: string, limit = 200): TeamExchange[] {
+    return this.store.db.prepare('SELECT seq, value FROM team_exchange WHERE plan=? ORDER BY seq DESC LIMIT ?').all(planId, limit)
+      .map(row => ({ ...JSON.parse(String(row.value)) as Omit<TeamExchange, 'seq'>, seq: Number(row.seq) })).reverse()
+  }
+  saveBot(bot: CreatedBot): void {
+    this.store.db.prepare('INSERT INTO team_bot VALUES (?,?,?,?) ON CONFLICT(id) DO UPDATE SET value=excluded.value')
+      .run(bot.id, bot.planId ?? '', JSON.stringify(bot), bot.at)
+  }
+  bot(id: string): CreatedBot | undefined {
+    const row = this.store.db.prepare('SELECT value FROM team_bot WHERE id=?').get(id)
+    return row ? JSON.parse(String(row.value)) as CreatedBot : undefined
+  }
+  botsIn(planId: string): CreatedBot[] {
+    return this.store.db.prepare('SELECT value FROM team_bot WHERE plan=?').all(planId).map(row => JSON.parse(String(row.value)) as CreatedBot)
+  }
+  createdBots(): CreatedBot[] {
+    return this.store.db.prepare('SELECT value FROM team_bot ORDER BY at').all().map(row => JSON.parse(String(row.value)) as CreatedBot)
+  }
+  saveApproval(approval: BotApproval): void {
+    this.store.db.prepare('INSERT INTO team_approval VALUES (?,?,?,?) ON CONFLICT(id) DO UPDATE SET state=excluded.state, value=excluded.value')
+      .run(approval.id, approval.state, JSON.stringify(approval), approval.at)
+  }
+  approval(id: string): BotApproval | undefined {
+    const row = this.store.db.prepare('SELECT value FROM team_approval WHERE id=?').get(id)
+    return row ? JSON.parse(String(row.value)) as BotApproval : undefined
+  }
+  approvals(state?: BotApproval['state']): BotApproval[] {
