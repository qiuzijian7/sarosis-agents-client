# LightAI 适配器配置
# 复制为 .env 后填入真实值。cookie / x-user-id 来自登录后的浏览器：
#   打开 LightAI 网页 -> F12 -> Network -> 任意请求 -> 复制 Request Headers 里的
#   cookie 与 x-user-id。这些凭据会过期，过期后重新复制更新即可。

# 监听端口（默认 8011）
PORT=8011

# LightAI 上游地址（一般无需改）
LIGHTAI_BASE_URL=https://lightai-gemini-chat-v1-sd.aigclsp.com

# 登录会话凭据（必填）
LIGHTAI_COOKIE=sessionid=xxxx; uid=xxxx
LIGHTAI_USER_ID=zijianqiu@tencent.com

# 应用/项目上下文（来自 URL 的 k 参数，默认即萨罗斯GR项目）
LIGHTAI_APP_ID=137
LIGHTAI_BIZ_ID=73
LIGHTAI_APP_NAME=智能对话
LIGHTAI_PROJECT_NAME=萨罗斯GR项目
LIGHTAI_USER_TYPE=内部用户
LIGHTAI_COMPANY=腾讯-二方公司

# 可用模型列表（逗号分隔，用户可在 VsSaros 里选）
LIGHTAI_MODELS=gemini-3.5-flash

# k 参数（referer，保持与浏览器一致）
LIGHTAI_REFERER_K=YXBwX2lkPTEzNyZhcHBfbmFtZT3mmbrog73lr7nor50mcHJvZHVjdF9pZD03MyZwcm9kdWN0X25hbWU96JCo572X5pavR1Lpobnnm64=&lang=zh_CN
