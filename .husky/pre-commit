#!/bin/sh

# VsSarosis pre-commit hook
# 每次提交前自动更新版本号文件（package.json + product.json）
# 版本号格式: {major}.{a}.{b}，a=floor(commitCount/65536), b=commitCount%65536
# 一次调用 git rev-list --count HEAD，保证两个文件版本号一致

echo "📦 自动更新版本号..."

# 一次性更新 product.json 和 package.json（共享同一个 commitCount）
node build/saros/set-all-versions.cjs

# 将更新后的文件加入暂存区
git add package.json product.json

echo "✅ pre-commit hook 完成"
