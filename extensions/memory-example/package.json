{
  "name": "memory-example",
  "version": "0.0.1",
  "type": "module",
  "main": "./out/extension.js",
  "activationEvents": [],
  "engines": {
    "vscode": "^1.100.0"
  },
  "contributes": {
    "agentCapabilities": [
      {
        "capability": "memory",
        "provider": "memory-example",
        "priority": 50
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "typescript": "^5.8.2"
  }
}
