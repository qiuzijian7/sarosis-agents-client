{
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"lib": ["ES2022", "DOM"],
		"outDir": "./out",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"types": ["node"],
		"typeRoots": ["../../node_modules/@types"],
		"paths": {
			"@saros/shared": ["../shared/out/index"],
			"@saros/shared/*": ["../shared/out/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "out"]
}
