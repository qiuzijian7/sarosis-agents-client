{
	"name": "tdb-am-viewer",
	"displayName": "TDB-AM Viewer",
	"description": "TencentDB Agent Memory：拉起 TDB-AM gateway 与 Knot→OpenAI 协议适配器（L0/L1/L2/L3 记忆 UI 已迁移到 Sessions ViewPane）。",
	"version": "0.0.1",
	"publisher": "saros",
	"license": "MIT",
	"engines": {
		"vscode": "^1.95.0"
	},
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "tdb-am-viewer.restartServices",
				"title": "重启服务（Knot 桥）",
				"category": "TDB-AM"
			},
			{
				"command": "tdb-am-viewer.stopServices",
				"title": "停止 Knot 桥",
				"category": "TDB-AM"
			},
			{
				"command": "tdb-am-viewer.healthCheck",
				"title": "健康检查（gateway + Knot 桥）",
				"category": "TDB-AM"
			}
		],
		"configuration": {
			"type": "object",
			"title": "TDB-AM Viewer",
			"properties": {
				"tdbam.gatewayPort": {
					"type": "number",
					"default": 8420,
					"description": "TDB-AM gateway 监听端口（由 tdb-am-gateway 扩展进程内启动，无需外部进程）。",
					"scope": "application"
				},
				"tdbam.knotBridgePort": {
					"type": "number",
					"default": 8421,
					"description": "Knot → OpenAI 协议适配器端口。",
					"scope": "application"
				},
				"tdbam.knotAgentId": {
					"type": "string",
					"default": "",
					"description": "用于 L1/L2/L3 抽取的 Knot Agent ID（在 knot.woa.com/settings 创建）。留空时自动取 knot.agents 第一项。",
					"scope": "application"
				},
				"tdbam.dataDir": {
					"type": "string",
					"default": "",
					"description": "TDB-AM 数据目录（SQLite / L0 jsonl 落盘位置）。留空使用默认 ~/.tdai。",
					"scope": "application"
				},
				"tdbam.recallStrategy": {
					"type": "string",
					"enum": [
						"keyword",
						"hybrid",
						"embedding"
					],
					"default": "keyword",
					"description": "召回策略。PoC 阶段使用 keyword（FTS5），不需要 embedding。",
					"scope": "application"
				},
				"tdbam.autoStart": {
					"type": "boolean",
					"default": true,
					"description": "VS Code 启动时自动拉起 Knot 桥；TDB-AM gateway 由 tdb-am-gateway 扩展独立管理。",
					"scope": "application"
				}
			}
		}
	},
	"scripts": {
		"compile": "tsc -p ./tsconfig.json",
		"watch": "tsc -watch -p ./tsconfig.json"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/vscode": "^1.95.0",
		"typescript": "^5.8.2"
	}
}
