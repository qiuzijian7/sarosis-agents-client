{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"module": "commonjs",
		"types": ["node", "vscode"],
		"typeRoots": ["./node_modules/@types"],
		"esModuleInterop": true,
		"strict": true,
		"noImplicitAny": false,
		"outDir": "./out",
		"rootDir": "./src",
		"sourceMap": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "out"]
}
