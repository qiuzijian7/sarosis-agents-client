{
	"name": "tdb-am-memory",
	"displayName": "TDB-AM Memory",
	"description": "TencentDB Agent Memory 召回适配器：把 sarosis 的 LLM 调用与 TDB-AM gateway 的 /memory/recall 接入。",
	"version": "0.0.1",
	"publisher": "sarosis",
	"license": "MIT",
	"type": "module",
	"main": "./out/extension.js",
	"engines": {
		"vscode": "^1.100.0"
	},
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"agentCapabilities": [
			{
				"capability": "memory",
				"provider": "tdb-am-memory",
				"priority": 80
			}
		]
	},
	"scripts": {
		"compile": "tsc -p ./tsconfig.json",
		"watch": "tsc -watch -p ./tsconfig.json"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"typescript": "^5.8.2"
	}
}
