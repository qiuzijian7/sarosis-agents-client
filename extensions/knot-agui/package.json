{
	"name": "sarosis-knot-agui",
	"displayName": "Knot AG-UI Model Provider",
	"description": "Contributes Knot AG-UI remote agents as a VS Code chat model provider via vscode.lm.registerLanguageModelChatProvider.",
	"version": "1.0.0",
	"publisher": "sarosis",
	"license": "MIT",
	"engines": {
		"vscode": "^1.95.0"
	},
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension",
	"contributes": {
		"chatPlugins": [
			{
				"path": "./plugin"
			}
		],
		"languageModelChatProviders": [
			{
				"vendor": "knot",
				"displayName": "Knot"
			}
		],
		"configuration": {
			"type": "object",
			"title": "Knot AG-UI",
			"properties": {
				"knot.token": {
					"type": "string",
					"default": "",
					"description": "Knot 平台 API Token（在 knot.woa.com/settings/token 生成）",
					"scope": "application",
					"markdownDescription": "Knot 平台 API Token。前往 [knot.woa.com/settings/token](https://knot.woa.com/settings/token) 生成。"
				},
				"knot.user": {
					"type": "string",
					"default": "",
					"description": "API USER（企微英文名，使用团队 Token 时必填）",
					"scope": "application"
				},
				"knot.endpoint": {
					"type": "string",
					"default": "https://knot.woa.com",
					"description": "Knot AG-UI 服务端 base URL（默认 https://knot.woa.com）。",
					"scope": "application"
				},
				"knot.agents": {
					"type": "array",
					"default": [],
					"markdownDescription": "Agent 列表，每项 `{ id, name, description?, models? }`。每个 agent 在模型选择器中显示为一个 Knot 模型。",
					"items": {
						"type": "object",
						"properties": {
							"id": { "type": "string", "description": "Agent ID（用作 model id）" },
							"name": { "type": "string", "description": "显示名称" },
							"description": { "type": "string" },
							"models": { "type": "array", "items": { "type": "string" } }
						}
					}
				},
				"knot.timeout": {
					"type": "number",
					"default": 60000,
					"description": "请求超时时间（毫秒）。"
				},
				"knot.streaming": {
					"type": "boolean",
					"default": true,
					"description": "启用流式响应。"
				}
			}
		},
		"commands": [
			{ "command": "knot.openSettings", "title": "Knot: Open Settings" },
			{ "command": "knot.refreshAgents", "title": "Knot: Refresh Agent List" }
		]
	},
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./"
	},
	"devDependencies": {
		"@types/node": "22.x"
	}
}
