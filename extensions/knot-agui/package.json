{
	"name": "saros-knot-agui",
	"displayName": "KnotBot（原KnotClaw）",
	"description": "KnotBot（原KnotClaw）是基于 Knot 提供的【智能体】+【工作区】能力而实现的，具备打通消息端（企微机器人、微信），和你的 Anydev 容器、个人 Mac/Win/Linux 等设备这条链路。KnotBot（原KnotClaw）就是基于 Knot 的自有能力来实现你的「个人数字助理」这个场景，实现通过\"消息端发送自然语言\"来\"远程控制你的工作设备\"的过程。",
	"version": "1.0.0",
	"publisher": "saros",
	"license": "MIT",
	"engines": {
		"vscode": "^1.95.0"
	},
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"chatPlugins": [
			{
				"path": "./plugin"
			}
		],
		"languageModelChatProviders": [
			{
				"vendor": "knot",
				"displayName": "Knot"
			}
		],
		"configuration": {
			"type": "object",
			"title": "Knot AG-UI",
			"properties": {
				"knot.token": {
					"type": "string",
					"default": "",
					"description": "Knot 平台 API Token（在 knot.woa.com/settings/token 生成）",
					"scope": "application",
					"markdownDescription": "Knot 平台 API Token。前往 [knot.woa.com/settings/token](https://knot.woa.com/settings/token) 生成。"
				},
				"knot.user": {
					"type": "string",
					"default": "",
					"description": "API USER（企微英文名，使用团队 Token 时必填）",
					"scope": "application"
				},
				"knot.endpoint": {
					"type": "string",
					"default": "https://knot.woa.com",
					"description": "Knot AG-UI 服务端 base URL（默认 https://knot.woa.com）。",
					"scope": "application"
				},
				"knot.agents": {
					"type": "array",
					"default": [],
					"markdownDescription": "Agent 列表，每项 `{ id, name, description?, models? }`。每个 agent 可配置自己支持的模型列表。",
					"items": {
						"type": "object",
						"properties": {
							"id": { "type": "string", "description": "Agent ID（用作 model id）" },
							"name": { "type": "string", "description": "显示名称" },
							"description": { "type": "string" },
							"models": { "type": "array", "items": { "type": "string" }, "description": "该 Agent 支持的模型列表" }
						}
					}
				},
				"knot.models": {
					"type": "string",
					"default": "deepseek-v3.1,deepseek-v3.2,deepseek-v4-flash,glm-5.1,claude-4.7-opus,claude-4.6-sonnet,claude-4.6-sonnet-1m-context,claude-4.6-opus,claude-4.6-opus-1m-context,gpt-5.4,gpt-5.5,hy3-preview,kimi-k2.6",
					"description": "可用模型列表（用英文逗号分隔）。当 knot.agents 为空时使用此列表作为默认模型。",
					"scope": "application",
					"markdownDescription": "可用模型列表，用英文逗号分隔。例如：`deepseek-v3.1,glm-5.1,claude-4.7-opus`\n\n当 knot.agents 为空时，使用此列表作为默认模型。"
				},
			"knot.timeout": {
				"type": "number",
				"default": 60000,
				"description": "请求超时时间（毫秒）。"
			},
			"knot.workspace": {
				"type": "string",
				"default": "",
				"description": "Knot 工作区标识（当无法登录时，可手动指定工作区信息传递给 Knot API）",
				"scope": "application"
			},
			"knot.streaming": {
				"type": "boolean",
				"default": true,
				"description": "启用流式响应。"
			},
			"knot.isServerSideProvider": {
				"type": "boolean",
				"default": true,
				"description": "标识此 provider 是否在服务端完成 agent 循环（tool call → execution → response）。设为 true 时，AgentOS 不会在本地执行工具调用。"
			}
			}
		},
		"commands": [
			{ "command": "knot.openSettings", "title": "Knot: Open Settings" },
			{ "command": "knot.refreshAgents", "title": "Knot: Refresh Agent List" },
			{ "command": "knot.checkCli", "title": "Knot: Check CLI Status" },
			{ "command": "knot.installCli", "title": "Knot: Install CLI" },
			{ "command": "knot.workspace.list", "title": "Knot: List CLI Workspaces" },
			{ "command": "knot.workspace.add", "title": "Knot: Add CLI Workspace" },
			{ "command": "knot.workspace.remove", "title": "Knot: Remove CLI Workspace" }
		]
	},
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./"
	},
	"devDependencies": {
		"@types/node": "22.x"
	}
}
