{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"strict": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": false,
		"outDir": "./out",
		"rootDir": "./src",
		"sourceMap": true,
		"declaration": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "out"]
}
