{
	"//": "vendor 专用 tsconfig — 不被 saros 顶层 gulpfile 扫描，只由 npm run compile:vendor 跑。原因见 tsconfig.json 注释。",
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2022",
			"DOM"
		],
		"module": "Node16",
		"moduleResolution": "Node16",
		"types": [
			"node"
		],
		"typeRoots": [
			"./node_modules/@types"
		],
		"outDir": "out/vendor",
		"rootDir": "vendor",
		"sourceMap": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"noImplicitAny": false,
		"strictPropertyInitialization": false
	},
	"include": [
		"vendor/tdbam/src/**/*"
	],
	"exclude": [
		"node_modules",
		"out",
		"vendor/tdbam/index.openclaw.ts.bak"
	]
}
