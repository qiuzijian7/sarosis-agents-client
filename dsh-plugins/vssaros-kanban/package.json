{
  "name": "@vssaros/dsh-kanban",
  "version": "0.8.15",
  "description": "VsSaros kanban module for DeepSeek Harness: reads the same taskboard.json the IDE writes, exposes read-only tools and a self-hosted page. Data contract: src/vs/sessions/common/agentStudioTypes.ts",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/pageShell.js",
    "lib/board.js",
    "lib/sideview.js",
    "lib/store.js",
    "lib/core/taskboard.js",
    "lib/runner.js",
    "cordis.patch.yml",
    "lib/foundationRef.js",
    "lib/client.kanban.js"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-0 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@vssaros/dsh-workbenches"
      ]
    }
  },
  "vssaros": {
    "manifestVersion": 1,
    "module": "kanban",
    "activityBar": {
      "containerId": "agentStudio.tasks",
      "title": "Tasks",
      "icon": "codicon:tasklist",
      "order": 70
    },
    "view": {
      "kind": "page",
      "route": "/x/kanban/"
    },
    "ideCapabilities": [
      "taskboard",
      "browser"
    ],
    "owns": [
      "taskboard.json",
      "boards.json"
    ],
    "legacyCounterpart": "agentStudio.tasks",
    "workbench": {
      "title": "Tasks",
      "description": "任务看板：按状态管理任务，拖拽改列。",
      "repository": "vssaros:kanban",
      "customFrame": true,
      "icon": "codicon:checklist"
    }
  },
  "license": "MIT",
  "scripts": {
    "check": "node ./test/run-kanban-check.mjs"
  }
}
