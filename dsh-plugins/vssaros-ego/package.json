    "skills",
    "LICENSE",
    "VENDOR.md",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-0 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
