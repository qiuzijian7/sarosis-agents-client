{
  "name": "dsh-superagent-dev",
  "private": true,
  "description": "Development workspace of the VsSaros built-in @vssaros/dsh-superagent (../): its source, tests, documents and build tools. Never shipped: the build writes ../lib.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:gate": "node scripts/test-gate.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "patches": "node scripts/upstream-patches.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-alpha.2"
  },
  "packageManager": "pnpm@11.7.0",
