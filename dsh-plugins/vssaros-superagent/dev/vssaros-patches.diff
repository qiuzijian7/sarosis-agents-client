+      const line = await drain(waterfall('llm/stream', { sessionId: h.runtime.deskId, messages: [person(id, text), { role: 'assistant' }, result], tools }, noModel))
+      return { block, call, line: String(line[1]!.text), trigger }
+    }
+    const asked = await turn('dsh-ask', '帮我看看现在有哪些工单')
+    expect(asked.block).toMatchObject({ name: 'superagent_submit', arguments: '{}', id: expect.stringMatching(/^toolu_superagent_submit_/) })
+    expect(asked.call.at(-1)).toEqual({ type: 'finish', reason: { kind: 'tool-calls' } })
+    expect(asked.line).toBe('已收到，正在按普通流程安排；有进展会在这里告诉你。')
+    // An @group message waits for its session reference; the call waits for the fast path, and the line names the group.
+    const pending = turn('dsh-tomato', '@番茄钟 H5 开发团队 开发H5 番茄钟')
+    await tick(20)
+    emit('session/event', { id: h.runtime.deskId }, { type: 'user/message', data: { id: 'ref-dsh-tomato', role: 'user',
+      source: { kind: 'session-reference', form: 'recall', version: 1, references: [{ sessionId: 'room-tomato', label: room.name }] },
+      content: [{ type: 'text', text: '## Referenced sessions' }] } })
+    const grouped = await pending
+    expect(h.runtime.groupRoutes.get(grouped.trigger)).toMatchObject({ roomId: 'room-tomato', kind: 'routed' })
+    expect(grouped.line).toBe('已转给群「番茄钟 H5 开发团队」。')
+    // SuperAgent's news with the person's message, or news alone, still goes to the desk's model.
+    const MODEL = Symbol('model')
+    const news = { id: 'm-news', role: 'user', source: { kind: 'dsh-superagent' }, content: [{ type: 'text', text: '[SuperAgent] 团队方案…' }] }
+    expect(waterfall('llm/stream', { sessionId: h.runtime.deskId, messages: [news, person('dsh-x', '同意')], tools }, () => MODEL)).toBe(MODEL)
+    expect(waterfall('llm/stream', { sessionId: h.runtime.deskId, messages: [news], tools }, () => MODEL)).toBe(MODEL)
+    // A turn in another Session is not the desk's.
+    expect(waterfall('llm/stream', { sessionId: 'other', messages: [person('dsh-y', 'hi')], tools }, () => MODEL)).toBe(MODEL)
+  } finally {
+    if (previous === undefined) { delete globals[key] } else { globals[key] = previous }
+  }
+})
+
+// ★ 2026-11-09（真机）：主管台所有消息共用一个 desk Thread，工单订阅它 ⇒ 一条全新的请求
+//   也会被扇出给「待人回答」的旧工单，回执先说「已转给正在做的工单「打开 cartoon.hml 文件」」，
+//   worker 之后才 handback 退回。这条端到端钉住：新请求交给 Eval，不再误投旧工单。
+it('keeps a new desk request out of a ticket awaiting an answer, so its receipt does not claim it was forwarded', async () => {
+  listSuperagent()
+  const desk = (messageId: string, text: string) => deskTrigger({ session: h.runtime.deskId, messageId, text, at: new Date().toISOString() })
+  const { ticket, sessionId } = await h.acceptedTicket(desk('desk-cartoon', '打开 cartoon.hml 文件'))
+  // 主管问你：相关目录里没有 cartoon.hml…（= ticket.attention 的待回答形态）
+  await h.runTool(sessionId, 'orchestrator_report', { state: 'progress', summary: '未找到文件', human_action: '你是指 pomodoro-h5 里的 cartoon.html？' })
+  expect(h.runtime.store.tickets.get(ticket.id)!.attention).toBeDefined()
+  const before = h.candidates().length
+  const request = desk('desk-add-tester', '添加一个测试专家')
+  h.runtime.receive(request)
+  await h.runtime.idle()
+  // 不扇出给那张待人回答的工单 ⇒ 进 Eval 重新分诊
+  expect(h.runtime.store.triggers.disposition(request.id)!.fanout).toEqual([])
+  expect(h.candidates()).toContain(request.id)
+  expect(h.candidates().length).toBeGreaterThan(before)
+  expect(h.runtime.store.tickets.get(ticket.id)!.inputs.filter(input => input.kind === 'trigger')
+    .map(input => input.triggerId)).not.toContain(request.id)
+  // 回执不再说「已转给正在做的工单」
+  const titles = (h.runtime.store.triggers.disposition(request.id)!.fanout ?? [])
+    .map(id => h.runtime.store.tickets.get(id)?.title ?? '')
+  expect(submitText({ result: 'stored', tickets: titles })).toBe('已收到，正在按普通流程安排；有进展会在这里告诉你。')
+  // 真回答仍直投给那张工单
+  const answer = desk('desk-answer', '是 pomodoro-h5 里的 cartoon.html')
+  h.runtime.receive(answer)
+  await h.runtime.idle()
+  expect(h.runtime.store.triggers.disposition(answer.id)!.fanout).toEqual([ticket.id])
+})
+it('says where a handed-over desk message went', () => {
+  expect(submitText({ result: 'stored' })).toBe('已收到，正在按普通流程安排；有进展会在这里告诉你。')
+  expect(submitText({ result: 'duplicate', route: { roomName: '番茄钟', kind: 'created' } })).toBe('已建群「番茄钟」，群里的 Bots 接着做。')
+  expect(submitText({ result: 'stored', tickets: ['做番茄钟'] })).toBe('已转给正在做的工单「做番茄钟」。')
+  expect(submitText({ result: 'filtered' })).toMatch(/没交给主管/)
+  expect(submitText({ result: 'stored', filtered: true })).toMatch(/没交给主管/)
+  expect(submitText(undefined)).toMatch(/没能交给主管/)
+})
+
+// 2026-11-06: the agents plugin pairs "message + session reference" within 15s. A reference that arrives after the desk's
+// wait used to leave the message with the supervisor while the group took it too; now the desk settles it late as well.
+it('settles an @existing-group message whose session reference arrives after the wait, so it is not handled twice', async () => {
+  listSuperagent()
+  const key = Symbol.for('vssaros.team')
+  const globals = globalThis as unknown as Record<symbol, unknown>
+  const previous = globals[key]
+  const room = {
+    id: 'room-late', sessionId: 'room-late', name: '番茄钟 H5 开发团队',
+    members: [{ id: 'coder', name: 'Coder' }, { id: 'designer', name: 'Designer' }],
+    admin: 'coder', mode: 'admin', notice: '', pinned: false, hidden: false, createdBy: 'superagent',
+  }
+  globals[key] = { version: 1, available: () => true, listBots: async () => [], delegate: async () => ({}), get: async () => undefined,
+    cancel: async () => ({}), subscribe: () => () => undefined, createGroup: vi.fn(), listGroups: async () => [room] }
+  try {
+    const text = '@番茄钟 H5 开发团队 开始制作'
+    const trigger = deskTrigger({ session: h.runtime.deskId, messageId: 'dsh-late', text, at: new Date().toISOString() })
+    const emit = (h.ctx as unknown as { emit(name: string, ...args: unknown[]): void }).emit.bind(h.ctx)
+    emit('session/event', { id: h.runtime.deskId }, { type: 'user/message', data: { id: 'dsh-late', source: { kind: 'user' }, content: [{ type: 'text', text }] } })
+    await tick(GROUP_REFERENCE_WAIT_MS + 200)
+    await h.runtime.idle()
+    expect(h.runtime.groupRoutes.get(trigger.id)).toBeUndefined()
+    emit('session/event', { id: h.runtime.deskId }, { type: 'user/message', data: {
+      id: 'ref-dsh-late', role: 'user', source: { kind: 'session-reference', form: 'recall', version: 1,
+        references: [{ sessionId: 'room-late', label: '番茄钟 H5 开发团队' }] }, content: [{ type: 'text', text: '## Referenced sessions' }] } })
+    await tick()
+    await h.runtime.idle()
+    const decisions = h.runtime.store.db.prepare('SELECT value FROM decision WHERE value LIKE ?').all('%late reference%')
+    expect(decisions).toHaveLength(1)
+    expect(h.runtime.groupRoutes.get(trigger.id)).toMatchObject({ roomId: 'room-late', kind: 'routed', sourceMessageId: 'dsh-late' })
+    expect(flowOf(trigger.id).state).toBe('group')
+    expect((h.runtime.store.db.prepare('SELECT COUNT(*) AS n FROM ticket').get() as { n: number }).n).toBe(0)
+  } finally {
+    if (previous === undefined) { delete globals[key] } else { globals[key] = previous }
+  }
+})
+
+it('takes a desk message that cannot be a group command (no leading @) at once, without waiting for a reference', async () => {
+  listSuperagent()
+  const text = '首页新手引导要上线，帮我看看'
+  const trigger = deskTrigger({ session: h.runtime.deskId, messageId: 'dsh-now', text, at: new Date().toISOString() })
+  const emit = (h.ctx as unknown as { emit(name: string, ...args: unknown[]): void }).emit.bind(h.ctx)
+  emit('session/event', { id: h.runtime.deskId }, { type: 'user/message', data: { id: 'dsh-now', source: { kind: 'user' }, content: [{ type: 'text', text }] } })
+  await tick(5)
+  expect(h.runtime.store.triggers.get(trigger.id)).toBeDefined()
+})
