diff --git a/src/app/desk-chat.ts b/src/app/desk-chat.ts
new file mode 100644
index 00000000000..f1f85a51225
--- /dev/null
+++ b/src/app/desk-chat.ts
@@ -0,0 +1,164 @@
+/**
+ * VsSaros addition: the supervisor desk as the panel's Chat tab. The conversation is the desk's Thread
+ * (`superagent:desk:<deskId>`): a person's messages are its Triggers, whether typed in the panel or in the desk Session,
+ * and SuperAgent's replies are logged as they are delivered to the desk. A message sent from the panel is a desk Trigger
+ * like one the desk Session hands over, so it goes through the same gate, Eval and tickets, and can agree to a team.
+ */
+import { randomUUID } from 'node:crypto'
+import { mkdirSync, writeFileSync } from 'node:fs'
+import { basename, join } from 'node:path'
+import { threadKey, type OutboundMessage, type Reason, type ReceiveResult, type Trigger } from '../core/index.ts'
+import { deskTrigger, SUPERAGENT_SOURCE } from '../sources/superagent.ts'
+import type { Store } from './store.ts'
+
+export const DESK_MESSAGE_CHARS = 20_000
+/** One message of the desk conversation, oldest first. */
+export interface DeskMessage {
+  id: string; role: 'person' | 'superagent'; text: string; at: string
+  /** A person's message the gate did not admit, and why. */
+  filtered?: Reason
+  ticketId?: string; kind?: OutboundMessage['kind']
+  /** ★ 2026-11-10: read-only projection of an IM source message (Feishu) into the Chat bubbles.
+      It never lives in the desk Thread; `chatId` only labels where the message came from. */
+  source?: 'feishu'
+  chatId?: string
+}
+
+export interface DeskChatHost {
+  store: Pick<Store, 'db' | 'triggers'>
+  deskId: string
+  receive(trigger: Trigger): ReceiveResult | Promise<ReceiveResult>
+  /** Records a panel message in the desk Session too, without waking it; best effort. */
+  echo?(requestId: string, text: string): Promise<void>
+  /** Where attached files are kept, in the state directory. */
+  filesDir?: string
+  warn?(message: string): void
+}
+
+/** The desk conversation: its messages, a person's message sent from the panel, its attachments and scheduled messages. */
+export class DeskChat {
+  constructor(private readonly host: DeskChatHost) {
+    host.store.db.exec('CREATE TABLE IF NOT EXISTS desk_log (id TEXT PRIMARY KEY, at TEXT NOT NULL, value TEXT NOT NULL)')
+    host.store.db.exec('CREATE TABLE IF NOT EXISTS desk_schedule (id TEXT PRIMARY KEY, at TEXT NOT NULL, value TEXT NOT NULL)')
+  }
+  get thread(): string { return threadKey({ source: SUPERAGENT_SOURCE, id: `desk:${this.host.deskId}` }) }
+
+  /** Records a reply SuperAgent delivers to the desk; recording the same message again changes nothing. */
+  logReply(message: OutboundMessage, at = new Date().toISOString()): void {
+    const entry: DeskMessage = { id: message.id, role: 'superagent', text: message.text, at, kind: message.kind,
+      ...message.ticketId ? { ticketId: message.ticketId } : {} }
+    this.host.store.db.prepare('INSERT OR IGNORE INTO desk_log VALUES (?,?,?)').run(entry.id, entry.at, JSON.stringify(entry))
+  }
+  /** The last `limit` messages of the conversation, oldest first. */
+  messages(limit = 100): DeskMessage[] {
+    const { db } = this.host.store
+    const people = db.prepare(`SELECT t.value FROM trigger_thread tt JOIN trigger t ON t.id = tt.id WHERE tt.thread = ?
+      ORDER BY tt.at DESC LIMIT ?`).all(this.thread, limit).map(row => {
+      const trigger = JSON.parse(String(row.value)) as Trigger
+      const filtered = this.host.store.triggers.disposition(trigger.id)?.filtered
+      return { id: trigger.id, role: 'person' as const, text: trigger.text, at: trigger.at, ...filtered ? { filtered } : {} }
+    })
+    const replies = db.prepare('SELECT value FROM desk_log ORDER BY at DESC LIMIT ?').all(limit)
+      .map(row => JSON.parse(String(row.value)) as DeskMessage)
+    /* ★ 2026-11-10: show Feishu source text directly in the Chat bubbles (read-only projection).
+       Feishu Triggers live in `feishu:<chatId>:<rootId>` Threads; the Chat tab used to read only the desk Thread.
+       We map `source:'feishu'` Triggers to person messages at read time: no trigger_thread / desk_log writes,
+       no Intake, no Eval kick ⇒ the supervisor is NOT woken and no reply loop can form. Display-only
+       Triggers are stored by Intake's filtered branch (`intake.ts:58`), so the text stays visible;
+       the filtered reason is deliberately NOT projected — display-only is the product, not a rejection. */
+    const feishu = db.prepare(`SELECT value FROM trigger WHERE json_extract(value,'$.source') = 'feishu'
+      ORDER BY at DESC LIMIT ?`).all(limit).map(row => {
+      const trigger = JSON.parse(String(row.value)) as Trigger & { meta?: { chatId?: string } }
+      return { id: trigger.id, role: 'person' as const, text: trigger.text, at: trigger.at,
+        source: 'feishu' as const, ...(trigger.meta?.chatId ? { chatId: trigger.meta.chatId } : {}) }
+    })
+    const seen = new Set<string>()
+    return [...people, ...feishu, ...replies]
+      .filter(message => { if (seen.has(message.id)) return false; seen.add(message.id); return true })
+      .sort((a, b) => a.at.localeCompare(b.at) || (a.role === 'person' ? -1 : 1)).slice(-limit)
+  }
+  /** A person's message from the panel, as a desk Trigger. */
+  async send(text: string): Promise<{ id: string; result: ReceiveResult }> {
+    const body = text.trim()
+    if (!body) throw new Error('The message is empty')
+    if (body.length > DESK_MESSAGE_CHARS) throw new Error(`A message has at most ${DESK_MESSAGE_CHARS} characters`)
+    const messageId = `panel-${randomUUID()}`
+    const trigger = deskTrigger({ session: this.host.deskId, messageId, text: body, at: new Date().toISOString() })
+    const result = await this.host.receive(trigger)
+    await this.host.echo?.(`desk-panel:${messageId}`, `[本机用户 · 面板] ${body}`).catch(() => undefined)
+    return { id: trigger.id, result }
+  }
+
+  // Attachments: a file the person adds in the composer is kept in the state directory, and the message names its path.
+
+  /** Keeps a file the person attached; its path goes into the message, where the supervisor and the workers read it. */
+  attach(name: string, data: Buffer): DeskFile {
+    if (!this.host.filesDir) throw new Error('This desk keeps no files')
+    if (data.length > DESK_FILE_BYTES) throw new Error(`A file has at most ${DESK_FILE_BYTES / 1024 / 1024} MB`)
+    const safe = basename(name).replace(/[<>:"/\\|?*\x00-\x1f]/g, '_').replace(/^\.+/, '').slice(0, 120) || 'file'
+    const dir = join(this.host.filesDir, `${new Date().toISOString().slice(0, 10)}-${randomUUID().slice(0, 8)}`)
+    mkdirSync(dir, { recursive: true })
+    const path = join(dir, safe)
+    writeFileSync(path, data)
+    return { name: safe, path, size: data.length }
+  }
+
+  // Scheduled tasks: a message the person asks to send later, once or on every day or working day at that time.
+
+  /** The scheduled messages, soonest first. */
+  schedules(): DeskSchedule[] {
+    return this.host.store.db.prepare('SELECT value FROM desk_schedule ORDER BY at').all()
+      .map(row => JSON.parse(String(row.value)) as DeskSchedule)
+  }
+  /** Schedules a message. @throws Error when the text is empty or too long, or the time is not a time. */
+  schedule(input: { text: string; at: string; repeat: DeskSchedule['repeat'] }, now = new Date()): DeskSchedule {
+    const text = input.text.trim()
+    if (!text) throw new Error('The message is empty')
+    if (text.length > DESK_MESSAGE_CHARS) throw new Error(`A message has at most ${DESK_MESSAGE_CHARS} characters`)
+    const first = new Date(input.at)
+    if (Number.isNaN(first.getTime())) throw new Error('The time is not a time')
+    if (input.repeat === 'none' && first.getTime() < now.getTime() - 60_000) throw new Error('The time has passed')
+    const at = input.repeat === 'none' ? first : nextRun(first, input.repeat, now, true)
+    const entry: DeskSchedule = { id: `sched-${randomUUID().slice(0, 8)}`, text, at: at.toISOString(), repeat: input.repeat, createdAt: now.toISOString() }
+    this.saveSchedule(entry)
+    return entry
+  }
+  unschedule(id: string): void { this.host.store.db.prepare('DELETE FROM desk_schedule WHERE id=?').run(id) }
+  /** Sends every scheduled message that is due, and moves a repeating one to its next time. */
+  async runDue(now = new Date()): Promise<number> {
+    let sent = 0
+    for (const entry of this.schedules()) {
+      if (new Date(entry.at).getTime() > now.getTime()) break
+      // Moved (or removed) before it is sent, so a failure or a restart never sends it twice.
+      if (entry.repeat === 'none') this.unschedule(entry.id)
+      else this.saveSchedule({ ...entry, at: nextRun(new Date(entry.at), entry.repeat, now, false).toISOString() })
+      try { await this.send(`[定时任务] ${entry.text}`); sent += 1 } catch (failure) { this.host.warn?.(`scheduled message ${entry.id}: ${(failure as Error).message}`) }
+    }
+    return sent
+  }
+  /** Checks for due scheduled messages every half minute. */
+  install(): () => void {
+    const timer = setInterval(() => { void this.runDue() }, 30_000)
+    timer.unref?.()
+    return () => { clearInterval(timer) }
+  }
+  private saveSchedule(entry: DeskSchedule): void {
+    this.host.store.db.prepare('INSERT OR REPLACE INTO desk_schedule VALUES (?,?,?)').run(entry.id, entry.at, JSON.stringify(entry))
+  }
+}
+
+export const DESK_FILE_BYTES = 10 * 1024 * 1024
+/** A file the person attached to a message. */
+export interface DeskFile { name: string; path: string; size: number }
+/** A message the person scheduled. */
+export interface DeskSchedule { id: string; text: string; at: string; repeat: 'none' | 'daily' | 'weekdays'; createdAt: string }
+
+/** The next time a repeating message runs after `now`, at the same local time of day; `from` itself counts when `inclusive`. */
+export function nextRun(from: Date, repeat: 'daily' | 'weekdays', now: Date, inclusive: boolean): Date {
+  const next = new Date(from)
+  const fits = (date: Date) => repeat === 'daily' || (date.getDay() !== 0 && date.getDay() !== 6)
+  const ahead = (date: Date) => inclusive ? date.getTime() >= now.getTime() - 60_000 : date.getTime() > now.getTime()
+  if (!inclusive) next.setDate(next.getDate() + 1)
+  for (let guard = 0; guard < 4000 && !(ahead(next) && fits(next)); guard += 1) next.setDate(next.getDate() + 1)
+  return next
+}
diff --git a/src/app/desk-flow.ts b/src/app/desk-flow.ts
new file mode 100644
index 00000000000..7eff3e35f2b
--- /dev/null
+++ b/src/app/desk-flow.ts
@@ -0,0 +1,83 @@
+/**
+ * VsSaros addition (plan C): where one message to the supervisor desk stands, for the card that shows it in the desk's own
+ * (DSH) conversation: received, evaluated, declined or taken as a ticket; the ticket's team proposal while it waits for the
+ * person; its team at work, with the requests that wait for the person; and how it ended. A message that reached a ticket
+ * another message started says only which ticket it went to: the card of the message that started it holds the rest.
+ */
+import { latestAssignment, ticketStage, type Reason, type TicketStage } from '../core/index.ts'
+import type { GroupRoute, GroupRouteKind } from './group-routes.ts'
+import type { StaffingProposal } from './staffing.ts'
+import type { StepApprovalView } from './step-approvals.ts'
+import type { StepsView } from './steps.ts'
+import type { Store } from './store.ts'
+
+/** The group chat a desk message went to (VsSaros addition, 2026-11-06); the card follows the group's live run with it. */
+export interface DeskFlowGroup { roomId: string; roomName: string; kind: GroupRouteKind; sourceMessageId?: string }
+
+export interface DeskFlow {
+  trigger: { id: string; text: string; at: string } | undefined
+  /**
+   * `unknown`: not received (yet); `filtered`: the desk Source is off; `declined`: Eval decided not to take it;
+   * `group`: a group chat took it (made for it, or an `@group` command) — the supervisor stays out of it on purpose.
+   */
+  state: 'unknown' | 'filtered' | 'evaluating' | 'declined' | 'ticket' | 'group'
+  /** Set with `group`, and on a ticket card when the same message also went to a group. */
+  group?: DeskFlowGroup
+  reasons?: Reason[]
+  /** The decision was `unavailable`: Eval could not decide, and tries again. */
+  unavailable?: true
+  /** It reached a ticket another message started. */
+  followup?: true
+  ticket?: {
+    id: string; title: string; stage: TicketStage
+    ended?: { outcome: string; reason?: string | undefined }
+    report?: { state: string; summary: string }
+  }
+  proposal?: Pick<StaffingProposal, 'version' | 'state' | 'roles' | 'steps' | 'budget' | 'risk' | 'at'>
+  team?: StepsView
+  approvals: StepApprovalView[]
+}
+
+export interface DeskFlowHost {
+  store: Pick<Store, 'triggers' | 'tickets' | 'decisions'>
+  proposal(ticketId: string): StaffingProposal | undefined
+  team(ticketId: string): StepsView | undefined
+  approvals(): StepApprovalView[]
+  /** Which group chat the message went to, if any. */
+  route?(triggerId: string): GroupRoute | undefined
+}
+
+/** Where the message `triggerId` stands now. */
+export function deskFlow(host: DeskFlowHost, triggerId: string): DeskFlow {
+  const { store } = host
+  const trigger = store.triggers.get(triggerId)
+  const disposition = store.triggers.disposition(triggerId)
+  const base = { trigger: trigger && { id: trigger.id, text: trigger.text.slice(0, 400), at: trigger.at }, approvals: [] as StepApprovalView[] }
+  const route = host.route?.(triggerId)
+  const group: DeskFlowGroup | undefined = route && { roomId: route.roomId, roomName: route.roomName, kind: route.kind,
+    ...route.sourceMessageId ? { sourceMessageId: route.sourceMessageId } : {} }
+  const decision = disposition?.decisionId ? store.decisions.get(disposition.decisionId) : undefined
+  const ticketId = disposition ? decision?.ticketId ?? disposition.fanout[0] : undefined
+  const ticket = ticketId ? store.tickets.get(ticketId) : undefined
+  // A group took it and no ticket did: show the group, not a refusal (the ignore decision is deliberate).
+  if (group && !ticket) return { ...base, state: 'group', group }
+  if (!disposition) return { ...base, state: 'unknown' }
+  if (disposition.filtered) return { ...base, state: 'filtered', reasons: [disposition.filtered] }
+  if (!ticket) {
+    if (!decision) return { ...base, state: 'evaluating' }
+    return { ...base, state: decision.kind === 'unavailable' ? 'evaluating' : 'declined', reasons: decision.reason,
+      ...decision.kind === 'unavailable' ? { unavailable: true as const } : {} }
+  }
+  const report = latestAssignment(ticket)?.report
+  const summary = { id: ticket.id, title: ticket.title, stage: ticketStage(ticket),
+    ...ticket.ended ? { ended: { outcome: ticket.ended.outcome, reason: ticket.ended.reason } } : {},
+    ...report ? { report: { state: report.state, summary: report.summary.slice(0, 600) } } : {} }
+  if (ticket.origin.triggerId !== triggerId) return { ...base, state: 'ticket', followup: true, ticket: summary, ...group ? { group } : {} }
+  const proposal = host.proposal(ticket.id)
+  const team = host.team(ticket.id)
+  return { ...base, state: 'ticket', ticket: summary, ...group ? { group } : {},
+    ...proposal ? { proposal: { version: proposal.version, state: proposal.state, roles: proposal.roles, steps: proposal.steps,
+      budget: proposal.budget, risk: proposal.risk, at: proposal.at } } : {},
+    ...team ? { team } : {},
+    approvals: host.approvals().filter(item => item.ticketId === ticket.id) }
+}
diff --git a/src/app/desk-outbox.ts b/src/app/desk-outbox.ts
new file mode 100644
index 00000000000..9a7fa931322
--- /dev/null
+++ b/src/app/desk-outbox.ts
@@ -0,0 +1,148 @@
+/**
+ * VsSaros addition (2026-11-05): the supervisor's messages to the desk, written down before they are delivered and counted
+ * delivered only once the desk Session's conversation has them.
+ *
+ * Delivering queues a message into the desk Session (`followup`), which DSH keeps in the Session's inbox until a turn takes
+ * it; a Session that closes first (a Host restart, a reload) drops its inbox. So the outbox keeps each message `pending`
+ * until the desk's `user/message` event with its id says the conversation has it, and delivers what is pending again: on
+ * every start, when the desk Session closes, and before each new message, oldest first. Delivery is once per id, so a
+ * message still in the inbox, or already in the conversation, is not delivered twice (as DeepSeek-Bot's resend of its
+ * queued deliveries does, host/resume.js).
+ *
+ * Only a message that needs the person's answer wakes the desk, whose model then tells the person: a team proposal, a step's
+ * request, the supervisor's question, an answer or a ticket's result. The rest, such as acknowledgements and progress
+ * notices, are only logged for the panel's own drawing, the Workbench and the side panel, which spends no model turn.
+ */
+import type { Context } from '@deepseek-ai/cordis'
+import type { OutboundMessage } from '../core/index.ts'
+import type { Store } from './store.ts'
+
+/**
+ * Notices that ask the person for something, or answer what they asked (other notices tell of progress). VsSaros addition
+ * (2026-11-06): a desk ticket's end (`ticket-ended:`), which the desk shows as a card without its model (desk.ts).
+ */
+const ASKING_NOTICES = /^(team-proposal|step-approval|step-approval-which|group-created|group-updated|ticket-ended):/
+/**
+ * Whether a message to the desk needs the person's answer, and so wakes the desk: every `reply` (an answer, a result, the
+ * supervisor's question for the person), a team proposal, a step's request or the question which request a reply meant,
+ * and (2026-11-05) the group chat the person asked for.
+ */
+export function wakesDesk(message: Pick<OutboundMessage, 'id' | 'kind'>): boolean {
+  return message.kind === 'reply' || (message.kind === 'notice' && ASKING_NOTICES.test(message.id))
+}
+
+/** One message in the desk outbox. */
+export interface DeskOutboxEntry {
+  id: string; at: string; state: 'pending' | 'recorded'
+  /** Delivery attempts that failed, and the last failure. */
+  tries: number; error?: string
+}
+
+export interface DeskOutboxHost {
+  store: Pick<Store, 'db'>
+  context: Pick<Context, 'on'>
+  deskId: string
+  /** Queues the message into the desk Session, once per message; `'gone'` when there is no desk Session. */
+  deliver(message: OutboundMessage): Promise<'sent' | 'gone'>
+  /** The id of the DSH message delivery writes, which the desk's `user/message` event carries. */
+  messageIdOf(message: OutboundMessage): string
+  /** Whether the desk Session's conversation has the message (not merely its inbox). */
+  recorded(message: OutboundMessage): Promise<boolean>
+  closing(): boolean
+  warn(message: string): void
+}
+
+/** How long after the desk Session closed its messages are delivered again, so a Session being replaced is not raced. */
+const AFTER_CLOSE_MS = 1000
+
+/** The supervisor's messages that wake the desk: written down, delivered in order, and kept until the desk has them. */
+export class DeskOutbox {
+  private running: Promise<void> | undefined
+  private again = false
+  private timer: ReturnType<typeof setTimeout> | undefined
+  constructor(private readonly host: DeskOutboxHost) {
+    host.store.db.exec(`CREATE TABLE IF NOT EXISTS desk_outbox (id TEXT PRIMARY KEY, message_id TEXT NOT NULL, state TEXT NOT NULL,
+      at TEXT NOT NULL, tries INTEGER NOT NULL DEFAULT 0, error TEXT, value TEXT NOT NULL)`)
+  }
+
+  /** Writes a message down as pending, then delivers what is pending; writing the same message again changes nothing. */
+  post(message: OutboundMessage, at = new Date().toISOString()): void {
+    this.host.store.db.prepare('INSERT OR IGNORE INTO desk_outbox (id, message_id, state, at, value) VALUES (?,?,?,?,?)')
+      .run(message.id, this.host.messageIdOf(message), 'pending', at, JSON.stringify(message))
+    void this.flush()
+  }
+  /** One message's entry, if it was posted. */
+  entry(id: string): DeskOutboxEntry | undefined {
+    const row = this.host.store.db.prepare('SELECT id, state, at, tries, error FROM desk_outbox WHERE id=?').get(id)
+    return row ? toEntry(row) : undefined
+  }
+  /** The messages the desk does not have yet, oldest first. */
+  pending(): DeskOutboxEntry[] {
+    return this.host.store.db.prepare("SELECT id, state, at, tries, error FROM desk_outbox WHERE state='pending' ORDER BY at, rowid").all().map(toEntry)
+  }
+  /** The message posted under DSH message id `messageId` (what the desk's conversation names it by), if any. */
+  messageOf(messageId: string): OutboundMessage | undefined {
+    const row = this.host.store.db.prepare('SELECT value FROM desk_outbox WHERE message_id=?').get(messageId)
+    try { return row ? JSON.parse(String(row.value)) as OutboundMessage : undefined } catch { return undefined }
+  }
+  /** Delivers what is pending, oldest first, one run at a time; a run asked for during one follows it. Never throws. */
+  flush(): Promise<void> {
+    if (this.running) { this.again = true; return this.running }
+    const run = (async () => {
+      do {
+        this.again = false
+        await this.deliverPending()
+      } while (this.again && !this.host.closing())
+    })()
+    this.running = run.finally(() => { this.running = undefined })
+    return this.running
+  }
+  /** Marks messages delivered as the desk's conversation records them, and delivers what is pending now and after the desk closes. */
+  install(): () => void {
+    const { context, deskId } = this.host
+    const offEvent = context.on('session/event', (session, event) => {
+      if (session.id !== deskId || event.type !== 'user/message') return
+      const id = (event.data as { id?: unknown } | undefined)?.id
+      if (typeof id === 'string') this.host.store.db.prepare("UPDATE desk_outbox SET state='recorded', error=NULL WHERE message_id=? AND state='pending'").run(id)
+    })
+    const offDisposed = context.on('agent/disposed', ({ agent }) => {
+      if (agent.id !== deskId || this.host.closing() || !this.pending().length) return
+      clearTimeout(this.timer)
+      this.timer = setTimeout(() => { if (!this.host.closing()) void this.flush() }, AFTER_CLOSE_MS)
+      this.timer.unref?.()
+    })
+    void this.flush()
+    return () => { offEvent(); offDisposed(); clearTimeout(this.timer) }
+  }
+
+  private async deliverPending(): Promise<void> {
+    const { db } = this.host.store
+    const rows = db.prepare("SELECT id, value FROM desk_outbox WHERE state='pending' ORDER BY at, rowid").all()
+    for (const row of rows) {
+      if (this.host.closing()) return
+      const id = String(row.id), message = JSON.parse(String(row.value)) as OutboundMessage
+      try {
+        // Delivered before a restart and taken into a turn since: the conversation has it.
+        if (await this.host.recorded(message)) { this.mark(id); continue }
+        if (await this.host.deliver(message) === 'gone') { this.failed(id, 'the desk Session does not exist'); return }
+        if (await this.host.recorded(message)) this.mark(id)
+      } catch (error) {
+        this.failed(id, String(error))
+        // A later message would overtake this one; the next flush tries from here again.
+        return
+      }
+    }
+  }
+  private mark(id: string): void {
+    this.host.store.db.prepare("UPDATE desk_outbox SET state='recorded', error=NULL WHERE id=?").run(id)
+  }
+  private failed(id: string, error: string): void {
+    this.host.store.db.prepare('UPDATE desk_outbox SET tries=tries+1, error=? WHERE id=?').run(error.slice(0, 500), id)
+    this.host.warn(`a supervisor message to the desk is not delivered yet (${id}): ${error}`)
+  }
+}
+
+function toEntry(row: Record<string, unknown>): DeskOutboxEntry {
+  return { id: String(row.id), at: String(row.at), state: row.state === 'recorded' ? 'recorded' : 'pending', tries: Number(row.tries),
+    ...row.error ? { error: String(row.error) } : {} }
+}
