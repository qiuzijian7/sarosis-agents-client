+      }
+      failures = 0
+    } catch (error) {
+      failures += 1
+      const failed = pollFailure(failures, config?.failuresBeforeError ?? 1, error)
+      if (!signal.aborted && failed) ctx.report(TAPD_SOURCE, failed)
+    }
+    await pause((ctx.config<TapdConfig>(TAPD_SOURCE)?.pollSeconds ?? 120) * 1000, signal)
+  }
+}
