+  team: Pick<Team, 'available' | 'bots' | 'createAgreed'>
+  outbox: { send(message: OutboundMessage): void }
+  /** P3: the team's steps, written in the transaction that agrees to it. */
+  steps?: { plan(proposal: StaffingProposal): void }
