diff --git a/src/app/tools/team.ts b/src/app/tools/team.ts
new file mode 100644
index 00000000000..cb97f827498
--- /dev/null
+++ b/src/app/tools/team.ts
@@ -0,0 +1,150 @@
+/** VsSaros addition: main Session tools for VsSaros Bots — the roster, group chats, and a ticket's team (see `../staffing.ts`). */
+import { z } from 'zod'
+import { UserError } from '../../core/index.ts'
+import { TEAM_STEPS_MAX, TeamError, type Team } from '../team.ts'
+import type { Retrospective } from '../retrospective.ts'
+import type { Staffing, StaffingProposal } from '../staffing.ts'
+import type { Store } from '../store.ts'
+import { TEAMFLOW_PHASES } from '../teamflow.ts'
+import { groupMadeNotice } from '../groupFastPath.ts'
+import { tool, type Tool } from './tool.ts'
+
+export interface TeamToolsHost {
+  readonly team: Pick<Team, 'bots' | 'createBot' | 'createGroup'>
+  readonly retro: Pick<Retrospective, 'match'>
+  /** VsSaros addition (superagent v2, P5): the ticket whose request saved workflows are matched against. */
+  readonly store?: Pick<Store, 'tickets' | 'triggers'>
+  /** VsSaros addition (2026-11-05): tells the conversation a trigger came from, once per `id` (a notice through the Outbox). */
+  tellTrigger?(triggerId: string, id: string, text: string): boolean
+}
+
+const KEY = z.string().trim().regex(/^[A-Za-z0-9_-]{1,24}$/, 'letters, digits, _ or -, at most 24')
+/** Answers a refused request to the model instead of failing the call. */
+async function refusing<T>(run: () => Promise<T>): Promise<T | { refused: string }> {
+  try { return await run() }
+  catch (error) { if (error instanceof TeamError || error instanceof UserError) return { refused: error.message }; throw error }
+}
+
+/** The team tools of the main Session. */
+export function teamTools(host: TeamToolsHost): Tool[] {
+  return [
+    tool({
+      name: 'orchestrator_team_bots',
+      description: 'List the VsSaros Bots that can take a step, matching need first; with ticket_id, also saved workflows fitting it.',
+      schema: z.object({ need: z.string().trim().max(200).optional(), ticket_id: z.string().trim().optional() }).strict(),
+      execute: async ({ need, ticket_id }) => {
+        // VsSaros addition (superagent v2, P5): saved workflows whose steps fit the ticket's request (≥70%), also when the
+        // roster cannot be read.
+        const ticket = ticket_id ? host.store?.tickets.get(ticket_id) : undefined
+        const request = ticket ? `${ticket.title} ${host.store?.triggers.get(ticket.origin.triggerId)?.text ?? ''}` : ''
+        const workflows = request ? host.retro.match(request).slice(0, 3) : []
+        const matched = workflows.length ? { workflows, note: 'Pass workflow_id to orchestrator_team_propose to prefill its team.' } : {}
+        const roster = await refusing(async () => (await host.team.bots(need ?? '')).slice(0, 15)
+          .map(bot => ({ id: bot.id, name: bot.name, ...bot.role ? { role: bot.role } : {}, description: bot.description.slice(0, 160), skills: bot.skills })))
+        return 'refused' in roster ? { ...roster, ...matched } : { bots: roster, ...matched }
+      },
+    }),
+    // VsSaros addition (2026-11-05): a group chat of Bots, which a person asked for; it appears in the Bots tab of the sidebar.
+    // The Bots plugin checks names, counts and lengths; its first Bot is the admin.
+    tool({
+      name: 'orchestrator_team_create_group',
+      description: 'Make the group chat of Bots a person asked for (建群). bots: 2+ names from orchestrator_team_bots, the first is admin. mode admin: the admin answers and @-calls others; everyone: all answer in turn. An existing group of that name is edited instead: bots become its list (reused, added, removed).',
+      schema: z.object({ bots: z.array(z.string()).min(2), name: z.string().optional(), notice: z.string().optional(),
+        mode: z.enum(['admin', 'everyone']).optional(), trigger_id: z.string().optional() }).strict(),
+      execute: async ({ trigger_id, bots, ...input }) => refusing(async () => {
+        const group = await host.team.createGroup({ members: bots, ...input, ...(trigger_id ? { originTriggerId: trigger_id } : {}) })
+        const names = group.members.map(bot => bot.name)
+        const admin = group.members.find(bot => bot.id === group.admin)?.name
+        const notice = trigger_id ? groupMadeNotice(group, trigger_id) : undefined
+        const told = trigger_id && notice ? host.tellTrigger?.(trigger_id, notice.id, notice.text) ?? false : false
+        return { group: { id: group.id, name: group.name, bots: names, admin: admin ?? null, mode: group.mode,
+          ...group.reused ? { reused: true, added: group.added ?? [], removed: group.removed ?? [] } : {} }, told }
+      }),
+    }),
+    tool({
+      name: 'orchestrator_team_create_bot',
+      description: 'Create a Bot when none fits. Low-risk tools are created at once; high-risk ones wait for a person. Returns existing, pending, or bot.',
+      schema: z.object({
+        id: z.string().trim().min(1).max(64), name: z.string().trim().min(1).max(80),
+        description: z.string().trim().max(200).optional(), role: z.string().trim().max(40).optional(),
+        skills: z.array(z.string().max(80)).max(20).optional(), tools: z.array(z.string().max(80)).max(20).optional(),
+        persona: z.string().trim().min(1).max(4000), plan_id: z.string().trim().optional(),
+      }).strict(),
+      execute: async ({ plan_id, ...draft }) => refusing(async () => {
+        const result = await host.team.createBot({ draft, ...plan_id ? { planId: plan_id } : {} })
+        return { ...result, ...result.pending ? { note: 'A person must approve this draft in the panel before the Bot can take steps' } : {} }
+      }),
+    }),
+  ]
+}
+
+/**
+ * VsSaros addition (superagent v2): a tool the main Session does not get: a Bot is created only as part of a ticket's team
+ * a person agreed to (`orchestrator_team_propose`). VsSaros change (2026-11-06): the team plan tools (`orchestrator_team_plan`,
+ * `_status`, `_stop`) are removed with the plans themselves (`team-archive.ts`).
+ */
+export const CONSENTLESS_TOOLS = new Set(['orchestrator_team_create_bot'])
+
+export interface StaffingToolsHost {
+  readonly staffing: Pick<Staffing, 'propose' | 'confirm' | 'refuse'>
+  /** P5: saved workflows that prefill a proposal. */
+  readonly workflows?: Pick<Retrospective, 'prefill'>
+}
+const DraftSchema = z.object({
+  id: z.string().trim().min(1).max(64), name: z.string().trim().min(1).max(80), description: z.string().trim().max(200).optional(),
+  skills: z.array(z.string().max(80)).max(20).optional(), tools: z.array(z.string().max(80)).max(20).optional(),
+  persona: z.string().trim().min(1).max(4000),
+}).strict()
+const proposalBrief = (proposal: StaffingProposal) => ({ ticket_id: proposal.ticketId, version: proposal.version, state: proposal.state,
+  risk: proposal.risk, roles: proposal.roles.map(role => ({ role: role.key, bot: role.bot?.name ?? role.draft?.name, new: !!role.draft })),
+  ...proposal.workflow ? { workflow: proposal.workflow.id } : {} })
+
+/**
+ * The main Session's tools for a ticket's team: propose a version, and record a person's agreement or refusal. A proposal
+ * runs on the default budget (`DEFAULT_BUDGET`); the multi-Bot executor (P3) is where a budget becomes adjustable.
+ * VsSaros addition (P5): `workflow_id` prefills the roles and steps a proposal leaves out from a saved workflow.
+ */
+export function staffingTools(host: StaffingToolsHost): Tool[] {
+  return [
+    tool({
+      name: 'orchestrator_team_propose',
+      description: 'Propose, or revise, the team of a ticket in person/staffing: each role is an existing bot or a new bot draft; workflow_id prefills what you omit. The person must agree.',
+      schema: z.object({
+        ticket_id: z.string().trim().min(1),
+        workflow_id: z.string().trim().optional(),
+        roles: z.array(z.object({ key: KEY, need: z.string().trim().min(1).max(200), bot: z.string().trim().min(1).max(120).optional(),
+          draft: DraftSchema.optional() }).strict()).min(1).max(TEAM_STEPS_MAX).optional(),
+        steps: z.array(z.object({ key: KEY, role: KEY, title: z.string().trim().min(1).max(120), spec: z.string().trim().min(1).max(4000),
+          after: z.array(KEY).max(TEAM_STEPS_MAX).optional(), access: z.enum(['read', 'write']).optional(),
+          phase: z.enum(TEAMFLOW_PHASES).optional() }).strict()).min(1).max(TEAM_STEPS_MAX).optional(),
+      }).strict(),
+      execute: async ({ ticket_id, workflow_id, roles, steps }) => refusing(async () => {
+        const prefilled = workflow_id ? host.workflows?.prefill(workflow_id) : undefined
+        if (workflow_id && !prefilled) throw new TeamError('Saved workflows are not available here')
+        const chosen = { roles: roles ?? prefilled?.roles, steps: steps ?? prefilled?.steps }
+        if (!chosen.roles || !chosen.steps) throw new TeamError('Give roles and steps, or a workflow_id that prefills them')
+        const unstaffed = chosen.roles.filter(role => !role.bot && !('draft' in role && role.draft)).map(role => role.key)
+        if (unstaffed.length) throw new TeamError(`Roles ${unstaffed.join(', ')} have no Bot yet; pass roles with a bot or draft for each`)
+        const proposal = await host.staffing.propose({ ticketId: ticket_id, roles: chosen.roles, steps: chosen.steps,
+          ...prefilled ? { workflow: prefilled.workflow } : {} })
+        return { ...proposalBrief(proposal), note: proposal.state === 'approved' ? 'Agreed automatically under the low-risk setting; the worker starts.'
+          : 'Sent to the person. Their reply comes to you as a follow_up: agree with orchestrator_team_confirm, refuse with orchestrator_team_refuse, or propose again.' }
+      }),
+    }),
+    tool({
+      name: 'orchestrator_team_confirm',
+      description: 'Record a listed person\'s agreement in trigger_id to this version of a ticket\'s team; drafted Bots are created and the worker starts.',
+      schema: z.object({ ticket_id: z.string().trim().min(1), trigger_id: z.string().trim().min(1), version: z.number().int().min(1) }).strict(),
+      execute: async ({ ticket_id, trigger_id, version }) => refusing(async () => proposalBrief(await host.staffing.confirm(ticket_id, trigger_id, version))),
+    }),
+    tool({
+      name: 'orchestrator_team_refuse',
+      description: 'Record a listed person\'s refusal in trigger_id of a ticket\'s team; the ticket ends as dropped.',
+      schema: z.object({ ticket_id: z.string().trim().min(1), trigger_id: z.string().trim().min(1), reason: z.string().trim().max(200).optional() }).strict(),
+      execute: async ({ ticket_id, trigger_id, reason }) => refusing(async () => {
+        const proposal = host.staffing.refuse(ticket_id, { triggerId: trigger_id }, reason)
+        return { ticket_id, state: 'dropped', ...proposal ? { version: proposal.version } : {} }
+      }),
+    }),
+  ]
+}
diff --git a/src/app/usage.ts b/src/app/usage.ts
new file mode 100644
index 00000000000..c7fa3e139f0
--- /dev/null
+++ b/src/app/usage.ts
@@ -0,0 +1,210 @@
+/**
+ * VsSaros addition (2026-11-06, P2 · usage ledger, after DS Bot's `usage.js`): every model call of SuperAgent's own Sessions —
+ * the main Session, the supervisor desk, each ticket's worker (or coordinator) and each team step — with its tokens, kept in
+ * `usage_call` for `USAGE_KEEP_DAYS` days. One `llm/stream` listener feeds it and the team's token budget (`TeamSteps.meter`),
+ * so a call is counted once in both. A call another listener sends again as a new call (DS Bot does) is counted once too.
+ *
+ * Billable input is input + cache reads + cache writes (DSH's `TokenUsage` counts them apart).
+ */
+import type { DatabaseSync } from 'node:sqlite'
+
+export const USAGE_KEEP_DAYS = 30
+/** 决策 15：群执行结算也记一行；`group` 不是一次 LLM 调用，token 恒为 0，只作事件行。 */
+export type UsageRole = 'master' | 'desk' | 'worker' | 'step' | 'group'
+/** Whose a Session is: its role, and its ticket, step and Bot when it has them. */
+export interface UsageOwner { role: UsageRole; ticketId?: string; step?: string; bot?: string; roomId?: string }
+export interface UsageTokens { input: number; cacheRead: number; cacheWrite: number; output: number }
+/**
+ * VsSaros addition (2026-11-07, P0 · co-install observability): how another plugin's listener made a call while one of this
+ * Session's calls was under way. DS Bot does both on every Session (`coexist.ts`):
+ * - `resent`: the same model, the request sent again as a new call (its `secrets` rewrite, its `images` text instead of images);
+ * - `side`: another model, called on the side (its OCR reading the request's images).
+ */
+export type UsageRelay = 'resent' | 'side'
+export interface UsageCall extends UsageOwner, UsageTokens {
+  at: string; session: string; provider: string; model: string
+  /** DSH's purpose of an auxiliary call (`compaction`, `title`, …); unset for a conversation turn. */
+  purpose?: string
+  /** Set on a call another listener made inside one of this Session's calls. */
+  relay?: UsageRelay
+}
+export interface UsageTotals extends UsageTokens { calls: number; total: number }
+/** Calls another listener made inside a Session's calls: `resent` and `side` counts, by Session. */
+export interface UsageRelays {
+  resent: number; side: number
+  sessions: ({ session: string; role: UsageRole; ticketId?: string; step?: string; resent: number; side: number })[]
+}
+export interface UsageSummary {
+  since: string
+  total: UsageTotals
+  byRole: Record<UsageRole, UsageTotals>
+  byModel: ({ provider: string; model: string } & UsageTotals)[]
+  byBot: ({ bot: string } & UsageTotals)[]
+  byTicket: ({ ticketId: string } & UsageTotals)[]
+  relays: UsageRelays
+}
+/** What the ledger reads of DSH's stream options. */
+export interface StreamOptions { sessionId?: string; provider?: string; model?: string; purpose?: string }
+type UsageChunk = { type?: string; usage?: Record<string, number | undefined> }
+
+const count = (value: unknown) => typeof value === 'number' && Number.isFinite(value) && value > 0 ? Math.round(value) : 0
+/** DSH's usage chunk as this ledger's tokens. */
+export function tokensOf(usage: Record<string, number | undefined>): UsageTokens {
+  return { input: count(usage.inputTokens), cacheRead: count(usage.cacheReadTokens), cacheWrite: count(usage.cacheWriteTokens), output: count(usage.outputTokens) }
+}
+const totalOf = (tokens: UsageTokens) => tokens.input + tokens.cacheRead + tokens.cacheWrite + tokens.output
+
+/**
+ * DSH's `llm/stream` waterfall listener that hands each usage chunk of the Sessions `own` accepts to `onUsage`, once, and
+ * passes every chunk on unchanged. Every other call passes through untouched.
+ *
+ * VsSaros addition (2026-11-07): it tells a call another listener made inside one of the Session's calls (`UsageRelay`): one
+ * that starts while a call of the same Session and purpose runs. Registered first (`prepend`), it is the outermost listener,
+ * so a listener that sends a request again through the whole waterfall, as DS Bot's do, passes through it again. A `side`
+ * call `refuse` names a reason for is refused (its stream throws); DS Bot then tells the model the image could not be read.
+ */
+export function meteredStream(own: (sessionId: string) => boolean,
+  onUsage: (options: StreamOptions & { sessionId: string; relay?: UsageRelay }, usage: Record<string, number | undefined>) => void,
+  hooks: { refuse?(options: StreamOptions & { sessionId: string }): string | undefined } = {}) {
+  const counted = new WeakSet<object>()
+  /** The calls under way, by Session and purpose, outermost first. */
+  const active = new Map<string, StreamOptions[]>()
+  const keyOf = (options: StreamOptions) => `${options.sessionId}\u0000${options.purpose ?? ''}`
+  const relayOf = (options: StreamOptions): UsageRelay | undefined => {
+    const outer = active.get(keyOf(options))?.[0]
+    if (!outer) return undefined
+    return (outer.provider ?? '') === (options.provider ?? '') && (outer.model ?? '') === (options.model ?? '') ? 'resent' : 'side'
+  }
+  const refusal = (options: StreamOptions & { sessionId: string }) => relayOf(options) === 'side' ? hooks.refuse?.(options) : undefined
+  const refused = (reason: string) => (async function* (): AsyncGenerator<never> { throw new Error(reason) })()
+  return (options: StreamOptions | undefined, next: () => unknown): unknown => {
+    const sessionId = options?.sessionId
+    if (!sessionId || !own(sessionId)) return next()
+    // A side call that starts while the Session's call streams (DS Bot's OCR) is known here, before the model is asked.
+    const early = refusal({ ...options, sessionId })
+    if (early) return refused(early)
+    const result = next()
+    const iterate = async function* (stream: AsyncIterable<UsageChunk>) {
+      // A request sent again at once (DS Bot's secrets) is known only once its stream is read, inside the outer one.
+      const relay = relayOf(options)
+      const late = refusal({ ...options, sessionId })
+      if (late) throw new Error(late)
+      const key = keyOf(options), stack = active.get(key) ?? []
+      stack.push(options)
+      active.set(key, stack)
+      try {
+        for await (const chunk of stream) {
+          if (chunk?.type === 'usage' && chunk.usage && !counted.has(chunk)) {
+            counted.add(chunk)
+            try { onUsage({ ...options, sessionId, ...relay ? { relay } : {} }, chunk.usage) } catch { /* metering never breaks a turn */ }
+          }
+          yield chunk
+        }
+      } finally {
+        stack.splice(stack.lastIndexOf(options), 1)
+        if (!stack.length) active.delete(key)
+      }
+    }
+    if (result && typeof (result as AsyncIterable<unknown>)[Symbol.asyncIterator] === 'function') return iterate(result as AsyncIterable<never>)
+    if (result && typeof (result as Promise<unknown>).then === 'function') {
+      return (async function* () { yield* iterate(await (result as Promise<AsyncIterable<never>>)) })()
+    }
+    return result
+  }
+}
+
+const empty = (): UsageTotals => ({ calls: 0, input: 0, cacheRead: 0, cacheWrite: 0, output: 0, total: 0 })
+/** The relayed calls among `calls`, counted by Session (the 20 with the most). */
+export function relaysOf(calls: readonly UsageCall[]): UsageRelays {
+  const sessions = new Map<string, UsageRelays['sessions'][number]>()
+  let resent = 0, side = 0
+  for (const call of calls) {
+    if (!call.relay) continue
+    if (call.relay === 'resent') resent += 1; else side += 1
+    const item = sessions.get(call.session) ?? sessions.set(call.session, { session: call.session, role: call.role,
+      ...call.ticketId ? { ticketId: call.ticketId } : {}, ...call.step ? { step: call.step } : {}, resent: 0, side: 0 }).get(call.session)!
+    item[call.relay] += 1
+  }
+  return { resent, side, sessions: [...sessions.values()].sort((a, b) => b.resent + b.side - a.resent - a.side).slice(0, 20) }
+}
+const add = (into: UsageTotals, call: UsageTokens) => {
+  into.calls += 1; into.input += call.input; into.cacheRead += call.cacheRead; into.cacheWrite += call.cacheWrite; into.output += call.output
+  into.total += totalOf(call)
+}
+
+/** The ledger. `owner` says whose a Session is, or undefined for one that is not SuperAgent's. */
+export class UsageLedger {
+  constructor(private readonly db: DatabaseSync, readonly owner: (sessionId: string) => UsageOwner | undefined, private readonly now: () => number = Date.now) {
+    db.exec('CREATE TABLE IF NOT EXISTS usage_call (id INTEGER PRIMARY KEY AUTOINCREMENT, at TEXT NOT NULL, session TEXT NOT NULL, value TEXT NOT NULL)')
+    db.exec('CREATE INDEX IF NOT EXISTS usage_call_at ON usage_call (at)')
+    db.exec('CREATE INDEX IF NOT EXISTS usage_call_session ON usage_call (session, id)')
+    this.prune()
+  }
+  /**
+   * The `llm/stream` listener; `also` hears each counted call too (the team's token budget). `refuse` names why a `side`
+   * call of a Session is refused (`executor.sideCalls` off), or undefined to let it run.
+   */
+  listener(also?: (call: UsageCall) => void, refuse?: (sessionId: string) => string | undefined) {
+    return meteredStream(id => this.owner(id) !== undefined, (options, usage) => {
+      const call = this.record(options, usage)
+      if (call) also?.(call)
+    }, { refuse: options => refuse?.(options.sessionId) })
+  }
+  /** Records one call's usage. @returns the call, or undefined when its Session is not SuperAgent's or it used nothing. */
+  record(options: StreamOptions & { sessionId: string; relay?: UsageRelay }, usage: Record<string, number | undefined>): UsageCall | undefined {
+    const owner = this.owner(options.sessionId)
+    const tokens = tokensOf(usage)
+    if (!owner || !totalOf(tokens)) return undefined
+    const call: UsageCall = { at: new Date(this.now()).toISOString(), session: options.sessionId, ...owner, provider: options.provider ?? '',
+      model: options.model ?? '', ...options.purpose ? { purpose: options.purpose } : {}, ...options.relay ? { relay: options.relay } : {}, ...tokens }
+    this.db.prepare('INSERT INTO usage_call (at, session, value) VALUES (?,?,?)').run(call.at, call.session, JSON.stringify(call))
+    return call
+  }
+  /**
+   * 决策 15：群执行结算写一行进**已有的** `usage_call` 账本（不新建第二组计划表）。
+   * 复用 `engine.report()` 的结算结果；这里只负责让账本/用量页能看见「这张工单是群跑的」。
+   */
+  recordGroupSettlement(ticketId: string, roomId: string, state: string): UsageCall {
+    const call: UsageCall = { at: new Date(this.now()).toISOString(), session: `group-${roomId}`,
+      role: 'group', ticketId, roomId, purpose: `group:${state}`, provider: '', model: '',
+      input: 0, cacheRead: 0, cacheWrite: 0, output: 0 }
+    this.db.prepare('INSERT INTO usage_call (at, session, value) VALUES (?,?,?)').run(call.at, call.session, JSON.stringify(call))
+    return call
+  }
+  /** The latest conversation call of a Session (no auxiliary purpose, not another model's side call): what its context held then. */
+  last(sessionId: string): UsageCall | undefined {
+    for (const row of this.db.prepare('SELECT value FROM usage_call WHERE session=? ORDER BY id DESC LIMIT 20').all(sessionId)) {
+      const call = JSON.parse(String(row.value)) as UsageCall
+      if (!call.purpose && call.relay !== 'side') return call
+    }
+    return undefined
+  }
+  /** VsSaros addition (2026-11-07): the calls other listeners made inside a ticket's Sessions (its worker and its steps), kept days. */
+  relaysOf(ticketId: string): UsageRelays {
+    const rows = this.db.prepare('SELECT value FROM usage_call WHERE session = ? OR session LIKE ?').all(`worker-${ticketId}`, `step-${ticketId}-%`)
+    return relaysOf(rows.map(row => JSON.parse(String(row.value)) as UsageCall))
+  }
+  /** Totals since `since` (ISO), by role, model, Bot and ticket (the 20 largest of each). */
+  summary(since: string): UsageSummary {
+    const total = empty(), byRole = { master: empty(), desk: empty(), worker: empty(), step: empty(), group: empty() } as Record<UsageRole, UsageTotals>
+    const models = new Map<string, { provider: string; model: string } & UsageTotals>(), bots = new Map<string, { bot: string } & UsageTotals>()
+    const tickets = new Map<string, { ticketId: string } & UsageTotals>()
+    const calls: UsageCall[] = []
+    for (const row of this.db.prepare('SELECT value FROM usage_call WHERE at >= ?').all(since)) {
+      const call = JSON.parse(String(row.value)) as UsageCall
+      calls.push(call)
+      add(total, call)
+      add(byRole[call.role] ??= empty(), call)
+      const modelKey = `${call.provider}/${call.model}`
+      add(models.get(modelKey) ?? models.set(modelKey, { provider: call.provider, model: call.model, ...empty() }).get(modelKey)!, call)
+      if (call.bot) add(bots.get(call.bot) ?? bots.set(call.bot, { bot: call.bot, ...empty() }).get(call.bot)!, call)
+      if (call.ticketId) add(tickets.get(call.ticketId) ?? tickets.set(call.ticketId, { ticketId: call.ticketId, ...empty() }).get(call.ticketId)!, call)
+    }
+    const top = <T extends UsageTotals>(map: Map<string, T>) => [...map.values()].sort((a, b) => b.total - a.total).slice(0, 20)
+    return { since, total, byRole, byModel: top(models), byBot: top(bots), byTicket: top(tickets), relays: relaysOf(calls) }
+  }
+  /** Drops calls older than `USAGE_KEEP_DAYS`. */
+  prune(): void {
+    this.db.prepare('DELETE FROM usage_call WHERE at < ?').run(new Date(this.now() - USAGE_KEEP_DAYS * 86_400_000).toISOString())
+  }
+}
