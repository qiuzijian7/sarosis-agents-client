diff --git a/src/client/feed.ts b/src/client/feed.ts
new file mode 100644
index 00000000000..c5f156475c9
--- /dev/null
+++ b/src/client/feed.ts
@@ -0,0 +1,126 @@
+/**
+ * VsSaros addition (plan C): the change stream from dsh-superagent (`/orchestrator/api/stream`), shared by every view on
+ * the page: one connection while anything listens, none after. Views read their data again when a topic they show changes,
+ * and fall back to polling while the stream is down; after a reconnect every view reads again, since changes may have been
+ * missed. The stream is read with `fetch`, as `EventSource` cannot send the same-origin header the API requires.
+ */
+import { useEffect, useRef, useState } from 'react'
+import { usePoll } from './api.ts'
+
+export type FeedTopic = 'steps' | 'tickets' | 'desk'
+type Listener = (topics: readonly FeedTopic[] | 'all') => void
+const listeners = new Set<Listener>()
+const watchers = new Set<(live: boolean) => void>()
+let live = false
+let connected = false
+let current: AbortController | undefined
+let retry: ReturnType<typeof setTimeout> | undefined
+let failures = 0
+
+const emit = (topics: readonly FeedTopic[] | 'all') => { for (const listener of [...listeners]) listener(topics) }
+function setLive(next: boolean) {
+  if (live === next) return
+  live = next
+  for (const watch of [...watchers]) watch(next)
+}
+/** One SSE frame: its `change` event names the topics that changed. */
+export function parseFrame(frame: string): readonly FeedTopic[] | undefined {
+  let event = 'message', data = ''
+  for (const line of frame.split('\n')) {
+    if (line.startsWith('event:')) event = line.slice(6).trim()
+    else if (line.startsWith('data:')) data += line.slice(5).trim()
+  }
+  if (event !== 'change' || !data) return undefined
+  try {
+    const topics = (JSON.parse(data) as { topics?: unknown }).topics
+    return Array.isArray(topics) ? topics.filter((topic): topic is FeedTopic => topic === 'steps' || topic === 'tickets' || topic === 'desk') : undefined
+  } catch { return undefined }
+}
+async function connect(): Promise<void> {
+  const run = current = new AbortController()
+  try {
+    const response = await fetch('/orchestrator/api/stream', { headers: { 'x-orchestrator-request': '1', accept: 'text/event-stream' }, signal: run.signal })
+    if (!response.ok || !response.body) throw new Error(`stream ${response.status}`)
+    const reader = response.body.getReader()
+    const decoder = new TextDecoder()
+    failures = 0
+    setLive(true)
+    // Changes made while the stream was down were missed.
+    if (connected) emit('all')
+    connected = true
+    let buffer = ''
+    for (;;) {
+      const { value, done } = await reader.read()
+      if (done) break
+      buffer += decoder.decode(value, { stream: true }).replace(/\r\n/g, '\n')
+      for (let at = buffer.indexOf('\n\n'); at >= 0; at = buffer.indexOf('\n\n')) {
+        const topics = parseFrame(buffer.slice(0, at))
+        buffer = buffer.slice(at + 2)
+        if (topics?.length) emit(topics)
+      }
+    }
+  } catch { /* down: polled until it is back */ }
+  if (run !== current) return
+  current = undefined
+  setLive(false)
+  failures += 1
+  retry = setTimeout(() => { if (listeners.size) void connect() }, Math.min(30_000, 1000 * 2 ** Math.min(failures, 5)))
+}
+/** Listens to the stream's changes; the stream opens with the first listener and closes with the last. */
+export function subscribe(listener: Listener): () => void {
+  listeners.add(listener)
+  if (!current && !retry) void connect()
+  return () => {
+    listeners.delete(listener)
+    if (listeners.size) return
+    clearTimeout(retry); retry = undefined
+    const run = current
+    current = undefined
+    run?.abort()
+    setLive(false)
+  }
+}
+/**
+ * VsSaros addition (2026-11-07, the module's "hot dispose"): ends the stream and its reconnect timer and forgets every
+ * listener, whatever views are still mounted. The client plugin calls it when DSH disposes it (`apply` → `ctx.effect`): a
+ * plugin reload loads a new copy of this module, and DSH's client has no `import.meta.hot`, so without this the old copy's
+ * connection and backoff timer lived on until its last view unmounted (or forever, after a view that never did). A listener
+ * that subscribes afterwards opens a new stream; a view of the old plugin that unsubscribes later closes nothing of it, since
+ * a stream is closed only once no listener is left.
+ */
+export function disposeFeed(): void {
+  clearTimeout(retry); retry = undefined
+  const run = current
+  current = undefined
+  run?.abort()
+  listeners.clear()
+  setLive(false)
+  connected = false
+  failures = 0
+}
+/** Whether the stream is open or about to reconnect, and how many listen (for tests). */
+export function feedState(): { connecting: boolean; retrying: boolean; listeners: number } {
+  return { connecting: !!current, retrying: !!retry, listeners: listeners.size }
+}
+/** Whether the stream is open now. */
+export function useFeedLive(): boolean {
+  const [value, setValue] = useState(live)
+  useEffect(() => { watchers.add(setValue); setValue(live); return () => { watchers.delete(setValue) } }, [])
+  return value
+}
+
+/**
+ * Loads data and keeps it current: read again whenever one of `topics` changes, and polled every `intervalMs` while the
+ * stream is down (every `liveMs` while it is up, a safety net).
+ */
+export function useLive<T>(load: () => Promise<T>, deps: readonly unknown[], topics: readonly FeedTopic[], intervalMs = 5000, liveMs = 60_000) {
+  const isLive = useFeedLive()
+  const poll = usePoll(load, deps, isLive ? liveMs : intervalMs)
+  const reload = useRef(poll.reload)
+  reload.current = poll.reload
+  const wanted = topics.join(',')
+  useEffect(() => subscribe(changed => {
+    if (changed === 'all' || changed.some(topic => wanted.split(',').includes(topic))) void reload.current()
+  }), [wanted])
+  return { ...poll, live: isLive }
+}
diff --git a/src/client/flow-card.tsx b/src/client/flow-card.tsx
new file mode 100644
index 00000000000..9296cde34c8
--- /dev/null
+++ b/src/client/flow-card.tsx
@@ -0,0 +1,166 @@
+/**
+ * VsSaros addition (plan C): key-node cards in the supervisor desk's own (DSH) conversation. The desk hands each of the
+ * person's messages to the supervisor with its one tool; in DSH's chat that tool call is drawn as this card, which then
+ * follows the message live (the change stream): evaluating, declined, or taken as a ticket; the team proposal to agree to
+ * or refuse; the team at work with each Bot's mark and current work, its requests to approve, and a stop per step; and how
+ * the ticket ended. A message that reached a ticket another message started only says which ticket it went to.
+ *
+ * After DS Bot's handoff card (ds-bot/src/client/handoff-card.js, Copyright 2026 Fei2411 and the DS Bot contributors,
+ * Apache License 2.0; see NOTICE): a tool call in the chat drawn as a card that follows its state live.
+ */
+import type { ReactNode } from 'react'
+import type { DeskFlow, DeskFlowGroup } from '../app/desk-flow.ts'
+import { Button } from './controls.tsx'
+import { useLive } from './feed.ts'
+import { groupRoundStatus, groupRunElapsed, groupRunForFlow, groupRunLatestEvent, groupRunReplies, groupRunStatusKey, useGroupRuns } from './group-runs.tsx'
+import { BotMark, type MarkState } from './mark.tsx'
+import { ticketMark } from './marks.ts'
+import { useAction, usePanel } from './provider.tsx'
+import { errorText, reasonLabel, valueLabel } from './text.ts'
+import { ConfirmButton } from './widgets.tsx'
+import { ApprovalCard, MiniFlow, StepMembers } from './work.tsx'
+
+/** The trigger a settled `superagent_submit` call handed over, read from its JSON result. */
+export function triggerOfResult(content: readonly { type?: string; text?: string }[] | undefined): string | undefined {
+  for (const block of content ?? []) {
+    if (block.type !== 'text' || !block.text) continue
+    try {
+      const value = JSON.parse(block.text) as { trigger?: unknown }
+      if (typeof value.trigger === 'string' && value.trigger) return value.trigger
+    } catch { /* not this block */ }
+  }
+  return undefined
+}
+
+/** The supervisor's mark for where a message stands. */
+function supervisorState(flow: DeskFlow): MarkState {
+  if (flow.state === 'evaluating' || flow.state === 'unknown') return 'thinking'
+  if (flow.state !== 'ticket' || !flow.ticket || flow.ticket.ended) return 'idle'
+  if (flow.approvals.length || flow.proposal?.state === 'proposed') return 'alert'
+  if (flow.team?.steps.some(step => step.state === 'running')) return 'waiting'
+  return flow.ticket.stage.stage === 'working' ? 'working' : 'idle'
+}
+
+type NodeState = 'done' | 'active' | 'wait' | 'fail'
+function Node({ state, title, children }: { state: NodeState; title: ReactNode; children?: ReactNode }) {
+  return <li className="dt-fc-node" data-state={state}>
+    <span className="dt-fc-dot" aria-hidden="true" />
+    <div className="dt-fc-node-main"><div className="dt-fc-node-title">{title}</div>{children}</div>
+  </li>
+}
+
+/**
+ * VsSaros addition (2026-11-06): a message a group chat took. The desk records it as `ignore` on purpose (the supervisor
+ * stays out of a group's work), so this card says where it went and follows the group's run live, instead of "not taken".
+ */
+function GroupFlow({ group }: { group: DeskFlowGroup }) {
+  const { t, openSession, notify } = usePanel()
+  const run = groupRunForFlow(useGroupRuns(), group)
+  const status = run ? groupRoundStatus(run) : undefined
+  const replies = run ? groupRunReplies(run).length : 0
+  const latest = run ? groupRunLatestEvent(run) : undefined
+  return <div className="dt-fc" data-testid="flow-card" data-state="group" data-group-room={group.roomId} data-group-run-status={status ?? ''}>
+    <div className="dt-fc-head">
+      <BotMark id="superagent" name={t('chat.supervisor')} size={26} state="idle" />
+      <div className="dt-fc-head-main">
+        <b>{t(group.kind === 'created' ? 'flow.groupCreated' : group.kind === 'updated' ? 'flow.groupUpdated' : 'flow.groupRouted', { name: group.roomName })}</b>
+        {run && <span className="dt-tag" data-tone={status === 'failed' || status === 'cut' ? 'warning' : status === 'done' ? 'success' : 'info'}>
+          {t(groupRunStatusKey(run))}</span>}
+      </div>
+    </div>
+    <p className="dt-fc-note">
+      {run ? `${t('groupRuns.replies', { n: String(replies) })} · ${t('groupRuns.elapsed', { n: String(groupRunElapsed(run)) })}`
+        + (latest?.text ? ` · ${String(latest.text).slice(0, 80)}` : '')
+        : t('flow.groupNote')}
+    </p>
+    <div className="dt-row-actions">
+      <Button variant="outline" size="sm" data-act="open-flow-group"
+        onClick={() => { openSession(group.roomId).catch(failure => notify(errorText(failure))) }}>{t('groupRuns.open')}</Button>
+    </div>
+  </div>
+}
+
+/**
+ * One message's card, kept current by the change stream. VsSaros addition (2026-11-06): `receipt` draws only how its ticket
+ * ended (title, outcome, the team's steps, the summary), for the desk's turn that tells the person a ticket ended.
+ */
+export function FlowCard({ triggerId, receipt = false }: { triggerId: string; receipt?: boolean }) {
+  const { t, call, openSession, notify } = usePanel()
+  const { data, error, reload } = useLive(() => call('GET desk/flow/:id', { id: triggerId }), [triggerId], ['tickets', 'steps'], 4000)
+  const agree = useAction((input: { id: string; version: number }) => call('POST tickets/:id/team/approve', { id: input.id, body: { version: input.version } }), { reload })
+  const refuse = useAction((id: string) => call('POST tickets/:id/team/reject', { id, body: {} }), { reload })
+  if (!data) return <div className="dt-fc dt-fc-line" data-testid="flow-card">
+    <BotMark id="superagent" size={18} state="thinking" />{error ? error.message : t('flow.handed')}</div>
+  if (data.state === 'group' && data.group) return <GroupFlow group={data.group} />
+  const head = (text: ReactNode, tag?: ReactNode) => <div className="dt-fc-head">
+    <BotMark id="superagent" name={t('chat.supervisor')} size={26} state={supervisorState(data)} />
+    <div className="dt-fc-head-main"><b>{text}</b>{tag}</div>
+  </div>
+  const alsoGroup = data.group && <p className="dt-fc-note" data-testid="flow-card-group">
+    {t('flow.alsoGroup', { name: data.group.roomName })}{' '}
+    <button type="button" className="dt-textlink" data-act="open-flow-group"
+      onClick={() => { openSession(data.group!.roomId).catch(failure => notify(errorText(failure))) }}>{t('groupRuns.open')}</button></p>
+  if (data.state === 'unknown' || data.state === 'evaluating') return <div className="dt-fc" data-testid="flow-card">
+    {head(<span className="dt-shimmer">{t(data.unavailable ? 'flow.evalRetry' : 'flow.evaluating')}</span>)}</div>
+  if (data.state === 'filtered' || data.state === 'declined') return <div className="dt-fc" data-testid="flow-card" data-state="declined">
+    {head(t(data.state === 'filtered' ? 'flow.filtered' : 'flow.declined'))}
+    {data.reasons?.length ? <p className="dt-fc-note">{reasonLabel(t, data.reasons)}</p> : null}</div>
+  const ticket = data.ticket!
+  const mark = ticketMark(t, { ...ticket.stage, ended: ticket.ended } as never)
+  const stage = <span className="dt-tag" data-tone={mark.tone}>{mark.label}</span>
+  if (receipt && ticket.ended && !data.followup) {
+    const ended = ticket.ended, note = ticket.report?.summary || ended.reason
+    return <div className="dt-fc" data-testid="flow-card" data-receipt="ended" data-outcome={ended.outcome}>
+      {head(t('flow.receipt', { title: ticket.title }), stage)}
+      {data.team && <MiniFlow team={data.team} />}
+      {note && <p className="dt-fc-note">{note}</p>}
+    </div>
+  }
+  if (data.followup) return <div className="dt-fc dt-fc-line" data-testid="flow-card">
+    <BotMark id="superagent" size={18} />{t('flow.followup', { title: ticket.title })}{stage}{alsoGroup}</div>
+
+  const proposal = data.proposal, team = data.team
+  const waitingProposal = proposal?.state === 'proposed'
+  const proposalState: NodeState = !proposal ? 'wait' : proposal.state === 'approved' ? 'done' : proposal.state === 'rejected' ? 'fail' : 'active'
+  const done = team ? team.steps.filter(step => step.state === 'ready').length : 0
+  const teamState: NodeState = !team ? 'wait' : ticket.ended ? (done === team.steps.length ? 'done' : 'fail')
+    : team.steps.every(step => ['ready', 'failed', 'skipped', 'stopped'].includes(step.state)) ? 'done' : 'active'
+  const ended = ticket.ended
+  return <div className="dt-fc" data-testid="flow-card">
+    {head(ticket.title, stage)}
+    {alsoGroup}
+    <ol className="dt-fc-nodes">
+      <Node state="done" title={t('flow.taken')} />
+      <Node state={proposalState} title={proposal ? t('flow.proposal', { version: String(proposal.version) }) : t('flow.proposing')}>
+        {proposal && <div className="dt-fc-proposal">
+          <div className="dt-fc-roles">{proposal.roles.map(role => <span key={role.key} className="dt-fc-role">
+            <BotMark id={role.bot?.id ?? role.draft?.id ?? role.key} size={18} />
+            {role.bot?.name ?? role.draft?.name ?? role.key}{role.draft ? <em>{t('team.staffingNew')}</em> : null}</span>)}</div>
+          <div className="dt-fc-note">{proposal.steps.map(step => step.title).join(' → ')}</div>
+          {(proposal.risk.newBots > 0 || proposal.risk.writeSteps > 0 || proposal.risk.highRiskTools.length > 0) &&
+            <div className="dt-fc-note"><span className="dt-tag" data-tone="warning">{t('team.risky')}</span>
+              {' '}{t('flow.risk', { bots: String(proposal.risk.newBots), writes: String(proposal.risk.writeSteps) })}</div>}
+          {waitingProposal && <div className="dt-row-actions">
+            <Button variant="primary" size="sm" disabled={agree.busy} onClick={() => { void agree.run({ id: ticket.id, version: proposal.version }) }}>{t('team.staffingAgree')}</Button>
+            <ConfirmButton variant="outline" label={t('team.staffingRefuse')} title={t('team.staffingRefuseTitle')}
+              message={t('team.staffingRefuseConfirm', { title: ticket.title })} onConfirm={async () => { await refuse.run(ticket.id) }} />
+          </div>}
+        </div>}
+      </Node>
+      {(team || proposal?.state === 'approved') && <Node state={teamState}
+        title={team ? t('flow.team', { done: String(done), total: String(team.steps.length) }) : t('flow.teamStarting')}>
+        {team && <MiniFlow team={team} />}
+        {data.approvals.map(item => <ApprovalCard key={item.id} approval={item} />)}
+        {team && !ended && <StepMembers team={team} />}
+      </Node>}
+      {ended
+        ? <Node state={ended.outcome === 'completed' || ended.outcome === 'merged' ? 'done' : 'fail'}
+          title={t('flow.ended', { outcome: valueLabel(t, 'outcome', ended.outcome) })}>
+          {(ticket.report?.summary || ended.reason) && <p className="dt-fc-note">{ticket.report?.summary || ended.reason}</p>}
+        </Node>
+        : ticket.report && ticket.stage.stage === 'person' && <Node state="active" title={t('flow.report')}>
+          <p className="dt-fc-note">{ticket.report.summary}</p>
+        </Node>}
+    </ol>
+  </div>
+}
diff --git a/src/client/group-runs.tsx b/src/client/group-runs.tsx
new file mode 100644
index 00000000000..b6cb7438054
--- /dev/null
+++ b/src/client/group-runs.tsx
@@ -0,0 +1,217 @@
+/**
+ * VsSaros addition (2026-11-05): live group-chat runs in the Workbench and Execution tabs.
+ *
+ * The orchestrator's `GET state` / `GET tickets` / `GET team/steps` only describe Tickets, Steps and Executor slots.
+ * A group chat relay lives in `vssaros-agents` and is broadcast by `vssaros-chat-surface`'s global activity dock as
+ * `vssaros-group-progress`. This module is read-only: it does not change Ticket/Step semantics, SSE topics or host APIs.
+ */
+import { useEffect, useState } from 'react'
+import { usePanel } from './provider.tsx'
+import { errorText } from './text.ts'
+import type { T } from './text.ts'
+
+export const GROUP_PROGRESS_EVENT = 'vssaros-group-progress'
+/** Same value as vssaros-agents `ROUND_SCHEMA`: the cross-plugin group-run contract this panel understands. */
+export const GROUP_ACTIVITY_SCHEMA = 1
+export interface GroupRunEvent { kind?: string; name?: string; text?: string; at?: number }
+export interface GroupRunReply { botId?: string; name?: string; text?: string; ms?: number; kind?: string }
+export interface GroupRunFailure { botId?: string; name?: string; reason?: string }
+export type GroupRoundStatus = 'sent' | 'replying' | 'done' | 'cut' | 'failed'
+export interface GroupRun {
+  schema?: number; callId?: string; roomId?: string; roomName?: string
+  startedAt?: number; finishedAt?: number; done?: boolean; error?: string
+  phase?: string; interrupted?: boolean; status?: GroupRoundStatus; statusLabel?: string
+  /** Correlation with the SuperAgent trigger / the session the `@group` came from. */
+  originTriggerId?: string; fromSession?: string; sourceMessageId?: string
+  replies?: GroupRunReply[]; events?: GroupRunEvent[]
+  speaking?: string[]; passed?: string[]; failed?: GroupRunFailure[]
+}
+type GroupRunState = 'running' | 'done' | 'error' | 'cut'
+type GroupRunStatusKey = 'groupRuns.status.running' | 'groupRuns.status.replying' | 'groupRuns.status.done' | 'groupRuns.status.error'
+  | 'groupRuns.status.cut'
+type GroupRunMemberState = 'speaking' | 'replied' | 'passed' | 'failed' | 'waiting'
+type GroupRunTextKey = GroupRunStatusKey | 'groupRuns.title' | 'groupRuns.replies' | 'groupRuns.elapsed'
+  | 'groupRuns.failed' | 'groupRuns.member.speaking' | 'groupRuns.member.replied' | 'groupRuns.member.passed'
+  | 'groupRuns.member.failed' | 'groupRuns.member.waiting'
+interface GroupRunMember { name: string; state: GroupRunMemberState; labelKey: GroupRunTextKey }
+
+const STATUSES: readonly GroupRoundStatus[] = ['sent', 'replying', 'done', 'cut', 'failed']
+/**
+ * The one state machine for a group run (verbatim copy of vssaros-agents `roundStatusOf`; the server's `status` wins).
+ * Interrupted beats failed: a run cut by a restart carries an error too. check-bots-rooms.mjs pins all copies to one table.
+ */
+export function groupRoundStatus(run: GroupRun | null | undefined): GroupRoundStatus {
+  const r = run && typeof run === 'object' ? run : {}
+  if (r.status && STATUSES.includes(r.status)) { return r.status }
+  const events = Array.isArray(r.events) ? r.events : []
+  if (r.interrupted || r.phase === 'cut' || events.some(event => event && event.kind === 'cut')) { return 'cut' }
+  if (!r.done) { return (Array.isArray(r.speaking) ? r.speaking.length : 0) > 0 ? 'replying' : 'sent' }
+  return r.error ? 'failed' : 'done'
+}
+/** Drops malformed entries of a broadcast this panel does not own. */
+export function normalizeGroupRuns(value: unknown): GroupRun[] {
+  return (Array.isArray(value) ? value : []).filter((item): item is GroupRun =>
+    !!item && typeof item === 'object' && typeof (item as GroupRun).roomId === 'string' && !!(item as GroupRun).roomId)
+}
+
+/** Initial snapshot left by the chat-surface activity dock; the event below keeps it current. */
+function globalRuns(): GroupRun[] {
+  if (typeof window === 'undefined') { return [] }
+  return normalizeGroupRuns((window as unknown as { __vssarosGroupProgress?: unknown }).__vssarosGroupProgress)
+}
+/** The Bots plugin's list of running and recently ended group runs (what the chat-surface dock broadcasts). */
+export const AGENTS_ROOMS_ACTIVE = '/x/agents/api/rooms?active=1'
+/**
+ * How long to wait for a broadcast before reading the list directly, and how often then. Without it the section stayed empty
+ * whenever chat-surface was missing, loaded later, or ran in another webview. Tests may shorten it.
+ */
+export const groupRunsConfig = { fallbackMs: 5000 }
+/**
+ * One subscription per mounted tab. The chat-surface broadcast is the source; only while none has been heard does the tab
+ * read the list itself, slowly, and it stops as soon as a broadcast arrives. No host API or SSE topic changes.
+ */
+export function useGroupRuns(): GroupRun[] {
+  const [runs, setRuns] = useState<GroupRun[]>(globalRuns)
+  useEffect(() => {
+    if (typeof window === 'undefined') { return undefined }
+    let alive = true
+    let heard = Array.isArray((window as unknown as { __vssarosGroupProgress?: unknown }).__vssarosGroupProgress)
+    let timer: ReturnType<typeof setTimeout> | undefined
+    setRuns(globalRuns())
+    const onProgress = (event: Event) => {
+      heard = true
+      const detail = (event as CustomEvent<{ active?: unknown; schema?: number }>).detail
+      // A newer contract than this panel knows is still read field by field; only its shape is checked.
+      setRuns(normalizeGroupRuns(detail?.active))
+    }
+    const poll = async () => {
+      if (!alive || heard) { return }
+      try {
+        const response = await fetch(AGENTS_ROOMS_ACTIVE)
+        const body = response.ok ? await response.json() as { active?: unknown } : undefined
+        if (alive && !heard && Array.isArray(body?.active)) { setRuns(normalizeGroupRuns(body.active)) }
+      } catch { /* the Bots plugin is not there: nothing to show */ }
+      if (alive && !heard) { timer = setTimeout(() => { void poll() }, groupRunsConfig.fallbackMs) }
+    }
+    window.addEventListener(GROUP_PROGRESS_EVENT, onProgress)
+    if (!heard) { timer = setTimeout(() => { void poll() }, groupRunsConfig.fallbackMs) }
+    return () => { alive = false; clearTimeout(timer); window.removeEventListener(GROUP_PROGRESS_EVENT, onProgress) }
+  }, [])
+  return runs
+}
+
+export function groupRunState(run: GroupRun): GroupRunState {
+  const status = groupRoundStatus(run)
+  return status === 'failed' ? 'error' : status === 'cut' ? 'cut' : status === 'done' ? 'done' : 'running'
+}
+export function groupRunStatusKey(run: GroupRun): GroupRunStatusKey {
+  const status = groupRoundStatus(run)
+  return status === 'failed' ? 'groupRuns.status.error' : status === 'cut' ? 'groupRuns.status.cut'
+    : status === 'done' ? 'groupRuns.status.done' : status === 'replying' ? 'groupRuns.status.replying' : 'groupRuns.status.running'
+}
+export function groupRunReplies(run: GroupRun): GroupRunReply[] {
+  return (Array.isArray(run?.replies) ? run.replies : []).filter(reply => reply && !reply.kind)
+}
+export function groupRunElapsed(run: GroupRun, now = Date.now()): number {
+  const started = Number(run?.startedAt ?? 0)
+  if (!started) { return 0 }
+  const ended = Number(run?.finishedAt ?? 0) || now
+  return Math.max(0, Math.round((ended - started) / 1000))
+}
+export function groupRunLatestEvent(run: GroupRun): GroupRunEvent | undefined {
+  const events = Array.isArray(run?.events) ? run.events : []
+  return events.length ? events[events.length - 1] : undefined
+}
+const memberLabelKey = (state: GroupRunMemberState): GroupRunTextKey =>
+  state === 'speaking' ? 'groupRuns.member.speaking' : state === 'replied' ? 'groupRuns.member.replied'
+    : state === 'passed' ? 'groupRuns.member.passed' : state === 'failed' ? 'groupRuns.member.failed' : 'groupRuns.member.waiting'
+/** Merge name-only `speaking/passed/events` with `replies/failed`, first state wins. */
+export function groupRunMembers(run: GroupRun): GroupRunMember[] {
+  const out: GroupRunMember[] = []
+  const add = (value: unknown, state: GroupRunMemberState) => {
+    const name = String(value ?? '').trim()
+    if (!name || out.some(item => item.name === name)) { return }
+    out.push({ name, state, labelKey: memberLabelKey(state) })
+  }
+  for (const item of Array.isArray(run?.failed) ? run.failed : []) { add(item?.name, 'failed') }
+  for (const event of Array.isArray(run?.events) ? run.events : []) {
+    if (event?.name && /^(failed|missed|cut)$/.test(String(event.kind ?? ''))) { add(event.name, 'failed') }
+  }
+  for (const name of Array.isArray(run?.speaking) ? run.speaking : []) { add(name, 'speaking') }
+  for (const event of Array.isArray(run?.events) ? run.events : []) {
+    if (!event?.name) { continue }
+    add(event.name, /^(working|resumed)$/.test(String(event.kind ?? '')) ? 'speaking' : 'waiting')
+  }
+  for (const reply of groupRunReplies(run)) { add(reply?.name, 'replied') }
+  for (const name of Array.isArray(run?.passed) ? run.passed : []) { add(name, 'passed') }
+  return out
+}
+
+/** Where a run came from: an `@group` routed from another conversation, or the request that created the group. */
+export function groupRunSource(run: GroupRun): 'post' | 'created' | undefined {
+  if (run?.fromSession) { return 'post' }
+  if (run?.originTriggerId) { return 'created' }
+  return undefined
+}
+
+/**
+ * The run a desk message's card follows. An `@group` command follows the run its own message started (the agents plugin
+ * records the DSH message id as `sourceMessageId`), never another one in the same group; a new group follows its latest run.
+ */
+export function groupRunForFlow(runs: readonly GroupRun[], group: { roomId: string; kind: 'created' | 'routed' | 'updated'; sourceMessageId?: string }):
+  GroupRun | undefined {
+  const inRoom = (runs ?? []).filter(run => run?.roomId === group.roomId)
+  if (group.kind === 'routed') return group.sourceMessageId ? inRoom.find(run => run.sourceMessageId === group.sourceMessageId) : undefined
+  return [...inRoom].sort((a, b) => Number(b.startedAt ?? 0) - Number(a.startedAt ?? 0))[0]
+}
+
+/** Independent section; deliberately avoids `.dt-status-line`, `.dt-lv`, `.dt-stat`, `.dt-work-bar` and the ticket list. */
+export function GroupRuns({ compact = false }: { compact?: boolean }) {
+  const { t, openSession, notify } = usePanel()
+  const runs = useGroupRuns()
+  if (!runs.length) { return null }
+  return <section className="dt-group-runs" data-vssaros-group-runs="1" data-testid="group-runs" aria-label={t('groupRuns.title')}>
+    <div className="dt-group-runs-head"><b>{t('groupRuns.title')}</b><span>{runs.length}</span></div>
+    {compact && <p className="dt-group-runs-note" data-testid="group-runs-note">{t('groupRuns.note')}</p>}
+    <div className="dt-group-runs-list">
+      {runs.slice(0, compact ? 3 : 5).map((run, index) => {
+        const state = groupRunState(run)
+        const statusKey = groupRunStatusKey(run)
+        const replies = groupRunReplies(run)
+        const members = groupRunMembers(run)
+        const latest = groupRunLatestEvent(run)
+        const roomName = String(run?.roomName || run?.roomId || '群聊')
+        const failures = (Array.isArray(run?.failed) ? run.failed.length : 0)
+        const source = groupRunSource(run)
+        const roomId = String(run?.roomId || '')
+        return <article className="dt-group-runs-card" key={String(run?.callId || run?.roomId || index)}
+          data-vssaros-group-run={String(run?.callId || '')} data-vssaros-group-run-room={roomId}
+          data-vssaros-group-run-state={state} data-vssaros-group-run-status={t(statusKey)}
+          data-vssaros-group-run-round-status={groupRoundStatus(run)}
+          data-vssaros-group-run-source={source ?? ''} data-vssaros-group-run-trigger={String(run?.originTriggerId || '')}
+          data-vssaros-group-run-name={roomName} data-vssaros-group-run-replies={String(replies.length)}
+          data-vssaros-group-run-elapsed={String(groupRunElapsed(run))} data-state={state}>
+          <div className="dt-group-runs-title">
+            <span className="dt-group-runs-dot" data-state={state} aria-hidden="true" />
+            <b>{roomName}</b><span className="dt-group-runs-status">{t(statusKey)}</span>
+            {roomId && <button type="button" className="dt-textlink dt-group-runs-open" data-act="open-group-run"
+              onClick={() => { openSession(roomId).catch(failure => notify(errorText(failure))) }}>{t('groupRuns.open')}</button>}
+          </div>
+          <div className="dt-group-runs-meta">
+            <span>{t('groupRuns.replies', { n: String(replies.length) })}</span>
+            <span>{t('groupRuns.elapsed', { n: String(groupRunElapsed(run)) })}</span>
+            {failures > 0 && <span>{t('groupRuns.failed', { n: String(failures) })}</span>}
+            {source && <span className="dt-group-runs-source"
+              title={run?.originTriggerId ? t('groupRuns.source.trigger', { id: run.originTriggerId }) : undefined}>
+              {t(source === 'post' ? 'groupRuns.source.post' : 'groupRuns.source.created')}</span>}
+          </div>
+          {members.length > 0 && <div className="dt-group-runs-members">{members.slice(0, 8).map(member =>
+            <span className="dt-group-runs-member" key={member.name} data-vssaros-group-run-member={member.name}
+              data-vssaros-group-run-member-state={member.state} title={`${member.name} · ${t(member.labelKey)}`}>
+              {member.name} · {t(member.labelKey)}</span>)}</div>}
+          {latest?.text && <div className="dt-group-runs-latest">{String(latest.text).slice(0, 120)}</div>}
+        </article>
+      })}
+    </div>
+  </section>
+}
