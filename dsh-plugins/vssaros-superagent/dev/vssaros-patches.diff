+    settle: vi.fn(),
+    requestPass: vi.fn(),
+    bots: vi.fn(async () => ROSTER),
+    createGroup: vi.fn(async () => group()),
+    warn: vi.fn(),
+    fallback: vi.fn(),
+    ...overrides,
+  }
+  return h as GroupFastPathHost & typeof h
