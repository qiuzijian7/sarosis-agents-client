+++ b/src/sources/tapd-api.ts
@@ -0,0 +1,246 @@
+/**
+ * VsSaros addition: reading and commenting on TAPD stories, bugs and tasks through TAPD's Open API
+ * (`https://api.tapd.cn` by default). Credentials are resolved by `tapd-auth.ts` in the Host only; the
+ * MCP/mcporter-internal transport was retired in 0.1.81, and the settings keys it used are kept solely
+ * so settings saved by older versions still parse. Records come back as plain objects of strings.
+ */
+import { z } from 'zod'
+import { tapdCredential, tapdCredentialsHint, tapdEnvironment, tapdTimeoutMs, type TapdEnv } from './tapd-auth.ts'
+
+export const TAPD_SOURCE = 'tapd'
+export const TAPD_TYPES = ['story', 'bug', 'task'] as const
+export type TapdType = typeof TAPD_TYPES[number]
+const COLLECTION: Record<TapdType, { path: string; record: string; entry: string; page: string }> = {
+  story: { path: 'stories', record: 'Story', entry: 'stories', page: 'prong/stories/view' },
+  bug: { path: 'bugs', record: 'Bug', entry: 'bug', page: 'bugtrace/bugs/view' },
+  task: { path: 'tasks', record: 'Task', entry: 'tasks', page: 'prong/tasks/view' },
+}
+export const TapdConfigSchema = z.object({
+  /** Deprecated and ignored: the MCP transport was retired. Kept so older saved settings still parse. */
+  transport: z.enum(['openapi', 'mcp']).default('openapi'),
+  api: z.string().trim().regex(/^https:\/\/[^\s/]+(\/[^\s]*)?$/).default('https://api.tapd.cn'),
+  site: z.string().trim().regex(/^https:\/\/[^\s/]+$/).default('https://www.tapd.cn'),
+  /** Deprecated and ignored (MCP CLI). Kept so older saved settings still parse. */
+  cli: z.string().trim().default(''),
+  /** Deprecated and ignored (MCP server). Kept so older saved settings still parse. */
+  server: z.string().trim().regex(/^[\w.-]+$/).default('tapd'),
+  /** TAPD `workspace_id`; every watch without its own inherits this. GR is the default. */
+  workspace: z.string().trim().regex(/^\d+$/).default('68880148'),
+  /** Deprecated and ignored (the retired intranet member endpoint). Kept so older saved settings still parse. */
+  memberApi: z.string().trim().default(''),
+  /** WeCom alias -> TAPD Chinese name; the only identity mapping the Open API Source uses. */
+  members: z.array(z.object({ alias: z.string().trim().min(1), name: z.string().trim().min(1) }).strict()).default([]),
+  /** Optional TAPD identity: a person's Chinese name or a robot account's name, as TAPD writes `owner`/`current_owner`
+   * and as people @ in comments. It is not a query parameter; it only recognises what addresses SuperAgent and signs
+   * replies. Empty: no identity matching, and replies are signed `dsh-superagent`. */
+  agent: z.string().trim().default(''),
+  watches: z.array(z.object({
+    name: z.string().trim().regex(/^[\w.-]{1,40}$/),
+    /** Empty: inherit the Source-level `workspace`. */
+    workspace: z.string().trim().regex(/^\d*$/).default(''),
+    type: z.enum(TAPD_TYPES),
+    /** One item's ID: the watch follows that item alone. Empty: a list, by the filters below. */
+    item: z.string().trim().regex(/^\d*$/).default(''),
+    status: z.string().trim().default(''),
+    owner: z.string().trim().default(''),
+    iteration: z.string().trim().regex(/^\d*$/).default(''),
+    /** `assigned`: only what is assigned to `agent`, or @s it; `all`: every change, which the Policy's admission table decides. */
+    mode: z.enum(['assigned', 'all']).default('assigned'),
+  }).strict()).default([]),
+  /** Optional TAPD Webhook ingress: a fast lane on top of polling, off by default. TAPD POSTs to
+   * `/orchestrator/webhook/tapd`; the event carries IDs only, so the item is reread before it is received. */
+  webhook: z.boolean().default(false),
+  /** The shared secret TAPD sends as the `secret` field (or `x-tapd-secret` header / `secret` query); required while on. */
+  webhookSecret: z.string().trim().default(''),
+  pollSeconds: z.number().int().min(60).max(3600).default(120),
+  failuresBeforeError: z.number().int().min(1).max(20).default(3),
+}).strict()
+export type TapdConfig = z.infer<typeof TapdConfigSchema>
+export type TapdWatch = TapdConfig['watches'][number]
+/** A watch (project/type/filters) and the account credentials are enough; the identity name is optional. */
+export const tapdConfigured = (config: TapdConfig): boolean => config.watches.length > 0
+/** A watch's own workspace ID, or the Source-level default (GR project) when the watch leaves it empty. */
+export const watchWorkspace = (config: Pick<TapdConfig, 'workspace'>, watch: TapdWatch): string => watch.workspace || config.workspace
+
+/** A TAPD record with its fields as strings, as TAPD returns them. */
+export type TapdRecord = Record<string, string>
+export interface TapdItem { type: TapdType; workspace: string; id: string; title: string; description: string; status: string
+  owners: string[]; creator: string; created: string; modified: string; iteration: string }
+export interface TapdComment { id: string; author: string; text: string; created: string; modified: string }
+
+/** TAPD writes times as `YYYY-MM-DD HH:mm:ss` in China time; this is the same instant in ISO form. */
+export const tapdInstant = (time: string): string => /^\d{4}-\d\d-\d\d \d\d:\d\d:\d\d$/.test(time) ? new Date(`${time.replace(' ', 'T')}+08:00`).toISOString() : time
+/** An instant as TAPD writes times, in China time. */
+export const tapdTime = (iso: string): string => new Date(Date.parse(iso) + 8 * 3600_000).toISOString().slice(0, 19).replace('T', ' ')
+/** Plain text of a TAPD rich-text field (HTML), with paragraphs and line breaks kept. */
+export function plainText(html: string): string {
+  return html.replace(/<br\s*\/?>/gi, '\n').replace(/<\/(p|div|li|h\d)>/gi, '\n').replace(/<[^>]+>/g, '')
+    .replace(/&nbsp;/g, ' ').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, '\'').replace(/&amp;/g, '&')
+    .replace(/[ \t]+\n/g, '\n').replace(/\n{3,}/g, '\n\n').trim()
+}
+const names = (value: string | undefined): string[] => (value ?? '').split(/[;,；]/).map(name => name.trim()).filter(Boolean)
+export function itemOf(type: TapdType, record: TapdRecord): TapdItem {
+  return { type, workspace: record.workspace_id ?? '', id: record.id ?? '', title: record.name ?? record.title ?? '',
+    description: plainText(record.description ?? ''), status: record.status ?? '',
+    owners: names(type === 'bug' ? record.current_owner : record.owner), creator: record.creator ?? record.reporter ?? '',
+    created: tapdInstant(record.created ?? ''), modified: tapdInstant(record.modified ?? record.created ?? ''), iteration: record.iteration_id ?? '' }
+}
+export const commentOf = (record: TapdRecord): TapdComment => ({ id: record.id ?? '', author: record.author ?? '', text: plainText(record.description ?? ''),
+  created: tapdInstant(record.created ?? ''), modified: tapdInstant(record.modified ?? record.created ?? '') })
+export const itemPage = (site: string, item: Pick<TapdItem, 'type' | 'workspace' | 'id'>): string => `${site}/${item.workspace}/${COLLECTION[item.type].page}/${item.id}`
+/** Parses the page of a story, bug or task on any TAPD site. */
+export function itemAddress(url: string): Pick<TapdItem, 'type' | 'workspace' | 'id'> | undefined {
+  const match = /^https?:\/\/[^/]*tapd[^/]*\/(?:tapd_fe\/)?(\d+)\/(prong\/stories|bugtrace\/bugs|prong\/tasks)\/view\/(\d+)/i.exec(url.trim())
+  if (!match) return undefined
+  const type = match[2]!.endsWith('stories') ? 'story' : match[2]!.endsWith('bugs') ? 'bug' : 'task'
+  return { type, workspace: match[1]!, id: match[3]! }
+}
+
+/** TAPD failed to answer; `gone` when the item no longer exists, which a reply should not retry. */
+export class TapdError extends Error { constructor(message: string, readonly gone = false) { super(message) } }
+/**
+ * Strips the envelopes TAPD data comes in: an MCP tool result (`content[].text` or `structuredContent`), TAPD's own
+ * `{ status, data, info }`, and the one-key `{ Story: {...} }` wrapper of each record.
+ */
+export function records(value: unknown): TapdRecord[] {
+  let current = value
+  for (let depth = 0; depth < 6; depth++) {
+    if (typeof current === 'string') {
+      const text = current
+      try { current = JSON.parse(text) } catch { throw new TapdError(text.slice(0, 500)) }
+      continue
+    }
+    if (Array.isArray(current)) break
+    if (!current || typeof current !== 'object') return []
+    const object = current as Record<string, unknown>
+    // saroasis-platform: an unknown API path answers HTTP 200 with status 1 and this string as data.
+    // Detect it before the status check, which such a response would pass.
+    if (typeof object.data === 'string' && /Hello world from TAPD API/i.test(object.data))
+      throw new TapdError('TAPD answered "Hello world from TAPD API": the API path does not exist')
+    if (object.isError === true) throw new TapdError(JSON.stringify(object.content ?? object).slice(0, 500))
+    if (Array.isArray(object.content) && object.structuredContent === undefined) {
+      current = (object.content as { type?: string; text?: string }[]).filter(block => block.type === 'text').map(block => block.text ?? '').join('')
+      continue
+    }
+    if (object.structuredContent !== undefined) { current = object.structuredContent; continue }
+    if ('status' in object && 'data' in object) {
+      if (Number(object.status) !== 1) throw new TapdError(String(object.info ?? `TAPD status ${String(object.status)}`))
+      current = object.data
+      continue
+    }
+    if ('data' in object && Object.keys(object).length <= 3) { current = object.data; continue }
+    current = [object]
+    break
+  }
+  if (!Array.isArray(current)) return []
+  return current.flatMap(entry => {
+    if (!entry || typeof entry !== 'object') return []
+    const keys = Object.keys(entry)
+    const inner = keys.length === 1 && /^[A-Z]/.test(keys[0]!) ? (entry as Record<string, unknown>)[keys[0]!] : entry
+    if (!inner || typeof inner !== 'object') return []
+    return [Object.fromEntries(Object.entries(inner).map(([name, field]) => [name, field == null ? '' : String(field)]))]
+  })
+}
+
+/** One option of a settings dropdown, fetched from TAPD's Open API. */
+export interface TapdChoice { value: string; label: string }
+/** The read and comment operations the TAPD Source needs over TAPD's Open API. */
+export interface TapdApi {
+  /** Items of `type` in `workspace` matching `filter` (TAPD query fields, such as `modified: '>2026-11-03 10:00:00'`), oldest change first. */
+  items(type: TapdType, workspace: string, filter: Record<string, string>, signal?: AbortSignal): Promise<TapdItem[]>
+  comments(type: TapdType, workspace: string, id: string, since?: string, signal?: AbortSignal): Promise<TapdComment[]>
+  comment(type: TapdType, workspace: string, id: string, author: string, html: string, signal?: AbortSignal): Promise<void>
+  /** Optional lookup lists for the settings dropdowns (projects / workflow statuses / iterations).
+   * Stand-in APIs used by tests may omit it, so the settings refresh degrades to labels it can build locally. */
+  choices?(kind: 'workspace' | 'status' | 'iteration', workspace: string, signal?: AbortSignal): Promise<TapdChoice[]>
+}
+const PAGE = 200
+const MAX_PAGES = 10
+/** Fetches every page of a list (TAPD pages hold at most 200). */
+async function paged(read: (page: number) => Promise<TapdRecord[]>): Promise<TapdRecord[]> {
+  const all: TapdRecord[] = []
+  for (let page = 1; page <= MAX_PAGES; page++) {
+    const got = await read(page)
+    all.push(...got)
+    if (got.length < PAGE) break
+  }
+  return all
+}
+/** saroasis-platform: TAPD ignores `offset` and always returns page 1; paging must use `page`. */
+const listArgs = (filter: Record<string, string>, page: number) => {
+  if (filter.offset !== undefined) throw new TapdError('TAPD ignores offset; pagination uses page')
+  return { ...filter, limit: String(PAGE), page: String(page), order: 'modified asc' }
+}
+const commentFilter = (type: TapdType, workspace: string, id: string, since?: string) =>
+  ({ workspace_id: workspace, entry_type: COLLECTION[type].entry, entry_id: id, ...since ? { modified: `>${tapdTime(since)}` } : {} })
+
+export interface OpenApiOptions { api: string; environment?: TapdEnv; fetch?: typeof fetch; timeoutMs?: number }
+/** The result of a read-only connectivity check; the panel shows `method` or `error`, never a secret. */
+export interface TapdTestResult { ok: boolean; method?: string; error?: string; at: string }
+/** TAPD's Open API, signed in with the account the Host's environment or credentials file names. */
+export class TapdOpenApi implements TapdApi {
+  private readonly fetch: typeof fetch
+  constructor(private readonly options: OpenApiOptions) { this.fetch = options.fetch ?? globalThis.fetch }
+  /** An explicit environment (tests) is used as-is; a real Host also reads the local credentials file. */
+  private get env(): TapdEnv { return this.options.environment ?? tapdEnvironment() }
+  private authorization(): string {
+    const credential = tapdCredential(this.env)
+    if (!credential) throw new TapdError(tapdCredentialsHint(this.env))
+    return credential.header
+  }
+  /** Checks credentials and reachability with TAPD's testauth endpoint, without reading or changing any item. */
+  async verify(workspace?: string): Promise<void> {
+    await this.request('GET', 'quickstart/testauth', workspace ? { workspace_id: workspace } : {})
+  }
+  private async request(method: 'GET' | 'POST', path: string, fields: Record<string, string>, signal?: AbortSignal): Promise<TapdRecord[]> {
+    const timeout = AbortSignal.timeout(this.options.timeoutMs ?? tapdTimeoutMs(this.env))
+    const query = new URLSearchParams(fields).toString()
+    const url = `${this.options.api.replace(/\/$/, '')}/${path}${method === 'GET' ? `?${query}` : ''}`
+    const response = await this.fetch(url, { method, signal: signal ? AbortSignal.any([signal, timeout]) : timeout,
+      headers: { authorization: this.authorization(), accept: 'application/json',
+        ...method === 'POST' ? { 'content-type': 'application/x-www-form-urlencoded' } : {} },
+      ...method === 'POST' ? { body: query } : {} })
+    const text = await response.text()
+    if (response.status === 401 || response.status === 403) throw new TapdError(`TAPD refused the account (HTTP ${response.status})`)
+    if (!response.ok) throw new TapdError(`TAPD answered HTTP ${response.status}: ${text.slice(0, 300)}`, response.status === 404)
+    return records(text)
+  }
+  async items(type: TapdType, workspace: string, filter: Record<string, string>, signal?: AbortSignal): Promise<TapdItem[]> {
+    const got = await paged(page => this.request('GET', COLLECTION[type].path, listArgs({ workspace_id: workspace, ...filter }, page), signal))
+    return got.map(record => itemOf(type, { workspace_id: workspace, ...record }))
+  }
+  async comments(type: TapdType, workspace: string, id: string, since?: string, signal?: AbortSignal): Promise<TapdComment[]> {
+    return (await paged(page => this.request('GET', 'comments', listArgs(commentFilter(type, workspace, id, since), page), signal))).map(commentOf)
+  }
+  async comment(type: TapdType, workspace: string, id: string, author: string, html: string, signal?: AbortSignal): Promise<void> {
+    await this.request('POST', 'comments', { workspace_id: workspace, entry_type: COLLECTION[type].entry, entry_id: id, author, description: html }, signal)
+  }
+  /** Candidate values for the settings dropdowns. `status_map` answers an object of code -> Chinese name,
+   * while projects and iterations answer record lists; `records()` already normalises both envelopes. */
+  async choices(kind: 'workspace' | 'status' | 'iteration', workspace: string, signal?: AbortSignal): Promise<TapdChoice[]> {
+    if (kind === 'workspace') {
+      const rows = await this.request('GET', 'workspaces/user_participant_projects', {}, signal)
+      return rows.map(row => ({ value: String(row.id ?? row.workspace_id ?? ''),
+        label: String(row.name ?? row.title ?? row.id ?? '') })).filter(choice => choice.value)
+    }
+    if (kind === 'iteration') {
+      const rows = await this.request('GET', 'iterations', { workspace_id: workspace, limit: '200' }, signal)
+      return rows.map(row => ({ value: String(row.id ?? ''), label: String(row.name ?? row.id ?? '') }))
+        .filter(choice => choice.value)
+    }
+    const out: TapdChoice[] = []
+    for (const system of ['bug', 'story'] as const) {
+      const rows = await this.request('GET', 'workflows/status_map', { workspace_id: workspace, system }, signal)
+      for (const row of rows) for (const [code, name] of Object.entries(row)) {
+        if (/^[A-Za-z0-9_-]+$/.test(code) && name && !out.some(choice => choice.value === code))
+          out.push({ value: code, label: String(name) })
+      }
+    }
+    return out
+  }
+}
+
+/** The `TapdApi` of a configuration: TAPD's Open API only, with the Host-side credentials resolved per request. */
+export function tapdApi(config: TapdConfig): TapdApi {
+  return new TapdOpenApi({ api: config.api })
+}
diff --git a/src/sources/tapd-auth.ts b/src/sources/tapd-auth.ts
new file mode 100644
index 00000000000..6fbb7789095
--- /dev/null
+++ b/src/sources/tapd-auth.ts
@@ -0,0 +1,276 @@
+/**
+ * VsSaros addition: TAPD Open API credentials, aligned with SaroasisStudioSystem's `.env` contract.
+ *
+ * That platform (lib/tapd.js, .env.example) accepts three credential pairs in priority order and loads them
+ * from a local `.env`. The Host here reads the same variable names, so an existing `.env` can be pointed at
+ * with DSH_SUPERAGENT_TAPD_ENV_FILE instead of exporting secrets into the IDE process. Only whitelisted
+ * TAPD keys are taken from the file, it never overrides an existing environment value, and it is read lazily
+ * (not at module load) so a late-loaded credential is still picked up. The Executor never sees these values.
+ * VsSaros also ships an API account (BUNDLED_TAPD_CREDENTIALS) as the lowest-priority source, so a fresh install
+ * reads TAPD without setup; a file, the settings panel, or the Host environment still wins.
+ */
+import { randomBytes } from 'node:crypto'
+import { readFileSync, statSync } from 'node:fs'
+import { chmod, mkdir, readFile, rename, writeFile } from 'node:fs/promises'
+import { homedir } from 'node:os'
+import { dirname, join } from 'node:path'
+
+export type TapdEnv = Record<string, string | undefined>
+export interface TapdCredential { header: string; method: string }
+
+/** The only keys a credentials file may contribute; nothing else in an `.env` reaches the Host. */
+const KEYS = [
+  'DSH_SUPERAGENT_TAPD_BEARER', 'DSH_SUPERAGENT_TAPD_USER', 'DSH_SUPERAGENT_TAPD_PASSWORD',
+  'DSH_SUPERAGENT_TAPD_TIMEOUT_MS',
+  'TAPD_CLIENT_ID', 'TAPD_CLIENT_SECRET', 'TAPD_API_USER', 'TAPD_API_PWD', 'TAPD_API_TOKEN',
+  'TAPD_HTTP_TIMEOUT_MS', 'TAPD_WORKSPACE_ID', 'DSH_SUPERAGENT_TAPD_BUNDLED',
+] as const
+/** The key the panel writes to disable the shipped account; it is not a credential and is never replaced by a save. */
+const BUNDLED_KEY = 'DSH_SUPERAGENT_TAPD_BUNDLED'
+const LINE = /^\s*([A-Z0-9_]+)\s*=\s*(.*?)\s*$/i
+
+/**
+ * VsSaros addition: the TAPD Open API account shipped with the product, so an installed VsSaros can read TAPD
+ * without any per-machine setup. It is the *lowest*-priority source: a credentials file, the settings panel, or
+ * Host environment variables all override it. Set `DSH_SUPERAGENT_TAPD_BUNDLED=off` to turn it off entirely.
+ * The secret is only ever read by the Host (it is compiled into `lib/`, which is in the package's `files`).
+ */
+export const BUNDLED_TAPD_CREDENTIALS: TapdEnv = {
+  TAPD_CLIENT_ID: 'tapd-app-889817',
+  TAPD_CLIENT_SECRET: '6E9C1B81-5443-6CFC-0D84-27C8DAEDB6FB',
+}
+
+/** The shipped account, unless the Host environment or the credentials file disables it (no IDE restart needed for the file). */
+export function bundledTapdEnv(base: TapdEnv = process.env): TapdEnv {
+  const fromFile = readTapdEnvFile(tapdEnvFile(base), base)[BUNDLED_KEY]
+  const flag = (base[BUNDLED_KEY] || fromFile || '').trim().toLowerCase()
+  return flag === 'off' ? {} : BUNDLED_TAPD_CREDENTIALS
+}
+
+/** Explicit override, else `<DSH_HOME>/tapd.env`, else `~/.dsh/tapd.env`. */
+export function tapdEnvFile(env: TapdEnv = process.env): string {
+  const explicit = env.DSH_SUPERAGENT_TAPD_ENV_FILE?.trim()
+  if (explicit) return explicit
+  return join(env.DSH_HOME?.trim() || join(homedir(), '.dsh'), 'tapd.env')
+}
+
+let cached: { file: string; mtimeMs: number; values: TapdEnv } | undefined
+/** Test hook: forget the cached credentials file. */
+export function resetTapdEnvCache(): void { cached = undefined }
+
+/** Parses `KEY=VALUE` lines with quotes and `#` comments, keeping only whitelisted keys. */
+export function parseTapdEnv(text: string): TapdEnv {
+  const values: TapdEnv = {}
+  for (const line of text.split(/\r?\n/)) {
+    const match = LINE.exec(line)
+    if (!match) continue
+    const key = match[1]!.toUpperCase()
+    if (!(KEYS as readonly string[]).includes(key)) continue
+    let value = match[2] ?? ''
+    if ((value.startsWith('"') && value.endsWith('"')) || (value.startsWith("'") && value.endsWith("'")))
+      value = value.slice(1, -1)
+    values[key] = value
+  }
+  return values
+}
+
+/** Parses `KEY=VALUE` with quotes and `#` comments; skips unknown keys and existing environment values. */
+export function readTapdEnvFile(file: string, base: TapdEnv = process.env): TapdEnv {
+  let mtimeMs = 0
+  try { mtimeMs = statSync(file).mtimeMs } catch { return {} }
+  if (cached?.file === file && cached.mtimeMs === mtimeMs) return cached.values
+  let text = ''
+  try { text = readFileSync(file, 'utf8') } catch { return {} }
+  const values = Object.fromEntries(Object.entries(parseTapdEnv(text)).filter(([key]) => base[key] === undefined))
+  cached = { file, mtimeMs, values }
+  return values
+}
+
+/** The shipped account, then the local credentials file, then the Host environment (each overrides the last). */
+export function tapdEnvironment(base: TapdEnv = process.env): TapdEnv {
+  const file = tapdEnvFile(base)
+  return { ...bundledTapdEnv(base), ...readTapdEnvFile(file, base), ...base }
+}
+
+const basic = (user: string, password: string, method: string): TapdCredential =>
+  ({ header: `Basic ${Buffer.from(`${user}:${password}`).toString('base64')}`, method })
+
+/**
+ * Five accepted sources, highest priority first: the two native SuperAgent variables (an explicit choice for
+ * this Host), then the three used by SaroasisStudioSystem (client_id/secret is the recommended enterprise
+ * API account: full permissions, no token exchange and no IP allowlist).
+ */
+export function tapdCredential(env: TapdEnv): TapdCredential | undefined {
+  if (env.DSH_SUPERAGENT_TAPD_BEARER) return { header: `Bearer ${env.DSH_SUPERAGENT_TAPD_BEARER}`, method: 'Bearer DSH_SUPERAGENT_TAPD_BEARER' }
+  if (env.DSH_SUPERAGENT_TAPD_USER && env.DSH_SUPERAGENT_TAPD_PASSWORD)
+    return basic(env.DSH_SUPERAGENT_TAPD_USER, env.DSH_SUPERAGENT_TAPD_PASSWORD, 'Basic DSH_SUPERAGENT_TAPD_USER/PASSWORD')
+  if (env.TAPD_CLIENT_ID && env.TAPD_CLIENT_SECRET)
+    return basic(env.TAPD_CLIENT_ID, env.TAPD_CLIENT_SECRET, 'Basic TAPD_CLIENT_ID/SECRET (API account)')
+  if (env.TAPD_API_USER && env.TAPD_API_PWD)
+    return basic(env.TAPD_API_USER, env.TAPD_API_PWD, 'Basic TAPD_API_USER/PWD')
+  if (env.TAPD_API_TOKEN) return { header: `Bearer ${env.TAPD_API_TOKEN}`, method: 'Bearer TAPD_API_TOKEN' }
+  return undefined
+}
+
+/** Request timeout, with a 3s floor (a hung TAPD socket otherwise wedges every later poll). */
+export function tapdTimeoutMs(env: TapdEnv): number {
+  const raw = env.DSH_SUPERAGENT_TAPD_TIMEOUT_MS ?? env.TAPD_HTTP_TIMEOUT_MS
+  const parsed = Number.parseInt(String(raw ?? ''), 10)
+  return Math.max(3000, Number.isFinite(parsed) && parsed > 0 ? parsed : 30_000)
+}
+
+/** What to show when nothing is configured (only possible with the shipped account turned off). */
+export function tapdCredentialsHint(env: TapdEnv = process.env): string {
+  return 'No TAPD Open API credentials in the Host (the shipped account is off). Set one of: DSH_SUPERAGENT_TAPD_BEARER; '
+    + 'DSH_SUPERAGENT_TAPD_USER + DSH_SUPERAGENT_TAPD_PASSWORD; TAPD_CLIENT_ID + TAPD_CLIENT_SECRET (recommended); '
+    + 'TAPD_API_USER + TAPD_API_PWD; TAPD_API_TOKEN. Or put them as KEY=VALUE in ' + tapdEnvFile(env)
+    + ' (or point DSH_SUPERAGENT_TAPD_ENV_FILE at an existing .env). Remove DSH_SUPERAGENT_TAPD_BUNDLED=off to use the '
+    + 'account shipped with VsSaros. Credentials stay in the Host; Executors cannot read them.'
+}
+
+/*
+ * VsSaros addition: the TAPD credentials the settings panel edits. They are written to the Host's credentials file
+ * (never to the settings store, which the panel reads back), and the panel only ever sees a masked account name.
+ */
+export type TapdCredentialKind = 'client' | 'user' | 'token'
+/** The file keys of each kind the panel offers: an account name (none for a token) and its secret. */
+export const TAPD_CREDENTIAL_KEYS: Record<TapdCredentialKind, { id?: string; secret: string }> = {
+  client: { id: 'TAPD_CLIENT_ID', secret: 'TAPD_CLIENT_SECRET' },
+  user: { id: 'TAPD_API_USER', secret: 'TAPD_API_PWD' },
+  token: { secret: 'TAPD_API_TOKEN' },
+}
+/** Every credential key; saving replaces all of them so a stale, higher-priority one cannot win over the new one. */
+const CREDENTIAL_KEYS = ['DSH_SUPERAGENT_TAPD_BEARER', 'DSH_SUPERAGENT_TAPD_USER', 'DSH_SUPERAGENT_TAPD_PASSWORD',
+  'TAPD_CLIENT_ID', 'TAPD_CLIENT_SECRET', 'TAPD_API_USER', 'TAPD_API_PWD', 'TAPD_API_TOKEN']
+
+export interface TapdCredentialStatus {
+  /** Whether the Host has a credential at all, from either place. */
+  configured: boolean
+  /** Which credential the Host uses, e.g. `Basic TAPD_CLIENT_ID/SECRET (API account)`. */
+  method?: string
+  /** Where the credential in use comes from (all sources are merged key by key, then picked by priority). */
+  source: 'environment' | 'file' | 'bundled' | 'none'
+  /** The credentials file the panel writes. */
+  file: string
+  /** The kind of the credential in use (including the shipped account), and its account name masked. */
+  kind?: TapdCredentialKind
+  account?: string
+  /** Whether the credentials file holds a complete pair the panel saved. `kind` alone does not mean "blank keeps it". */
+  saved: boolean
+  /** Whether the product's shipped account is enabled; the panel can turn it off without restarting the IDE. */
+  bundled: boolean
+  /** The file holds a credential, but a higher-priority one in the Host environment is used instead. */
+  overridden: boolean
+}
+
+/** Everything the panel's TAPD setup checklist needs, in one read-only response. */
+export interface TapdSetupStatus {
+  credential: TapdCredentialStatus
+  watches: number
+  workspace: string
+  agent: string
+  /** The identity name after the member mapping is applied (TAPD compares owners as Chinese names). */
+  agentResolved: string
+  /** Whether `agent` was an alias that the mapping resolved. */
+  agentMapped: boolean
+  /** The Source's live health code, e.g. `tapdUnset` when no watch is set; null while it has not reported. */
+  healthCode: string | null
+}
+/** A credential the panel cannot save as given (missing, unknown kind, or a value that would break the file); answered with 400. */
+export class TapdCredentialError extends Error {}
+
+const mask = (value: string): string => value.length <= 6 ? '•'.repeat(value.length) : `${value.slice(0, 3)}…${value.slice(-2)}`
+function fileValues(file: string): TapdEnv {
+  try { return parseTapdEnv(readFileSync(file, 'utf8')) } catch { return {} }
+}
+function fileKind(values: TapdEnv): TapdCredentialKind | undefined {
+  return (Object.keys(TAPD_CREDENTIAL_KEYS) as TapdCredentialKind[]).find(kind => {
+    const keys = TAPD_CREDENTIAL_KEYS[kind]
+    return !!values[keys.secret] && (!keys.id || !!values[keys.id])
+  })
+}
+
+/** The credential status the panel shows; it never carries a secret. */
+export function tapdCredentialStatus(base: TapdEnv = process.env): TapdCredentialStatus {
+  const file = tapdEnvFile(base)
+  const values = fileValues(file)
+  const bundled = bundledTapdEnv(base)
+  const fromEnv = tapdCredential(base)
+  const fromFile = tapdCredential({ ...bundled, ...values })
+  // The Host merges all three key by key (the environment wins a key both set) and then picks by priority, so the
+  // credential in use may come from any of them; say which, rather than assuming the environment always wins.
+  const effective = tapdCredential({ ...bundled, ...values, ...base })
+  const fromEnvInUse = !!effective && !!fromEnv && effective.header === fromEnv.header
+  const fromFileInUse = !!effective && !fromEnvInUse && !!tapdCredential(values) && effective.header === fromFile?.header
+  const source = !effective ? 'none' : fromEnvInUse ? 'environment' : fromFileInUse ? 'file' : 'bundled'
+  const saved = !!tapdCredential(values)
+  // The shipped account is a client pair: name it in the status so the panel can show a masked account and the
+  // right credential kind without pretending a file was saved (`same` must stay false until the panel saves one).
+  const kind: TapdCredentialKind | undefined = fileKind(values) ?? (source === 'bundled' ? 'client' : undefined)
+  const id = kind && TAPD_CREDENTIAL_KEYS[kind].id
+  const account = source === 'bundled' && BUNDLED_TAPD_CREDENTIALS.TAPD_CLIENT_ID
+    ? mask(BUNDLED_TAPD_CREDENTIALS.TAPD_CLIENT_ID)
+    : id && values[id] ? mask(values[id]!) : undefined
+  return {
+    configured: !!effective, ...effective ? { method: effective.method } : {},
+    source, file, saved, bundled: Object.keys(bundled).length > 0,
+    ...kind ? { kind } : {}, ...account ? { account } : {},
+    overridden: fromEnvInUse && !!tapdCredential(values),
+  }
+}
+
+const SAFE = /^[^\r\n"'\0]{1,512}$/
+/**
+ * Writes one credential to the Host's credentials file, replacing every credential key there and keeping the other lines
+ * (timeouts, workspace, comments). An empty `id` or `secret` keeps the file's current value of the same kind, so the
+ * secret need not be typed again to change the account name; `clear` removes the credential keys only.
+ */
+export async function saveTapdCredential(input: { kind?: TapdCredentialKind; id?: string; secret?: string; clear?: boolean;
+  bundled?: 'on' | 'off' }, base: TapdEnv = process.env): Promise<TapdCredentialStatus> {
+  const file = tapdEnvFile(base)
+  let text = ''
+  try { text = await readFile(file, 'utf8') } catch { /* A missing file starts empty. */ }
+  const current = parseTapdEnv(text)
+  const kept = text.split(/\r?\n/).filter(line => {
+    const key = LINE.exec(line)?.[1]?.toUpperCase()
+    return !key || (!CREDENTIAL_KEYS.includes(key) && key !== BUNDLED_KEY)
+  })
+  while (kept.length && kept.at(-1) === '') kept.pop()
+  const lines = [...kept]
+  // A request that only flips the shipped-account switch must not demand a credential kind.
+  const onlySwitch = input.bundled !== undefined && !input.kind && !input.id && !input.secret && !input.clear
+  if (!input.clear && !onlySwitch) {
+    const kind = input.kind
+    if (!kind || !(kind in TAPD_CREDENTIAL_KEYS)) throw new TapdCredentialError('Choose a TAPD credential kind')
+    const keys = TAPD_CREDENTIAL_KEYS[kind]
+    const same = fileKind(current) === kind
+    const id = input.id?.trim() || (same && keys.id ? current[keys.id] ?? '' : '')
+    const secret = input.secret?.trim() || (same ? current[keys.secret] ?? '' : '')
+    if (keys.id && !id) throw new TapdCredentialError('Enter the TAPD account name')
+    if (!secret) throw new TapdCredentialError('Enter the TAPD secret')
+    for (const value of keys.id ? [id, secret] : [secret]) {
+      if (!SAFE.test(value)) throw new TapdCredentialError('A TAPD credential may not contain quotes or line breaks and is at most 512 characters')
+    }
+    if (!kept.some(line => line.includes('dsh-superagent'))) lines.unshift('# TAPD Open API credentials for dsh-superagent (written by its settings panel).')
+    if (keys.id) lines.push(`${keys.id}=${id}`)
+    lines.push(`${keys.secret}=${secret}`)
+  }
+  // Preserve the switch across ordinary saves, or apply the panel's request; an "on" is the absence of the line.
+  const bundledFlag = input.bundled ?? (String(current[BUNDLED_KEY] ?? '').trim().toLowerCase() === 'off' ? 'off' : 'on')
+  if (bundledFlag === 'off') lines.push(`${BUNDLED_KEY}=off`)
+  await mkdir(dirname(file), { recursive: true })
+  // Random suffix: two quick saves in the same millisecond must not share a temporary name.
+  const temporary = `${file}.${process.pid}.${Date.now().toString(36)}.${randomBytes(4).toString('hex')}.tmp`
+  await writeFile(temporary, lines.length ? `${lines.join('\n')}\n` : '', { encoding: 'utf8', mode: 0o600 })
+  // On Windows a rename over an existing file can briefly fail EPERM/EBUSY (scanner or another reader).
+  for (let attempt = 0; ; attempt++) {
+    try { await rename(temporary, file); break } catch (error) {
+      const code = (error as NodeJS.ErrnoException).code
+      if (attempt >= 2 || !['EPERM', 'EACCES', 'EBUSY'].includes(code ?? '')) throw error
+      await new Promise(resolve => setTimeout(resolve, 25 * (attempt + 1)))
+    }
+  }
+  await chmod(file, 0o600).catch(() => { /* Windows has no POSIX modes. */ })
+  resetTapdEnvCache()
+  return tapdCredentialStatus(base)
+}
