diff --git a/src/app/cli-check.ts b/src/app/cli-check.ts
new file mode 100644
index 00000000000..2bbb4f28af0
--- /dev/null
+++ b/src/app/cli-check.ts
@@ -0,0 +1,98 @@
+/**
+ * VsSaros addition: local diagnostics and maintenance for the Feishu Source's `lark-cli`.
+ *
+ * Reads go through the same `Probe` that setup uses, so PATH and the excluded worker shim directory
+ * are identical to the ones `resolveFeishuBot` sees. Write actions are separate and require an
+ * explicit `confirm` produced by the panel's confirmation dialog.
+ */
+import { executable, type Probe } from '../deployment.ts'
+import { workerBin } from '../infra/environment.ts'
+
+/** Read-only view of the local `lark-cli`; a missing command or a failed probe is reported, never thrown. */
+export interface CliCheckResult {
+  found: boolean
+  /** The value the panel should put in the `cli` field when the command is found. */
+  command: string
+  resolved?: string
+  version?: string
+  appId?: string
+  botReady?: boolean
+  botName?: string
+  strictMode?: string
+  update?: CliUpdateResult
+  /** One line per failed probe; a partial result is still useful. */
+  error?: string
+}
+/** Result of `lark-cli update --check --json`. */
+export interface CliUpdateResult {
+  currentVersion?: string
+  latestVersion?: string
+  action?: string
+  ok?: boolean
+  message?: string
+}
+export interface CliApplyResult { ok: boolean; output: string }
+
+export type CliApplyAction = 'strict-bot' | 'update'
+
+const COMMAND = 'lark-cli'
+const ENV = { LARKSUITE_CLI_NO_UPDATE_NOTIFIER: '1', LARKSUITE_CLI_NO_SKILLS_NOTIFIER: '1' }
+/** CLI output may carry a banner before the JSON object. */
+const json = (text: string): unknown => {
+  try { return JSON.parse(text.slice(text.indexOf('{'))) as unknown } catch { return undefined }
+}
+const string = (value: unknown): string | undefined => typeof value === 'string' ? value : undefined
+
+/** Probes the bot CLI for local checks and runs its two confirmed maintenance actions. */
+export class CliCheck {
+  constructor(private readonly probe: Probe, private readonly path: string, private readonly stateDir: string) {}
+
+  /**
+   * Locate the CLI, then read its version, bot identity, strict mode, bot name and (optionally) update status.
+   * VsSaros addition: `profile` (the Source's app) selects that app's lark-cli profile for the identity reads.
+   */
+  async check(withUpdate = false, profile = ''): Promise<CliCheckResult> {
+    let resolved: string
+    try { resolved = executable(COMMAND, this.path, workerBin(this.stateDir)) }
+    catch (error) { return { found: false, command: COMMAND, error: String(error) } }
+    const select = profile ? ['--profile', profile] : []
+    const run = (...argv: string[]): Promise<string> => this.probe([resolved, ...argv], ENV)
+    const result: CliCheckResult = { found: true, command: COMMAND, resolved }
+    const record = (error: unknown) => { result.error = [result.error, String(error)].filter(Boolean).join('; ') }
+    const attempt = async (read: () => Promise<void>) => { try { await read() } catch (error) { record(error) } }
+    await attempt(async () => {
+      const version = /(\d+\.\d+\.\d+)/.exec(await run('--version'))?.[1]
+      if (version) result.version = version
+    })
+    await attempt(async () => {
+      const status = json(await run(...select, 'auth', 'status')) as { appId?: string; identities?: { bot?: { status?: string } } } | undefined
+      result.appId = string(status?.appId)
+      result.botReady = status?.identities?.bot?.status === 'ready'
+    })
+    await attempt(async () => {
+      result.strictMode = /strict-mode:\s*(\w+)/.exec(await run(...select, 'config', 'strict-mode'))?.[1] ?? 'unknown'
+    })
+    await attempt(async () => {
+      const text = await run(...select, 'api', 'GET', '/open-apis/bot/v3/info', '--as', 'bot', '--format', 'ndjson')
+      const info = json(text.split('\n')[0] ?? '') as { bot?: { app_name?: string } } | undefined
+      result.botName = string(info?.bot?.app_name)
+    })
+    if (withUpdate) await attempt(async () => {
+      const update = json(await run('update', '--check', '--json')) as Record<string, unknown> | undefined
+      result.update = {
+        currentVersion: string(update?.current_version), latestVersion: string(update?.latest_version),
+        action: string(update?.action), ok: update?.ok === true, message: string(update?.message),
+      }
+    })
+    return result
+  }
+
+  /** Confirmed write: restrict the CLI to the bot identity, or let the CLI update itself. */
+  async apply(action: CliApplyAction, confirm: boolean, profile = ''): Promise<CliApplyResult> {
+    if (!confirm) throw new Error('Confirmation required before changing the local lark-cli')
+    const resolved = executable(COMMAND, this.path, workerBin(this.stateDir))
+    const argv = action === 'strict-bot' ? [...profile ? ['--profile', profile] : [], 'config', 'strict-mode', 'bot'] : ['update']
+    const output = await this.probe([resolved, ...argv], ENV)
+    return { ok: true, output: output.trim().slice(0, 4000) }
+  }
+}
diff --git a/src/app/coexist.ts b/src/app/coexist.ts
new file mode 100644
index 00000000000..7673f7358ce
--- /dev/null
+++ b/src/app/coexist.ts
@@ -0,0 +1,52 @@
+/**
+ * VsSaros addition (2026-11-06, P3 · co-install): what other Bot plugins share this Host, and what they do to every Session.
+ *
+ * DS Bot (`ds-bot`, the plugin VsSaros' Bots and SuperAgent's team steps adapt) may be installed in the same Host. Its tools,
+ * prompt section, approval answerer, compaction take-over and group relay act only on its own Sessions, so they do not meet
+ * SuperAgent's (checked against ds-bot 0.2.7). Three of its hooks act on every Session, SuperAgent's too:
+ *
+ * - `secrets`: a value the person saved in DS Bot is replaced in every tool result and every model request; a request it
+ *   rewrote is sent again as a new model call (SuperAgent's token meter counts that call once: `stepUsageStream`).
+ * - `images`: when a Session's model cannot read images, DS Bot reads them with its OCR model and sends the request again
+ *   with the text, so a step's images then go to that model.
+ * - `skills`: its skills `goal-grill`, `office` and `office-tools` are offered to every Session.
+ *
+ * Found through the cordis loader's entries (an entry named `ds-bot` that is not disabled). Nothing of DS Bot is changed: the
+ * panel says so, and the log says so once.
+ *
+ * VsSaros addition (2026-11-07, P0 · co-install semantics): the three are observable and the side effect can be turned off.
+ * - The usage ledger's listener runs first (`prepend`), so a request DS Bot sends again passes through it again: each such
+ *   call is recorded once, marked `resent` (same model) or `side` (its OCR model), counted on `GET usage` (`day.relays`) and a
+ *   ticket's page (`relays`). `executor.sideCalls` off refuses side calls in SuperAgent's Sessions (DS Bot then tells the
+ *   model the image could not be read); the secrets rewrite, which only hides values, is never refused.
+ * - Team steps' approvals are decided by `step-approvals.ts` (step_approval_rule, else a person), whichever way the model's
+ *   request was sent; DS Bot's approval answerer hands on every Session not its own.
+ * - Its skills reach DSH's skill catalog message (`dsh-tool-skill`), not SuperAgent's prompt sections or its prompt budget, and
+ *   never the desk, whose every tool is masked.
+ * `tests/dsb-coexist.spec.ts` guards all four with a fake DS Bot made the way ds-bot 0.2.7 does it.
+ */
+export const DS_BOT_ENTRY = 'ds-bot'
+export type CoexistEffect = 'secrets' | 'images' | 'skills'
+export interface Coexistence {
+  /** DS Bot runs in this Host, and what it does to SuperAgent's Sessions. */
+  dsBot?: { effects: CoexistEffect[] }
+}
+export const DS_BOT_EFFECTS: readonly CoexistEffect[] = ['secrets', 'images', 'skills']
+
+interface LoaderLike { entries?(): Iterable<{ options?: { name?: unknown; disabled?: unknown }; disabled?: unknown }> }
+
+/**
+ * Reads the Host's loader for other Bot plugins. A Host without a loader (tests, an embedded runtime) has none.
+ * @param loader - the cordis `loader` service, or what `ctx.get('loader')` gave.
+ */
+export function coexistenceOf(loader: unknown): Coexistence {
+  const entries = (loader as LoaderLike | undefined)?.entries
+  if (typeof entries !== 'function') return {}
+  try {
+    for (const entry of entries.call(loader)) {
+      const disabled = entry.disabled === true || entry.options?.disabled === true
+      if (entry.options?.name === DS_BOT_ENTRY && !disabled) return { dsBot: { effects: [...DS_BOT_EFFECTS] } }
+    }
+  } catch { /* a loader that cannot be read says nothing */ }
+  return {}
+}
