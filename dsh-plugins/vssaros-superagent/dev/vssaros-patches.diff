+/** Inks (light) for characters; gradients paint from the top left to the bottom right. */
+const INKS: Record<string, string> = {
+  deepseek: '#4D6BFE', black: '#000000', brown: '#9A6B44', red: '#FF3E51', orange: '#FF6B1A', yellow: '#FFB020', green: '#10B981',
+  cyan: '#06B6D4', blue: '#2563EB', violet: '#8B5CF6', magenta: '#F43F85', gray: '#8A8F98', aurora: '#00B8D4',
+}
+const GRADIENTS: Record<string, [number, string][]> = { aurora: [[0, '#A4FFB0'], [0.42, '#00F0E4'], [1, '#2E9EF7']] }
+/** A Bot with no choice gets one of the friendliest seven; the whale stays the supervisor's. */
+const DEFAULT_SHAPES = ['star', 'moon', 'gumdrop', 'peanut', 'bunny', 'kitty', 'acorn']
+const DEFAULT_COLORS = ['red', 'orange', 'yellow', 'green', 'cyan', 'blue', 'violet', 'magenta']
+export const FALLBACK_SHAPE = 'gumdrop'
+/** The supervisor's own look: DS Bot's Main Bot whale. */
+export const SUPERVISOR_LOOK: Look = Object.freeze({ shape: 'whale', color: 'deepseek' })
+export interface Look { shape: string; color: string }
+
+/** FNV-1a, as DS Bot hashes a Bot id. */
+export function fnv1a(text: string): number {
+  let value = 2166136261
+  for (let index = 0; index < text.length; index += 1) value = Math.imul(value ^ text.charCodeAt(index), 16777619)
+  return value >>> 0
+}
+function defaultColor(id: string): string {
+  const t = (fnv1a(id) + 1831565813) | 0
+  let n = Math.imul(t ^ (t >>> 15), 1 | t)
+  n = (n + Math.imul(n ^ (n >>> 7), 61 | n)) ^ n
+  return DEFAULT_COLORS[Math.floor((((n ^ (n >>> 14)) >>> 0) / 4294967296) * DEFAULT_COLORS.length)]!
+}
+function defaultShape(id: string): string {
+  let value = fnv1a(id) | 0
+  value = Math.imul(value ^ (value >>> 16), 73244475)
+  value = Math.imul(value ^ (value >>> 13), 3266489909)
+  return DEFAULT_SHAPES[((value ^ (value >>> 16)) >>> 0) % DEFAULT_SHAPES.length]!
+}
+/** A Bot's look from its id: the same shape and color everywhere it shows. */
+export const lookOf = (id: string): Look => ({ shape: defaultShape(id), color: defaultColor(id) })
+export const hasShape = (id: string): boolean => Object.hasOwn(CHARACTERS, id)
+const shapeOf = (id: string): Character => CHARACTERS[hasShape(id) ? id : FALLBACK_SHAPE]!
+
+const eyeMarkup = ([cx, cy, w, h, tilt]: Character['eyes'][number]) =>
+  `<g transform="translate(${cx} ${cy}) rotate(${tilt})"><rect class="dt-bm-eye" x="${-w / 2}" y="${-h / 2}" width="${w}" height="${h}" rx="${w / 2}"/></g>`
+/** Each mark's own mask id stands in for this: a duplicate id resolves to its first copy, which stops painting once it unmounts. */
+export const MASK_ID = '%MASK%'
+const cache = new Map<string, string>()
+/** The SVG inside a 100-unit view box for a shape in a color, with `MASK_ID` for the mark to replace. */
+export function characterMarkup(shape: string, color: string): string {
+  const key = `${shape}|${color}`
+  const known = cache.get(key)
+  if (known !== undefined) return known
+  const def = shapeOf(shape)
+  // The eyes sit in the mask, so CSS blinks and glances move them without moving where they sit.
+  const eyes = `<g class="dt-bm-eyes" fill="#000">${def.eyes.map(eyeMarkup).join('')}</g>`
+  const stops = GRADIENTS[color]
+  const gradient = stops ? `<linearGradient id="${MASK_ID}g" gradientUnits="userSpaceOnUse" x1="18" y1="10" x2="78" y2="92">${stops.map(([offset, value]) => `<stop offset="${offset}" stop-color="${value}"/>`).join('')}</linearGradient>` : ''
+  const paint = stops ? `url(#${MASK_ID}g)` : INKS[color] ?? INKS.gray!
+  const layers = [...(def.paints ?? []).map(([d, fill, opacity]) => `<path d="${d}" fill="${fill}" fill-opacity="${opacity}"/>`),
+    `<path d="${def.shade}" fill="#000" fill-opacity=".07"/>`].join('')
+  const body = `<g mask="url(#${MASK_ID})"><g fill-rule="evenodd"><path d="${def.body}" fill="${paint}"/>${layers}</g></g>`
+  // The mask covers three boxes, so a bob or squash never clips the body at the edge.
+  const markup = `<defs>${gradient}<mask id="${MASK_ID}" maskUnits="userSpaceOnUse" x="-100" y="-100" width="300" height="300"><rect x="-100" y="-100" width="300" height="300" fill="#fff"/>${eyes}</mask></defs><g class="dt-bm-b">${body}</g>`
+  cache.set(key, markup)
+  return markup
+}
