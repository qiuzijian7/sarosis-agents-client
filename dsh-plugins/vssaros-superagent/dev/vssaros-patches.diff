--- /dev/null
+++ b/src/app/desk.ts
@@ -0,0 +1,308 @@
+/**
+ * VsSaros addition: the supervisor desk, a DSH Session where a person talks to SuperAgent directly. The desk does no work
+ * itself: its one tool hands the person's latest message, word for word, to the `superagent` Source, so the request goes
+ * through the same gate, Eval and tickets as one from Feishu, GitHub or TAPD. Replies come back into the desk.
+ */
+import { randomUUID } from 'node:crypto'
+import { z } from 'zod'
+import { key, latestAssignment, type ChannelRef, type OutboundMessage, type ReceiveResult, type Ticket, type TicketOutcome, type Trigger } from '../core/index.ts'
+import { deskTrigger, SUPERAGENT_SOURCE, type SuperagentAddress } from '../sources/superagent.ts'
+// Type only: tools/tool.ts reaches the executor through resources.ts, which would make the Sessions import a cycle.
+import type { Tool } from './tools/tool.ts'
+
+/** The desk's Session ID for a state directory (stable, as the main Session's is). */
+/**
+ * The desk Session's id, one per state directory. VsSaros change: a desk opened in a workbench belongs to that workbench for
+ * good, and the built-in workbench (`vssaros:superagent`) is not the incubating one (`local:dsh-superagent`), so the
+ * built-in's desk is a Session of its own.
+ */
+export const deskSessionId = (stateDir: string): string => `desk-${key('superagent-desk:vssaros', stateDir)}`
+
+/** The desk's whole system prompt: it hands messages over, relays the supervisor's news, and never does the work itself. */
+export const DESK_PROMPT = [
+  'You are the desk of SuperAgent, the supervisor of the VsSaros Bots on this machine. You never do the work yourself.',
+  'Every message the person types here reaches the supervisor by itself as it arrives. When the person sends a request, a question for the',
+  'supervisor, or an answer to the supervisor (such as agreeing to a proposal), call superagent_submit once, then tell them in one short',
+  'sentence that the supervisor has it.',
+  'Messages that start with [SuperAgent] are the supervisor\'s news for the person: never submit them. Tell the person what it says in a',
+  'few short lines in their language, keeping every name, number, code and step. Only news that needs the person comes here (progress',
+  'is shown in the SuperAgent workbench). For a team proposal, list its members and steps, then say they can reply 同意 to start, write',
+  'changes for a new version, or reply 取消. For a step\'s request (【需要你批准 #code】), say which Bot wants to run what, and that they',
+  'can reply 同意 #code, 同意并记住 #code or 拒绝 #code. The buttons above this conversation do the same. For a question from the',
+  'supervisor, ask it as it is. A ticket\'s end (【工单结束】) is shown by SuperAgent itself; if one comes with the person\'s message, say',
+  'in one line how it ended, then answer the person.',
+].join(' ')
+
+/** What the desk's tool needs: the Runtime's intake of a Trigger, and (for a ticket's end) its tickets. */
+export interface DeskHost { receive(trigger: Trigger): ReceiveResult | Promise<ReceiveResult>; ticket?(id: string): Ticket | undefined }
+/** The part of a Session event the desk reads; DSH records each person's message as `user/message` from source `user`. */
+type DeskEvent = { type: string; data?: unknown }
+
+/** The person's latest message in a Session's events, or undefined when there is none. */
+export function latestPersonMessage(events: readonly DeskEvent[]): { id: string; text: string } | undefined {
+  for (let index = events.length - 1; index >= 0; index -= 1) {
+    const event = events[index]!
+    if (event.type !== 'user/message') continue
+    const message = event.data as { id?: unknown; source?: { kind?: unknown }; content?: readonly { type?: unknown; text?: unknown }[] } | undefined
+    if (message?.source?.kind !== 'user' || typeof message.id !== 'string') continue
+    const text = (message.content ?? []).flatMap(block => block.type === 'text' && typeof block.text === 'string' ? [block.text] : []).join('\n').trim()
+    if (text) return { id: message.id, text }
+  }
+  return undefined
+}
+
+/** The desk's tool: it takes no text, so the model cannot reword what the person asked. */
+export function deskTools(host: DeskHost, agent: { id: string; session: { snapshotEvents(): readonly DeskEvent[] } }): Tool[] {
+  const schema = z.object({}).strict()
+  const submit: Tool<typeof schema> = {
+    name: 'superagent_submit',
+    description: 'Hand the person\'s latest message to the SuperAgent supervisor, word for word. Takes no arguments; call it once per message.',
+    schema,
+    execute: async () => {
+      const latest = latestPersonMessage(agent.session.snapshotEvents())
+      if (!latest) return { submitted: false, note: 'No message from the person to hand over.' }
+      const trigger = deskTrigger({ session: agent.id, messageId: latest.id, text: latest.text, at: new Date().toISOString() })
+      const result = await host.receive(trigger)
+      // `trigger` names the message for the card that shows, in the desk's conversation, where it stands.
+      return { submitted: result === 'stored', result, trigger: trigger.id,
+        note: result === 'duplicate' ? 'The supervisor has this message already (it was handed over as it arrived); tell the person in one short sentence.'
+          : result === 'filtered' ? 'The supervisor desk is switched off in the superagent Source; tell the person.'
+          : 'The supervisor has it; its answer comes into this conversation.' }
+    },
+  }
+  const tools = [submit as unknown as Tool]
+  const lookup = host.ticket
+  if (lookup) {
+    const receiptSchema = z.object({ ticket: z.string().min(1) }).strict()
+    const receipt: Tool<typeof receiptSchema> = {
+      name: RECEIPT_TOOL,
+      description: 'Shows how a ticket ended, as a card. SuperAgent calls it by itself for its 【工单结束】 notices; do not call it.',
+      schema: receiptSchema,
+      execute: async ({ ticket: id }) => {
+        const ticket = lookup(id)
+        return (ticket && receiptView(ticket)) ?? { found: false, ticket: id, note: 'No ended ticket with this id.' }
+      },
+    }
+    tools.push(receipt as unknown as Tool)
+  }
+  return tools
+}
+
+/** What delivering a reply needs: the Sessions' once-per-request delivery. */
+export interface ReplyHost { prompt(sessionId: string, requestId: string, text: string, mode: 'queue' | 'steer' | { inject: string }): Promise<void> }
+
+/** The request id a supervisor's message is delivered under, once per message. */
+export const deskRequestId = (messageId: string): string => `superagent-reply:${messageId}`
+
+/**
+ * Writes a reply into the Session it belongs to: queued into the desk as a message of its own, which wakes the desk to tell
+ * the person, or steered into the asking Bot's Session as `agent_message` would. A Session that no longer exists can never
+ * receive it.
+ *
+ * VsSaros fix (2026-11-05): the desk's replies were injected (`agent.inject`), which DSH keeps in the idle desk's next-step
+ * inbox without writing it into the conversation or waking the desk: the person never saw the team proposal they had to
+ * agree to, and the inbox was dropped when the Session closed. A queued message is written into the Session's log, shows in
+ * DSH's chat, and wakes the desk, as DeepSeek-Bot delivers one Bot's reply to another (`followup`, its host/delivery.js).
+ * The Runtime delivers to the desk only through its outbox (desk-outbox.ts), and only what needs the person's answer.
+ */
+export async function deliverReply(host: ReplyHost, address: SuperagentAddress, message: OutboundMessage): Promise<'sent' | 'gone'> {
+  const text = address.kind === 'desk' ? `[SuperAgent] ${message.text}`
+    : `[SuperAgent 主管回复]\n${message.text}\n\n要继续找主管，用 agent_message 发给 SuperAgent。`
+  try {
+    await host.prompt(address.session, deskRequestId(message.id), text, address.kind === 'desk' ? 'queue' : 'steer')
+    return 'sent'
+  } catch (error) {
+    if ((error as { code?: unknown } | undefined)?.code === 'session/not-found') return 'gone'
+    throw error
+  }
+}
+
+/*
+ * VsSaros addition (2026-11-06): a ticket's end in the desk's conversation.
+ *
+ * Before, a desk ticket's end showed only on the card of the turn that handed the message over (its key-node card), which DSH
+ * folds into "已完成，用时 …" as soon as the person writes again; the main Session heard of the end, but nothing reached the
+ * desk unless its model chose to send a result. Now, as DeepSeek-Bot sends a Bot's answer back to whoever asked it
+ * (host/turns.js `finish`), the Runtime tells the desk itself: a `ticket-ended:` notice through the desk outbox (once, kept
+ * until the desk has it). The desk answers it with no model turn: `deskReceiptStream` makes that turn a call of
+ * `superagent_ticket_result`, drawn as the ticket's end card, then one line that stays visible when the turn folds.
+ */
+
+/** The notice id prefix of a ticket's end in the desk. */
+export const TICKET_ENDED_NOTICE = 'ticket-ended'
+/** The desk's tool that shows how a ticket ended (called by `deskReceiptStream`, not by the model). */
+export const RECEIPT_TOOL = 'superagent_ticket_result'
+/** Tool-call ids of the turns `deskReceiptStream` makes, so it knows its own results. */
+export const RECEIPT_CALL_PREFIX = 'toolu_superagent_receipt_'
+const OUTCOME_TEXT: Record<TicketOutcome, string> = {
+  completed: '已完成', merged: 'PR 已合并', closed: 'PR 已关闭（未合并）', dropped: '无需处理', stopped: '已停止',
+}
+const SUMMARY_CHARS = 600
+const clip = (text: string, max: number) => text.length > max ? `${text.slice(0, max - 1)}…` : text
+
+/** How a ticket ended, as its end card and the desk's line read it. */
+export interface ReceiptView { receipt: true; ticket: string; trigger: string; title: string; outcome: TicketOutcome; outcomeText: string; summary: string; at: string }
+/** The ended ticket's view: its title, outcome and report summary (else the reason it ended); undefined while it is open. */
+export function receiptView(ticket: Ticket): ReceiptView | undefined {
+  const ended = ticket.ended
+  if (!ended) return undefined
+  const summary = (latestAssignment(ticket)?.report?.summary ?? '').trim() || (ended.reason ?? '').trim()
+  return { receipt: true, ticket: ticket.id, trigger: ticket.origin.triggerId, title: ticket.title, outcome: ended.outcome,
+    outcomeText: OUTCOME_TEXT[ended.outcome] ?? ended.outcome, summary: clip(summary, SUMMARY_CHARS), at: ended.at }
+}
+
+/**
+ * The desk's notice of a ticket's end, for a ticket begun in the desk; undefined for any other ticket, or an open one.
+ * Its id names the end (`at`), so a ticket resumed and ended again tells the desk again.
+ */
+export function ticketEndedNotice(ticket: Ticket, origin: ChannelRef | undefined): OutboundMessage | undefined {
+  const view = receiptView(ticket)
+  const address = origin?.address as { kind?: unknown } | undefined
+  if (!view || origin?.source !== SUPERAGENT_SOURCE || address?.kind !== 'desk') return undefined
+  return { id: `${TICKET_ENDED_NOTICE}:${ticket.id}:${view.at}`, channel: origin, kind: 'notice', ticketId: ticket.id,
+    text: `【工单结束】「${view.title}」${view.outcomeText}${view.summary ? `：${view.summary}` : '。'}` }
+}
+
+/** The desk's line for ended tickets: it stays in the conversation when DSH folds the turn's card away. */
+export function receiptText(views: readonly (ReceiptView | undefined)[]): string {
+  const lines = views.map(view => view
+    ? `**工单已结束 · ${view.outcomeText}**　「${view.title}」${view.summary ? `\n\n${view.summary}` : ''}`
+    : '这张工单的结束情况没读到，可以到 SuperAgent 工作台的「工作」页查看。')
+  return lines.join('\n\n')
+}
+
+/** The part of a model request the desk's stream reads. */
+interface StreamMessage { id?: unknown; role?: unknown; source?: { kind?: unknown }; toolCallId?: unknown; content?: unknown; isError?: unknown }
+interface StreamOptions { sessionId?: unknown; purpose?: unknown; messages?: readonly StreamMessage[]; tools?: readonly { name?: unknown }[] }
+/** What the desk's stream needs: the desk's id, and which ticket's end a delivered message tells (desk outbox). */
+export interface DeskStreamHost {
+  deskId: string
+  ticketEndedOf(messageId: string): string | undefined
+  /**
+   * VsSaros addition (2026-11-07): resolves once the person's message (by its DSH message id) was handed over as it arrived
+   * (or after a bounded wait), so the turn's own `superagent_submit` finds it handed over and never races the group paths.
+   * Without it, a turn of the person's messages goes to the desk's model as before.
+   */
+  handedOver?(messageId: string): Promise<void>
+  /** The desk's one line for a `superagent_submit` result: where the message went. */
+  submitLine?(result: SubmitResult): Promise<string>
+}
+/** What `superagent_submit` returns, as the desk's line reads it. */
+export interface SubmitResult { submitted?: boolean; result?: string; trigger?: string }
+/** Tool-call ids of the `superagent_submit` calls `deskReceiptStream` makes, so it knows its own results. */
+export const SUBMIT_CALL_PREFIX = 'toolu_superagent_submit_'
+const SUBMIT_TOOL = 'superagent_submit'
+
+/** Where a desk message went, as the desk's line reads it. */
+export interface SubmitView { result?: string; route?: { roomName: string; kind: 'created' | 'routed' | 'updated' }; filtered?: boolean; tickets?: readonly string[] }
+/** The desk's line for a message it handed over (no model): the flow card above it shows the rest. */
+export function submitText(view: SubmitView | undefined): string {
+  if (!view?.result) return '这条消息没能交给主管，可以再发一次。'
+  if (view.result === 'filtered' || view.filtered) return '这条消息没交给主管：主管台在 superagent 来源里没有放行，可以到 SuperAgent 设置里查看。'
+  if (view.route) {
+    const name = `「${view.route.roomName}」`
+    return view.route.kind === 'created' ? `已建群${name}，群里的 Bots 接着做。` : view.route.kind === 'updated' ? `已更新群${name}。` : `已转给群${name}。`
+  }
+  if (view.tickets?.length) return `已转给正在做的工单${view.tickets.map(title => `「${title}」`).join('、')}。`
+  return '已收到，正在按普通流程安排；有进展会在这里告诉你。'
+}
+
+const textOf = (message: StreamMessage): string => {
+  const content = message.content
+  if (typeof content === 'string') return content
+  return Array.isArray(content) ? content.flatMap(block => block?.type === 'text' && typeof block.text === 'string' ? [block.text] : []).join('') : ''
+}
+const parseView = (message: StreamMessage): ReceiptView | undefined => {
+  if (message.isError === true) return undefined
+  try {
+    const value = JSON.parse(textOf(message).trim()) as Partial<ReceiptView>
+    return value?.receipt === true && typeof value.title === 'string' ? value as ReceiptView : undefined
+  } catch { return undefined }
+}
+
+/**
+ * `llm/stream` for the desk: when everything new in the desk since its last step is SuperAgent's 【工单结束】 notices, the turn
+ * calls `superagent_ticket_result` for each (no model), and after their results says how they ended. Any other turn, such as
+ * one with the person's message or another notice, goes to the desk's model as before.
+ */
+export function deskReceiptStream(host: DeskStreamHost, uuid: () => string = randomUUID) {
+  return (options: StreamOptions | undefined, next: () => unknown): unknown => {
+    if (!options || options.sessionId !== host.deskId || options.purpose !== undefined) return next()
+    const messages = options.messages ?? []
+    let last = -1
+    for (let index = messages.length - 1; index >= 0; index -= 1) {
+      if (messages[index]?.role === 'assistant' || messages[index]?.role === 'tool') { last = index; break }
+    }
+    const fresh = messages.slice(last + 1).filter(message => message?.role === 'user'
+      && (message.source?.kind === 'user' || message.source?.kind === 'dsh-superagent'))
+    if (last >= 0 && messages[last]?.role === 'tool') {
+      // The results of this turn's receipt calls: say how the tickets ended.
+      let start = last
+      while (start > 0 && messages[start - 1]?.role === 'tool') start -= 1
+      const results = messages.slice(start, last + 1)
+      const callOf = (prefix: string) => results.every(message => typeof message.toolCallId === 'string' && message.toolCallId.startsWith(prefix))
+      if (fresh.length) return next()
+      if (callOf(SUBMIT_CALL_PREFIX) && host.submitLine) {
+        const line = host.submitLine
+        const parsed = (() => { try { return JSON.parse(textOf(results.at(-1)!).trim()) as SubmitResult } catch { return {} } })()
+        return (async function* submitted() { yield* say(await line(results.at(-1)!.isError === true ? {} : parsed)) })()
+      }
+      if (!callOf(RECEIPT_CALL_PREFIX)) return next()
+      return say(receiptText(results.map(parseView)))
+    }
+    // VsSaros addition (2026-11-07): a turn of nothing but the person's own messages hands them over with no model (each was
+    // handed over as it arrived already; the call keeps the flow card), then says where it went. 6.8万 tokens a message before.
+    if (fresh.length && fresh.every(message => message.source?.kind === 'user')) {
+      const latest = fresh.at(-1)!
+      if (!host.handedOver || typeof latest.id !== 'string' || !(options.tools ?? []).some(tool => tool?.name === SUBMIT_TOOL)) return next()
+      const handedOver = host.handedOver, messageId = latest.id
+      const id = `${SUBMIT_CALL_PREFIX}${uuid().replace(/-/g, '')}`
+      return (async function* submitCall() {
+        await handedOver(messageId)
+        yield { type: 'block-start', index: 0, blockType: 'tool-call' }
+        yield { type: 'tool-call-delta', index: 0, id, name: SUBMIT_TOOL, argumentsDelta: '{}' }
+        yield { type: 'block-end', index: 0, block: { type: 'tool-call', id, name: SUBMIT_TOOL, arguments: '{}' } }
+        yield { type: 'finish', reason: { kind: 'tool-calls' } }
+      })()
+    }
+    if (!fresh.length || fresh.some(message => message.source?.kind === 'user')) return next()
+    const tickets = fresh.map(message => typeof message.id === 'string' ? host.ticketEndedOf(message.id) : undefined)
+    if (tickets.some(ticket => !ticket)) return next()
+    if (!(options.tools ?? []).some(tool => tool?.name === RECEIPT_TOOL)) return next()
+    const calls = [...new Set(tickets as string[])].map(ticket => ({ id: `${RECEIPT_CALL_PREFIX}${uuid().replace(/-/g, '')}`,
+      arguments: JSON.stringify({ ticket }) }))
+    return (async function* receiptCalls() {
+      for (const [index, call] of calls.entries()) {
+        yield { type: 'block-start', index, blockType: 'tool-call' }
+        yield { type: 'tool-call-delta', index, id: call.id, name: RECEIPT_TOOL, argumentsDelta: call.arguments }
+        yield { type: 'block-end', index, block: { type: 'tool-call', id: call.id, name: RECEIPT_TOOL, arguments: call.arguments } }
+      }
+      yield { type: 'finish', reason: { kind: 'tool-calls' } }
+    })()
+  }
+}
+
+/**
+ * VsSaros fix (2026-11-07, real machine, found by `dev/scripts/e2e-dsb-coexist.mjs`): the desk masks every tool, `skill` too,
+ * but its first step ran before the mask, so DSH's `dsh-tool-skill` put the profile's whole skill catalog into its history
+ * (173 skills, 72 KB, DS Bot's among them) and every later desk call carried it. The desk uses no skill: this `llm/stream`
+ * listener drops skill catalog messages from every request of the desk, the one already in its history too.
+ */
+export function deskWithoutCatalog(deskId: string) {
+  const catalog = (message: unknown) => (message as { source?: { kind?: unknown } } | undefined)?.source?.kind === 'skill-catalog'
+  return (options: { sessionId?: unknown; messages?: readonly unknown[] } | undefined, next: () => unknown): unknown => {
+    if (options?.sessionId === deskId && Array.isArray(options.messages) && options.messages.some(catalog)) {
+      try { (options as { messages: unknown[] }).messages = options.messages.filter(message => !catalog(message)) } catch { /* frozen: sent as it is */ }
+    }
+    return next()
+  }
+}
+
+function say(text: string): AsyncGenerator<Record<string, unknown>> {
+  return (async function* line() {
+    yield { type: 'block-start', index: 0, blockType: 'text' }
+    yield { type: 'text-delta', index: 0, text }
+    yield { type: 'block-end', index: 0, block: { type: 'text', text } }
+    yield { type: 'finish', reason: { kind: 'stop' } }
+  })()
+}
diff --git a/src/app/distill.ts b/src/app/distill.ts
new file mode 100644
index 00000000000..c3313a3cffb
--- /dev/null
+++ b/src/app/distill.ts
@@ -0,0 +1,149 @@
+/**
+ * VsSaros addition (superagent v2, P4): hands each finished team step's evidence to the VsSaros memory system, which
+ * distills it (`@vssaros/dsh-agents` lib/stepMemory.js; 2026-11-06: with a model, a similar skill becoming a new version,
+ * its risk graded — lib/core/skillDistill.js). superagent only sends evidence: it writes no skill itself. superagent decides only how deep: a step that took at least
+ * `SKILL_TURNS` turns, failed once or was given again is `skill` (a fact and a skill draft owned by its Bot, which a person
+ * approves); any other is `facts` (one line in its Bot's memory, no model call, no skill). Each handover is recorded in
+ * `team_distill` and retried until the memory system takes it, so a Host that starts the Bots later loses nothing.
+ */
+import type { Store } from './store.ts'
+import { stepSessionId, type TeamStep } from './steps.ts'
+
+export const SKILL_TURNS = 3
+const RETRY_MS = 60_000, ATTEMPTS = 5
+export const MEMORY_BUS_KEY = Symbol.for('vssaros.memory')
+
+export interface StepEvidence {
+  requestId: string; botId: string; botName: string; ticketId: string; ticketTitle: string; stepKey: string; stepTitle: string
+  spec: string; outcome: 'ready' | 'failed'; mode: 'skill' | 'facts'; turns: number; attempts: number; failures: string[]
+  report: string; request?: string; at: string
+  /** VsSaros addition (2026-11-06): the step's Session, whose model the memory system distills the skill with. */
+  sessionId?: string
+}
+/**
+ * VsSaros change (2026-11-06, v2 §7): the memory system distills a skill with a model, makes a similar one a new version
+ * of it (`updates`), and grades its risk; `distilled: false` (with `distillError`) when no model could, and the draft is
+ * the evidence put together by template.
+ */
+export interface RememberResult {
+  fact: { ok: boolean; message: string; duplicate?: boolean }
+  skill?: { name: string; path: string; created: boolean; state: 'draft' | 'active' | 'rejected'
+    version?: number; risk?: 'low' | 'medium' | 'high'; riskReasons?: string[]; distilled?: boolean; updates?: 'active' | 'draft'
+    model?: string; distillError?: string }
+}
+/** The memory bus of `@vssaros/dsh-agents` (lib/memoryBus.js), when that plugin runs in this process. */
+export interface MemoryBus {
+  version: number
+  available(): boolean
+  rememberStep(evidence: StepEvidence): Promise<RememberResult>
+  decideSkillDraft(name: string, decision: 'approve' | 'reject'): Promise<{ name: string; state: string }>
+}
+export const sharedMemoryBus = (): MemoryBus | undefined => {
+  const bus = (globalThis as unknown as Record<symbol, MemoryBus | undefined>)[MEMORY_BUS_KEY]
+  return bus && bus.version >= 1 ? bus : undefined
+}
+
+export interface Distill {
+  id: string; ticketId: string; stepKey: string; botId: string; botName: string; stepTitle: string
+  mode: 'skill' | 'facts'; reasons: string[]
+  state: 'pending' | 'sent' | 'failed'; attempts: number; error?: string
+  result?: RememberResult; evidence: StepEvidence; at: string; sentAt?: string
+}
+
+/** How deep a step's evidence is distilled, and why (the thresholds the person set: ≥3 turns, a failure, or a retry). */
+export function distillMode(step: Pick<TeamStep, 'turns' | 'failures' | 'attempts'>): { mode: 'skill' | 'facts'; reasons: string[] } {
+  const reasons = [...step.turns >= SKILL_TURNS ? [`${step.turns} turns`] : [], ...step.failures.length ? [`${step.failures.length} failed attempt(s)`] : [],
+    ...step.attempts > 1 ? [`given ${step.attempts} times`] : []]
+  return { mode: reasons.length ? 'skill' : 'facts', reasons }
+}
+
+export interface DistillerHost {
+  store: Pick<Store, 'db' | 'tickets' | 'triggers'>
+  bus?: () => MemoryBus | undefined
+  warn(message: string): void
+}
+
+/** Records and delivers team step evidence to the memory system, and relays a person's decision on a skill draft. */
+export class Distiller {
+  private delivering = false
+  constructor(private readonly host: DistillerHost) {
+    host.store.db.exec('CREATE TABLE IF NOT EXISTS team_distill (id TEXT PRIMARY KEY, ticket TEXT NOT NULL, state TEXT NOT NULL, value TEXT NOT NULL, at TEXT NOT NULL)')
+  }
+  private bus(): MemoryBus | undefined { return (this.host.bus ?? sharedMemoryBus)() }
+
+  /** A step ended ready or failed for good: record its evidence once, and deliver it. Stopped and skipped steps leave none. */
+  async stepEnded(step: TeamStep): Promise<Distill | undefined> {
+    if (step.state !== 'ready' && step.state !== 'failed') return undefined
+    const id = `distill:${step.ticketId}:${step.key}`
+    if (this.get(id)) return this.get(id)
+    const ticket = this.host.store.tickets.get(step.ticketId)
+    const request = ticket ? this.host.store.triggers.get(ticket.origin.triggerId)?.text : undefined
+    const { mode, reasons } = distillMode(step)
+    const at = new Date().toISOString()
+    const evidence: StepEvidence = { requestId: id, botId: step.bot.id, botName: step.bot.name, ticketId: step.ticketId,
+      ticketTitle: ticket?.title ?? step.ticketId, stepKey: step.key, stepTitle: step.title, spec: step.spec, outcome: step.state,
+      mode, turns: step.turns, attempts: step.attempts, failures: step.failures, report: step.report ?? '', ...request ? { request: request.slice(0, 2000) } : {}, at,
+      sessionId: stepSessionId(step.ticketId, step.key) }
+    this.save({ id, ticketId: step.ticketId, stepKey: step.key, botId: step.bot.id, botName: step.bot.name, stepTitle: step.title, mode, reasons,
+      state: 'pending', attempts: 0, evidence, at })
+    await this.deliver(id)
+    return this.get(id)
+  }
+  /** Delivers every pending record, oldest first; one that keeps failing is marked failed after `ATTEMPTS` tries. */
+  async deliverPending(): Promise<void> {
+    if (this.delivering) return
+    this.delivering = true
+    try { for (const record of this.list('pending').reverse()) await this.deliver(record.id) } finally { this.delivering = false }
+  }
+  /** A person approved or rejected the skill draft a record produced; the memory system moves or deletes it. */
+  async decide(id: string, decision: 'approve' | 'reject'): Promise<Distill> {
+    const record = this.get(id)
+    if (!record?.result?.skill || record.result.skill.state !== 'draft') throw new Error(`No skill draft waits on ${id}`)
+    const bus = this.bus()
+    if (!bus?.available()) throw new Error('The VsSaros memory system is not running in this Host')
+    const decided = await bus.decideSkillDraft(record.result.skill.name, decision)
+    const state = decided.state === 'active' ? 'active' : 'rejected'
+    // Other records that pointed at the same draft follow the decision.
+    for (const other of this.list()) {
+      if (other.result?.skill?.name === record.result.skill.name && other.result.skill.state === 'draft') {
+        this.save({ ...other, result: { ...other.result, skill: { ...other.result.skill, state } } })
+      }
+    }
+    return this.get(id)!
+  }
+  /** Retries pending records periodically; returns the dispose. */
+  install(): () => void {
+    void this.deliverPending()
+    const timer = setInterval(() => { void this.deliverPending() }, RETRY_MS)
+    timer.unref?.()
+    return () => { clearInterval(timer) }
+  }
+  get(id: string): Distill | undefined {
+    const row = this.host.store.db.prepare('SELECT value FROM team_distill WHERE id=?').get(id)
+    return row ? JSON.parse(String(row.value)) as Distill : undefined
+  }
+  /** Records, newest first, optionally of one state. */
+  list(state?: Distill['state'], limit = 200): Distill[] {
+    const rows = state ? this.host.store.db.prepare('SELECT value FROM team_distill WHERE state=? ORDER BY at DESC LIMIT ?').all(state, limit)
+      : this.host.store.db.prepare('SELECT value FROM team_distill ORDER BY at DESC LIMIT ?').all(limit)
+    return rows.map(row => JSON.parse(String(row.value)) as Distill)
+  }
+  private async deliver(id: string): Promise<void> {
+    const record = this.get(id)
+    if (!record || record.state !== 'pending') return
+    const bus = this.bus()
+    if (!bus?.available()) return
+    try {
+      const result = await bus.rememberStep(record.evidence)
+      this.save({ ...record, state: 'sent', attempts: record.attempts + 1, result, sentAt: new Date().toISOString() })
+    } catch (error) {
+      const attempts = record.attempts + 1, message = String((error as Error)?.message ?? error).slice(0, 300)
+      this.save({ ...record, attempts, error: message, state: attempts >= ATTEMPTS ? 'failed' : 'pending' })
+      this.host.warn(`team step ${record.stepKey} evidence not taken by the memory system (${attempts}/${ATTEMPTS}): ${message}`)
+    }
+  }
+  private save(record: Distill): void {
+    this.host.store.db.prepare('INSERT INTO team_distill VALUES (?,?,?,?,?) ON CONFLICT(id) DO UPDATE SET state=excluded.state, value=excluded.value')
+      .run(record.id, record.ticketId, record.state, JSON.stringify(record), record.at)
+  }
+}
diff --git a/src/app/feed.ts b/src/app/feed.ts
new file mode 100644
index 00000000000..87572ac0e8a
--- /dev/null
+++ b/src/app/feed.ts
@@ -0,0 +1,70 @@
+/**
+ * VsSaros addition (plan C): what changed, pushed to the panel and to the cards in the supervisor desk's conversation as it
+ * happens, instead of their polling. One `text/event-stream` response per open page: each `change` event names the topics
+ * that changed in the last moment (`steps`: team steps, their Bots' work and requests; `tickets`: tickets, proposals and
+ * decisions; `desk`: the desk conversation), and the page reads those again. A comment line every 20 seconds keeps the
+ * connection open; a page that loses it reconnects and reads everything again.
+ *
+ * After DS Bot's live feed (ds-bot/src/host/feed.js, Copyright 2026 Fei2411 and the DS Bot contributors, Apache License 2.0;
+ * see NOTICE): a Server-Sent Events stream of what changed, kept open by a comment line, read again by the page.
+ */
+import type { IncomingMessage, ServerResponse } from 'node:http'
+
+export const FEED_TOPICS = ['steps', 'tickets', 'desk'] as const
+export type FeedTopic = typeof FEED_TOPICS[number]
+
+/** The open streams, and the changes gathered for the next event. */
+export class Feed {
+  private readonly clients = new Set<ServerResponse>()
+  private readonly pending = new Set<FeedTopic>()
+  private timer: ReturnType<typeof setTimeout> | undefined
+  private beat: ReturnType<typeof setInterval> | undefined
+  constructor(private readonly delayMs = 120, private readonly heartbeatMs = 20_000) {}
+
+  /** Open streams now. */
+  get size(): number { return this.clients.size }
+  /** Marks topics changed; the open streams hear of them once, shortly after, however often they change meanwhile. */
+  changed(...topics: FeedTopic[]): void {
+    if (!this.clients.size) return
+    for (const topic of topics) this.pending.add(topic)
+    if (this.timer) return
+    this.timer = setTimeout(() => this.flush(), this.delayMs)
+    this.timer.unref?.()
+  }
+  /** Answers a request with a stream of change events until the page closes it. */
+  attach(req: Pick<IncomingMessage, 'on'>, res: ServerResponse): void {
+    // `no-transform` keeps a compressing web server from buffering the stream; `flush` sends what one buffered anyway.
+    res.writeHead(200, { 'content-type': 'text/event-stream; charset=utf-8', 'cache-control': 'no-store, no-transform', connection: 'keep-alive',
+      'x-content-type-options': 'nosniff', 'x-accel-buffering': 'no' })
+    res.write('retry: 3000\n: open\n\n')
+    this.clients.add(res)
+    if (!this.beat) {
+      this.beat = setInterval(() => { this.write(': ping\n\n') }, this.heartbeatMs)
+      this.beat.unref?.()
+    }
+    const close = () => { this.drop(res) }
+    req.on('close', close)
+    res.on('close', close)
+  }
+  /** Ends every stream, as when dsh-superagent stops. */
+  close(): void {
+    clearTimeout(this.timer); this.timer = undefined
+    for (const res of [...this.clients]) { this.drop(res); try { res.end() } catch { /* already closed */ } }
+  }
+  private flush(): void {
+    this.timer = undefined
+    if (!this.pending.size) return
+    const topics = FEED_TOPICS.filter(topic => this.pending.has(topic))
+    this.pending.clear()
+    this.write(`event: change\ndata: ${JSON.stringify({ topics })}\n\n`)
+  }
+  private write(text: string): void {
+    for (const res of [...this.clients]) {
+      try { res.write(text); (res as { flush?: () => void }).flush?.() } catch { this.drop(res) }
+    }
+  }
+  private drop(res: ServerResponse): void {
+    this.clients.delete(res)
+    if (!this.clients.size && this.beat) { clearInterval(this.beat); this.beat = undefined }
+  }
+}
diff --git a/src/app/group-routes.ts b/src/app/group-routes.ts
new file mode 100644
index 00000000000..5124e2cd059
--- /dev/null
+++ b/src/app/group-routes.ts
@@ -0,0 +1,48 @@
+/**
+ * VsSaros addition (2026-11-06): which group chat a desk message went to.
+ *
+ * A group chat runs in `@vssaros/dsh-agents`, outside the orchestrator's model, so the desk intake records the Trigger as
+ * `ignore` when it makes a group or routes `@group …` to one. On its own that decision reads as "the supervisor did not take
+ * this message". This table is the link between the two models: it says which group took the Trigger, so the desk's flow
+ * card can show the group (and its live run) instead of a refusal.
+ *
+ * The runtime writes a route in the same `Store.atomic` transaction as the ignore decision and the "group made" notice, so
+ * a crash never leaves a group recorded without its notice, or the reverse. The first route for a Trigger wins.
+ */
+import type { DatabaseSync } from 'node:sqlite'
+
+export type GroupRouteKind = 'created' | 'routed' | 'updated'
+
+export interface GroupRoute {
+  triggerId: string
+  roomId: string
+  roomName: string
+  /**
+   * `created`: the message asked for a new group; `routed`: it was an `@group` command to an existing one; `updated`
+   * (2026-11-06): it asked for a group whose name an existing one has, which was edited instead.
+   */
+  kind: GroupRouteKind
+  /** The DSH message id of the person's message; the agents plugin records the same id on the group's run. */
+  sourceMessageId?: string
+  at: string
+}
+
+/** The `group_route` table in the orchestrator database; writes happen inside the caller's `Store.atomic` transaction. */
+export class GroupRoutes {
+  constructor(private readonly db: DatabaseSync) {
+    db.exec(`CREATE TABLE IF NOT EXISTS group_route (trigger_id TEXT PRIMARY KEY, room_id TEXT NOT NULL, room_name TEXT NOT NULL,
+      kind TEXT NOT NULL, source_message_id TEXT, at TEXT NOT NULL)`)
+  }
+  /** Records where a Trigger went; recording the same Trigger again changes nothing. */
+  record(route: GroupRoute): void {
+    this.db.prepare('INSERT OR IGNORE INTO group_route (trigger_id, room_id, room_name, kind, source_message_id, at) VALUES (?,?,?,?,?,?)')
+      .run(route.triggerId, route.roomId, route.roomName, route.kind, route.sourceMessageId ?? null, route.at)
+  }
+  get(triggerId: string): GroupRoute | undefined {
+    const row = this.db.prepare('SELECT trigger_id, room_id, room_name, kind, source_message_id, at FROM group_route WHERE trigger_id=?').get(triggerId)
+    if (!row) return undefined
+    const kind: GroupRouteKind = row.kind === 'created' || row.kind === 'updated' ? row.kind : 'routed'
+    return { triggerId: String(row.trigger_id), roomId: String(row.room_id), roomName: String(row.room_name), kind,
+      ...row.source_message_id ? { sourceMessageId: String(row.source_message_id) } : {}, at: String(row.at) }
+  }
+}
diff --git a/src/app/group-tickets.ts b/src/app/group-tickets.ts
new file mode 100644
index 00000000000..bbf157c6d0d
--- /dev/null
+++ b/src/app/group-tickets.ts
@@ -0,0 +1,84 @@
+/**
+ * VsSaros addition (2026-11-07, user request「@群 时也同时建一张工单，群聊做完把结果回写到工单」).
+ *
+ * A desk message `@已有群 …` used to be recorded as `ignore` and left entirely to the Bots plugin's group chat, so SuperAgent
+ * never knew whether the work finished. Now the same intake accepts it as a ticket that the group runs (`Ticket.group`): no
+ * worker starts, no Thread is followed, and the group's state is checked here, from the Bots plugin's `groupState`, until it
+ * settles. Then the ticket gets the report a worker would have given: `ready` (ends it, with the group's last replies or its
+ * goal's summary), `waiting` (the group waits for the person: a choice card, or a goal that is not done), or `dropped`
+ * (the group was deleted, or its goal was stopped).
+ *
+ * "Settled" is the Bots plugin's `idle` (no round running, no member working in the background, nothing queued, no
+ * approval waiting) for at least `GROUP_SETTLE_MS`, and a member said something since the ticket began: a message that has
+ * not reached the group yet leaves nothing to report.
+ */
+import type { Ticket } from '../core/index.ts'
+
+/** How long the group must have been still before its state is taken as the ticket's result. */
+export const GROUP_SETTLE_MS = 5000
+/** How often open group tickets are checked. */
+export const GROUP_CHECK_MS = 10_000
+/** The summary's length limit; the desk notice and the flow card shorten it further. */
+const SUMMARY_LIMIT = 1800
+
+/** One line of the group's log, as the Bots plugin gives it. */
+export interface GroupLogLine { at: number; who: string; botId?: string; kind?: string; late?: boolean; text: string }
+/** What the Bots plugin tells about a group (`TeamBus.groupState`, vssaros-agents 0.2.355+). */
+export interface GroupState {
+  roomId: string
+  roomName?: string
+  /** The group was deleted. */
+  missing?: true
+  idle?: boolean
+  /** When the group last did something (its last log line, or its latest round's start or end). */
+  activeAt?: number
+  asks?: { name: string; botId?: string; at: number; headline: string; questions: number }[]
+  goal?: { title: string; status: 'active' | 'paused' | 'complete' | 'stopped'; idle: boolean; summary: string; completedAt?: number; updatedAt?: number } | null
+  log?: GroupLogLine[]
+}
+export interface GroupReport { state: 'ready' | 'waiting' | 'dropped'; summary: string }
+
+const clip = (text: string, limit = SUMMARY_LIMIT) => text.length > limit ? `${text.slice(0, limit)}…` : text
+const since = (ticket: Pick<Ticket, 'createdAt'>) => Date.parse(ticket.createdAt) || 0
+
+/**
+ * The report a group ticket gets from its group's state, or none while the group works or has not started on it.
+ * Pure: the runtime compares it with the ticket's latest report and only writes a change.
+ */
+export function groupTicketReport(ticket: Pick<Ticket, 'createdAt' | 'group'>, state: GroupState | undefined, now: number): GroupReport | undefined {
+  const name = state?.roomName || ticket.group?.roomName || '群聊'
+  if (!state) return undefined
+  if (state.missing) return { state: 'dropped', summary: `群「${name}」已经删除，这张工单没有结果。` }
+  if (!state.idle) return undefined
+  if (state.activeAt && now - state.activeAt < GROUP_SETTLE_MS) return undefined
+  const from = since(ticket)
+  const lines = (state.log ?? []).filter(line => line.at >= from && line.who !== '用户' && line.kind !== 'ask-answer' && line.text?.trim())
+  const goal = state.goal
+  const goalChanged = !!goal && (goal.updatedAt ?? 0) >= from
+  if (!lines.length && !goalChanged) return undefined
+  const asks = (state.asks ?? []).filter(ask => ask.at >= from || lines.length)
+  if (asks.length) {
+    return { state: 'waiting', summary: `群「${name}」等你在群里选择：${asks.map(ask => `${ask.name}（${ask.headline}）`).join('；')}` }
+  }
+  if (goal && goalChanged && goal.status === 'complete') {
+    return { state: 'ready', summary: clip(`群「${name}」完成了目标「${goal.title}」${goal.summary ? `：${goal.summary}` : '。'}`) }
+  }
+  if (goal && goalChanged && goal.status === 'stopped') return { state: 'dropped', summary: `群「${name}」停止了目标「${goal.title}」。` }
+  if (goal && (goal.status === 'active' || goal.status === 'paused')) {
+    return { state: 'waiting', summary: `群「${name}」的目标「${goal.title}」还没完成，在等你在群里回复。` }
+  }
+  const last = lines.filter(line => line.kind !== 'ask').slice(-2).map(line => `${line.who}：${line.text.trim()}`)
+  if (!last.length) return undefined
+  return { state: 'ready', summary: clip(`群「${name}」这次的结果（${lines.length} 条回复）：\n\n${last.join('\n\n')}`) }
+}
+
+/** The ticket title for a message to a group: the message without the `@群名` it starts with. */
+export function groupTicketTitle(text: string, roomName: string): string {
+  const escaped = roomName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
+  const body = String(text ?? '').trim()
+    .replace(new RegExp(`^@\\[${escaped}\\]\\([^)]*\\)`), '')
+    .replace(new RegExp(`^@\\[?${escaped}\\]?`), '')
+    .trim()
+  const title = body || String(text ?? '').trim()
+  return title.length > 80 ? `${title.slice(0, 80)}…` : title
+}
diff --git a/src/app/groupFastPath.ts b/src/app/groupFastPath.ts
new file mode 100644
index 00000000000..41dda76b18a
--- /dev/null
+++ b/src/app/groupFastPath.ts
@@ -0,0 +1,300 @@
+/**
+ * 2026-11-05 P0: a person asks the supervisor desk to make a group of Bots. That request used to wait for the orchestrator
+ * model to classify it and call `orchestrator_team_create_group` (~44s in the 19:20 log). A group chat is a deterministic
+ * side effect, so the desk intake now makes it at once and records the Trigger as ignored; the main Session never has to
+ * reason about it. The Bots plugin reuses a group with the same `originTriggerId`, so the desk's automatic intake,
+ * `superagent_submit`, and any later model tool call are all idempotent.
+ *
+ * The same intake also recognises `@已有群` with DSH's paired `session-reference` event: the Bots plugin owns the relay,
+ * so SuperAgent only records an `ignore` decision and does not spend another main-Session model evaluation on it.
+ */
+import type { ReceiveResult, Trigger } from '../core/index.ts'
+import { GROUP_REQUEST } from '../core/group-request.ts'
+import type { GroupRouteKind } from './group-routes.ts'
+import { groupTicketTitle } from './group-tickets.ts'
+import type { GroupView } from './team.ts'
+
+/** A Bot the roster offers; `delegatable` is enough to decide who can join a group. */
+export interface FastGroupBot { id: string; name: string; delegatable?: boolean }
+export interface FastGroupPlan { members: string[]; name: string; notice: string; mode: 'admin' }
+/** DSH 外壳把「引用会话」单独发成一条 `user/message`，`source.kind` 是它。 */
+export const GROUP_REFERENCE_KIND = 'session-reference';
+/**
+ * 一条以 @ 开头的桌面消息最多等它的引用事件多久再走常规路径。原来是 40ms：引用事件晚到一点，
+ * 消息就交给了主管模型，而 agents 插件（15 秒窗口）照样把它转进群——同一条消息两头都处理。
+ */
+export const GROUP_REFERENCE_WAIT_MS = 1500;
+/** 引用事件晚于等待窗口到达时，仍按 @群 补记的最长间隔；与 agents 插件 rooms.js 的配对窗口相同。 */
+export const GROUP_REFERENCE_LATE_MS = 15_000;
+/** 只有以 @ 开头的消息才可能是群命令（`addressedGroupMessage` 的前提）；其它消息不必等引用事件。 */
+export const mayBeGroupCommand = (text: string): boolean => String(text ?? '').trim().startsWith('@');
+export interface GroupReference { room: GroupView; label: string }
+/**
+ * What the intake settles in one go: the group a Trigger went to, the ignore decision that keeps the main Session off it,
+ * and (for a new group) the notice to the person. The runtime commits them in one transaction (see group-routes.ts).
+ * @throws when the route or the notice could not be written; a decision that cannot be recorded (the Trigger was decided
+ *   already) is only warned about, since the route still says where the message went.
+ */
+export interface GroupSettlement {
+  reason: string
+  route: { roomId: string; roomName: string; kind: GroupRouteKind; sourceMessageId?: string }
+  notice?: { id: string; text: string }
+  /**
+   * VsSaros addition (2026-11-07): accept the Trigger as a ticket the group runs (`Ticket.group`) instead of ignoring it;
+   * the runtime falls back to `ignore` when the accept is refused.
+   */
+  ticket?: { title: string; scope: string }
+}
+export interface GroupCommandHost {
+  receive(trigger: Trigger): ReceiveResult
+  settle(triggerId: string, settlement: GroupSettlement): void
+  requestPass(): void
+  listGroups(): Promise<readonly GroupView[]>
+  warn(message: string): void
+}
+export type GroupCommandResult = 'group-command' | 'fallback'
+
+/** 从 DSH 的 `session-reference` 事件里认出已存在的群；`sessionId` 优先，label 兜底。 */
+export function groupReferenceOf(event: unknown, groups: readonly GroupView[]): GroupReference | undefined {
+	const source = (event as { data?: { source?: { kind?: unknown; references?: unknown[] } } })?.data?.source
+	if (source?.kind !== GROUP_REFERENCE_KIND || !Array.isArray(source.references)) { return undefined }
+	for (const item of source.references) {
+		const ref = item as { sessionId?: unknown; label?: unknown }
+		const sessionId = typeof ref.sessionId === 'string' ? ref.sessionId : ''
+		const label = typeof ref.label === 'string' ? ref.label : ''
+		const room = (groups ?? []).find(group => (sessionId && (group.id === sessionId || group.sessionId === sessionId))
+			|| (label && group.name === label))
+		if (room) { return { room, label: label || room.name } }
+	}
+	return undefined
+}
+
+/** 纯文本 `@群名` 的兜底：必须真的以 @ 开头，最长群名优先，避免把背景引用当派活。 */
+export function groupByNameMention(text: string, groups: readonly GroupView[]): GroupReference | undefined {
+	const body = String(text ?? '').trim()
+	if (!body.startsWith('@')) { return undefined }
+	const room = [...(groups ?? [])].sort((a, b) => String(b.name).length - String(a.name).length)
+		.find(group => group.name && (body.includes(`@${group.name}`) || body.includes(`@[${group.name}]`)))
+	return room ? { room, label: room.name } : undefined
+}
+
+export function addressedGroupMessage(text: string, ref: GroupReference): boolean {
+	const body = String(text ?? '').trim()
+	const label = String(ref?.label || ref?.room?.name || '')
+	return !!label && body.startsWith('@') && (body.includes(`@${label}`) || body.includes(`@[${label}]`))
+}
+
+/**
+ * `@已有群 …` 由 agents 插件确定性转投到群会话；这里只把 SuperAgent Trigger 记为 ignore 并记下它去了哪个群，
+ * 不让 main Session 再花一轮模型把它判成 ignore。失败时回到原 intake 路径。
+ * `late`：引用事件在等待窗口之后才到，消息已经走了常规路径（Eval 可能已开始）。仍然记 ignore（结束那次 Eval），
+ * 与 agents 插件 15 秒的配对窗口保持一致，避免「群在做、主管也在评估」两头都处理。
+ */
+export async function handleDeskGroupCommand(
+	host: GroupCommandHost, trigger: Trigger, text: string, referenceEvent?: unknown,
+	options: { sourceMessageId?: string; late?: boolean } = {},
+): Promise<GroupCommandResult> {
+	let ref: GroupReference | undefined
+	try {
+		const groups = await host.listGroups()
+		ref = groupReferenceOf(referenceEvent, groups) ?? groupByNameMention(text, groups)
+	} catch (error) {
+		host.warn(`group command fast path could not read groups: ${String(error)}`)
+		return 'fallback'
+	}
+	if (!ref || !addressedGroupMessage(text, ref)) { return 'fallback' }
+	let received = false
+	try {
+		const result = host.receive(trigger)
+		received = true
+		if (result === 'filtered') { return 'fallback' }
+		try {
+			host.settle(trigger.id, {
+				reason: `Routed to existing group${options.late ? ' (late reference)' : ''}: ${ref.room.name}`,
+				route: { roomId: ref.room.id, roomName: ref.room.name, kind: 'routed',
+					...options.sourceMessageId ? { sourceMessageId: options.sourceMessageId } : {} },
+				// 2026-11-07：同时建一张由群执行的工单（迟到的引用事件不建：那时消息可能已经进了主管的批次评估）
+				...options.late ? {} : { ticket: { title: groupTicketTitle(text, ref.label || ref.room.name), scope: String(text ?? '').trim() } },
+			})
+			host.requestPass()
+		} catch (error) {
+			host.warn(`group command fast path could not record where the message went: ${String(error)}`)
+		}
+		return 'group-command'
+	} catch (error) {
+		host.warn(`group command fast path failed: ${String(error)}`)
+		return received ? 'group-command' : 'fallback'
+	}
+}
+
+/**
+ * Does this message ask for a group of Bots? Deliberately broad: 「创建开发团队，制作…」 was the real request that took
+ * 44s, while 「@群名 开始制作」 is a command to an existing group and must not create another one.
+ */
+export function isGroupCreationRequest(text: string): boolean {
+	const body = String(text ?? '').trim()
+	if (!body || body.startsWith('@')) { return false }
+	// ★ 2026-11-09：真机「创建一个 俄罗斯方块 h5 小游戏开发团队」没被识别 —— 动词到「团队」
+	//   之间隔了 17 个字符，旧的 {0,12} 放不下 ⇒ 走普通 intake，用户以为建群没反应。
+	//   放宽到 {0,48}（够放长标题，又不至于跨过整句话），并用否定词排除「不要/别/无需建群」。
+	//   ⚠ 否定词要判**动词之前或紧邻动词**的短语，避免误伤「创建一个不要加班的团队」这类正向描述。
+	if (/(?:不要|别|无需|不用|不必|取消|不用再|别再)\s*(?:建|拉|创建|组建|成立)?\s*(?:群|团队)/u.test(body)) { return false }
+	if (/(?:^|[，,。！!？?\s])(?:不要|别|无需|不用|不必)\s*(?:建|拉|创建|组建|成立)/u.test(body)) { return false }
+	return GROUP_REQUEST.test(body)
+}
+
+/** Derive a stable group name and shared notice from the request, and pick up to three suitable Bots. */
+export function fastGroupPlan(text: string, roster: readonly FastGroupBot[]): FastGroupPlan | undefined {
+	if (!isGroupCreationRequest(text)) { return undefined }
+	const pool = (Array.isArray(roster) ? roster : []).filter(bot => bot?.id && bot.id !== 'superagent' && bot.delegatable !== false)
+	const ids: string[] = []
+	const take = (match: RegExp): FastGroupBot | undefined => {
+		const hit = pool.find(bot => !ids.includes(bot.id) && match.test(`${bot.id} ${bot.name}`))
+		if (hit) { ids.push(hit.id) }
+		return hit
+	}
+	const coder = take(/^(?:coder|developer|front[- ]?end|开发|前端|工程师|code)/i)
+	const designer = take(/^(?:designer|ui|ux|设计|产品)/i)
+	const reviewer = take(/^(?:code[- ]?reviewer|reviewer|审查|评审)/i)
+	// VsSaros addition (2026-11-06): a request to build something also gets the tester, who previews it in the browser.
+	const tester = BUILD_WORDS.test(text) ? take(/^(?:tester|qa\b|测试)/i) : undefined
+	if (!reviewer && !tester) take(/^(?:qa\b|tester|测试)/i)
+	const size = tester ? 4 : 3
+	for (const bot of pool) {
+		if (ids.length >= size) { break }
+		if (!ids.includes(bot.id)) { ids.push(bot.id) }
+	}
+	if (ids.length < 2) { return undefined }
+	const explicit = /(?:群名|名称|叫|名为)\s*[「"']?([^」"'\n，,。]{2,40})/u.exec(text)
+	// ★ 2026-11-09（真机「创建 坦克大战 H5 开发团队」被取名成「开发团队群」）：
+	//   旧 body 正则 `动词[^，,。]*?(?:群|团队)[，,：:\s]*` 在「标题紧跟『开发团队』、句末没有
+	//   后续目标」时会把整句吞空 ⇒ goal="" ⇒ 命中泛化兜底名。改成两段式：
+	//   ① 按逗号/冒号切段；第一段剥掉动词前缀与尾部「(开发)团队/群」得到标题，后续段是任务描述。
+	//   ② 标题为空（如「创建开发团队，制作…」）才用后续段取名；公告始终优先后续段。
+	//   ③ 连标题都提不出来（纯指令「建群」）⇒ 返回 undefined 交给普通流程，绝不回落到泛化名。
+	const raw = String(text).trim()
+	// 连「建群 / 建个群 / 创建团队」这类「动词 + 群|团队」紧连的套话一起吃掉，
+	// 否则「建群开发一个 h5 应用」会剩下一个「群」字，公告与标题都会带脏前缀。
+	const verb = /^(?:请|帮我|麻烦)?(?:建|拉|创建|组建|成立)\s*(?:一个|个)?\s*(?:群|团队)?\s*/u
+	const tail = /[\s，,。]*?(?:开发|研发|项目)?(?:团队|群)\s*[。！!？?]*$/u
+	const goalPrefix = /^(?:制作|开发|做|实现|完成)(?:一个)?/u
+	const segments = raw.split(/[，,：:]/u).map(part => part.trim()).filter(Boolean)
+	const first = segments[0] ?? ''
+	const title = first.replace(verb, '').replace(tail, '').trim()
+	const rest = segments.slice(1).join('，').trim()
+	const body = (title.length >= 2 ? title : rest) || first.replace(verb, '').trim()
+	const goal = body.replace(goalPrefix, '').replace(tail, '').trim().replace(/[。！!？?，,]+$/u, '')
+	const explicitName = explicit?.[1]?.trim()
+	const basis = explicitName || goal
+	if (!basis) { return undefined }
+	const name = (explicitName || `${basis.slice(0, 40)} 开发团队`).slice(0, 60)
+	const nameOf = (bot: FastGroupBot | undefined) => bot?.name
+	// ★ 2026-11-10：名册没有 coder/tester（真机蛇群是 planner + code-explorer + …）时也要有分工公告。
+	//   闲聊群（BUILD_WORDS 不命中）保持原样，不带任何流程文本。
+	const chosen = ids.slice(0, size)
+	const names = chosen.map(id => nameOf(pool.find(bot => bot.id === id)) || id)
+	const flow = coder && tester
+		? groupFlowNotice({ coder: nameOf(coder)!, tester: nameOf(tester)!, designer: nameOf(designer), reviewer: nameOf(reviewer) })
+		: BUILD_WORDS.test(text) && names.length >= 2 ? divisionNotice({ admin: names[0] ?? '', others: names.slice(1) }) : ''
+	const request = (rest || first.replace(verb, '').replace(/^[，,：:\s]+/u, '') || raw).slice(0, 2000 - (flow ? flow.length + 2 : 0))
+	return { members: chosen, name, notice: flow ? `${request}\n\n${flow}` : request, mode: 'admin' }
+}
+
+/** Words of a request to build something, which then gets a tester in its group. */
+const BUILD_WORDS = /开发|制作|做一?个|实现|应用|app\b|h5|网页|页面|小程序|游戏|测试|预览|验收|上线/iu
+
+/**
+ * VsSaros addition (2026-11-06): the group's notice that chains the members (design → develop → review → test in a browser,
+ * bugs back to the developer, re-test at most 3 times), as DeepSeek-Bot's groups follow their notice. The Bots plugin calls
+ * a member back when the work it handed on is done, so each step's hand-over is one @.
+ */
+export function groupFlowNotice(names: { coder: string; tester: string; designer?: string | undefined; reviewer?: string | undefined }): string {
+	const { coder, tester, designer, reviewer } = names
+	return [`协作流程（每位成员都按这个接力；管理员 ${coder} 先用 group_goal 把下面几步设成群目标的阶段，每阶段写明完成标准，之后按阶段派活、验收、不过就打回）：`,
+		designer ? `1. 管理员 ${coder} 先 @${designer} 出设计方案（页面、交互、样式）；${designer} 完成后 @${coder}。` : `1. ${coder} 先确认需求与方案。`,
+		`2. ${coder} 开发完成后${reviewer ? ` @${reviewer} 评审；评审有问题 @${coder} 修改，评审通过后 @${tester}` : ` @${tester}`}。`,
+		`3. ${tester} 在后台起本地预览服务，用浏览器打开逐项点测；有问题 @${coder}，写清「操作步骤 → 期望 → 实际」。`,
+		`4. ${coder} 修完后 @${tester} 复测；最多复测 3 轮，仍有问题就列给用户决定。`,
+		`5. 全部通过后由 ${tester} 向用户汇报：测过哪些功能、各自的结果。`].join('\n')
+}
+
+/**
+ * ★ 2026-11-10（真机「3d像素贪吃蛇群没有使用成员分工」）：名册里没有 coder / tester 时，
+ *   `coder && tester ? groupFlowNotice(...)` 会整段不生成公告，群公告只剩群名 ⇒
+ *   `roomPrompt` 里没有任何派活指令，`openingCall` 又因 mode='admin' 只叫管理员一人。
+ *   这里给「做事类」群生成**角色无关**的分工公告：按实际成员点名交棒，不假设谁开发谁测试。
+ *   ⚠ 不含「协作流程」四字（闲聊群断言 `not.toContain('协作流程')` 依赖它）。
+ */
+export function divisionNotice(names: { admin: string; others: string[] }): string {
+	const { admin, others } = names
+	const roster = [admin, ...others]
+	return [`【本群分工】成员：${roster.join('、')}。管理员 ${admin} 先用 group_goal 把这件事拆成阶段，每阶段写明完成标准并分给具体成员。`,
+		`1. ${admin} 先按阶段 @ 对应成员派活；同一条里 @ 的几位同时开始，要用到某人结果就先 @ 他、请他做完后 @ 下一位。`,
+		others.length ? `2. 每位成员（${others.join('、')}）接到活就在同一步开始调工具去做，不要只回「我来做」；结尾写改了哪些文件、跑了什么命令、看到什么结果。` : '2. 接到活就在同一步开始调工具去做，结尾写结果和证据。',
+		`3. ${admin} 检查每位成员的产出：通过就 pass（附证据）进入下一阶段，不通过就 rework 写清缺什么，再 @ 对方返工。`,
+		`4. 全部阶段通过后由 ${admin} 向用户汇报做了什么、怎么验的、结论是什么；需要用户取舍时调 group_ask 出选择卡，不要把选项写成文字。`].join('\n')
+}
+
+/**
+ * The desk's notice for a group a message asked for. VsSaros addition (2026-11-06): when a group of that name existed, the
+ * Bots plugin edited it (`reused`), so the notice says which members joined or left, under an id of its own per message
+ * (`group-created:<room>` would be the first one's, which the desk outbox already holds and would drop).
+ */
+export function groupMadeNotice(group: GroupView, triggerId: string): { id: string; text: string } {
+	const names = group.members.map(member => member.name)
+	const admin = group.members.find(member => member.id === group.admin)?.name
+	const how = `在左侧栏「Bots」页签里点开它就能在群里说话${group.mode === 'admin' ? '（普通消息先给管理员，@名字 可以直接点人）' : '（每位成员依次回答）'}。`
+	if (!group.reused) {
+		return { id: `group-created:${group.id}`, text: `已建群「${group.name}」：${names.join('、')}${admin ? `，管理员 ${admin}` : ''}。${how}` }
+	}
+	const changes = [group.added?.length ? `加入 ${group.added.join('、')}` : '', group.removed?.length ? `移出 ${group.removed.join('、')}` : ''].filter(Boolean)
+	return { id: `group-updated:${group.id}:${triggerId}`,
+		text: `已有同名群「${group.name}」，没有另建，${changes.length ? `已${changes.join('，')}` : '成员没有变化'}。现在的成员：${names.join('、')}${admin ? `，管理员 ${admin}` : ''}。${how}` }
+}
+
+export interface GroupFastPathHost {
+  receive(trigger: Trigger): ReceiveResult
+  /** Records the group, the ignore decision and the notice together (see `GroupSettlement`). */
+  settle(triggerId: string, settlement: GroupSettlement): void
+  /** Carries out the recorded decision without relaying the candidate to the main Session. */
+  requestPass(): void
+  bots(): Promise<readonly FastGroupBot[]>
+  createGroup(input: FastGroupPlan & { originTriggerId: string }): Promise<GroupView>
+  warn(message: string): void
+  fallback(trigger: Trigger): unknown
+}
+
+export type GroupFastPathResult = 'group' | 'fallback' | 'failed'
+
+/** Handles one desk message: group requests are made here; everything else follows the original intake path. */
+export async function handleDeskMessage(host: GroupFastPathHost, trigger: Trigger, text: string): Promise<GroupFastPathResult> {
+	let plan: FastGroupPlan | undefined
+	try { plan = fastGroupPlan(text, await host.bots()) } catch (error) {
+		host.warn(`group fast path could not read the Bot roster: ${String(error)}`)
+	}
+	if (!plan) { host.fallback(trigger); return 'fallback' }
+	let received = false
+	let created = false
+	try {
+		const result = host.receive(trigger)
+		received = true
+		if (result === 'filtered') { host.warn('group fast path: the desk Source is off; left the trigger to the normal path') }
+		const group = await host.createGroup({ ...plan, originTriggerId: trigger.id })
+		created = true
+		try {
+			host.settle(trigger.id, {
+				reason: `Synchronous group chat ${group.reused ? 'updated' : 'created'}: ${group.name}`,
+				route: { roomId: group.id, roomName: group.name, kind: group.reused ? 'updated' : 'created' },
+				notice: groupMadeNotice(group, trigger.id),
+			})
+			host.requestPass()
+		} catch (error) {
+			host.warn(`group fast path could not record the new group: ${String(error)}`)
+		}
+		return 'group'
+	} catch (error) {
+		host.warn(`group fast path failed: ${String(error)}`)
+		if (!received || !created) { host.fallback(trigger) }
+		return 'failed'
+	}
+}
