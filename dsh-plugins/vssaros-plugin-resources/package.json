{
  "name": "@vssaros/dsh-plugin-resources",
  "version": "0.1.0",
  "description": "Host-only registry and lifecycle for declarative Bot, skill, tool and MCP plugin resources.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./plugin-package": "./lib/pluginPackage.js",
    "./archive": "./lib/archive.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-0 <0.3.0-0",
    "@deepseek-ai/dsh-app-boot": ">=0.2.2-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": ["./cordis.patch.yml"]
    }
  },
  "vssaros": {
    "manifestVersion": 1,
    "view": { "kind": "none" }
  },
  "license": "MIT"
}
