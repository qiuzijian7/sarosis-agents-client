{
  "name": "@vssaros/dsh-marketplace",
  "version": "0.2.55",
  "description": "VsSaros marketplace workbench: agent / skill / workbench / workflow browsing, install, upgrade, uninstall, publish and admin review. The page only sends intent (ide.request capability 'marketplace'); authentication, downloading and registry refresh all happen on the IDE side.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/workbench.js"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/workbench.js",
    "lib/agentTools.js",
    "lib/marketAgent.js",
    "lib/marketClient.js",
    "lib/installedLedger.js",
    "lib/installers.js",
    "lib/publishPreflight.js",
    "lib/publisher.js",
    "lib/githubSource.js",
    "lib/localResources.js",
    "lib/dispatch.js",
    "lib/shape.js",
    "lib/mcpInstall.js",
    "lib/githubInspect.js",
    "lib/npmLookup.js",
    "lib/hostVersion.js",
    "lib/tar.js",
    "lib/foundationRef.js",
    "lib/page.css",
    "cordis.patch.yml",
    "lib/vendor/react.production.min.js",
    "lib/vendor/react-dom.production.min.js",
    "lib/vendor/README.txt",
    "lib/vendor/LICENSE.react"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-0 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "vssaros": {
    "manifestVersion": 1,
    "module": "marketplace",
    "activityBar": {
      "containerId": "vssaros.dsh.marketplace",
      "title": {
        "zh": "商城",
        "en": "Marketplace"
      },
      "icon": "codicon:extensions",
      "order": 86
    },
    "view": {
      "kind": "page",
      "route": "/x/marketplace/"
    },
    "legacyCounterpart": "vssaros.dsh.marketplace",
    "workbench": {
      "title": "商城工作台",
      "description": "Agent / Skill / 工作台 / 工作流 的浏览、安装、升级、发布与管理。",
      "repository": "vssaros:marketplace",
      "customFrame": true
    },
    "ideCapabilities": [
      "marketplace"
    ]
  },
  "license": "MIT"
}
