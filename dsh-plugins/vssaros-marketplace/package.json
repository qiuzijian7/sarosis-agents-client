{
  "name": "@vssaros/dsh-marketplace",
  "version": "0.3.36",
  "description": "VsSaros marketplace: real resource discovery, grouped favorites, native and local decorative themes, installation, upgrade, publishing and review in the dsh Host.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/workbench.js"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/workbench.js",
    "lib/agentTools.js",
    "lib/marketAgent.js",
    "lib/marketClient.js",
    "lib/installedLedger.js",
    "lib/installedState.js",
    "lib/installedReconcile.js",
    "lib/installSpec.js",
    "lib/installers.js",
    "lib/upgradeBackup.js",
    "lib/botPack.js",
    "lib/publishPreflight.js",
    "lib/publisher.js",
    "lib/githubSource.js",
    "lib/localResources.js",
    "lib/dispatch.js",
    "lib/skillSources.js",
    "lib/shape.js",
    "lib/mcpInstall.js",
    "lib/preview.js",
    "lib/sidecar.js",
    "lib/components.js",
    "lib/portable.js",
    "lib/knowledgeRegistry.js",
    "lib/githubInspect.js",
    "lib/npmLookup.js",
    "lib/hostVersion.js",
    "lib/tar.js",
    "lib/foundationRef.js",
    "lib/page.css",
    "cordis.patch.yml",
    "lib/vendor/react.production.min.js",
    "lib/vendor/react-dom.production.min.js",
    "lib/vendor/README.txt",
    "lib/vendor/LICENSE.react",
    "lib/pluginArchive.js",
    "lib/client.state.js",
    "lib/client.ui.js",
    "lib/preferences.js",
    "lib/installPreflight.js"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-0 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "vssaros": {
    "manifestVersion": 1,
    "module": "marketplace",
    "activityBar": {
      "containerId": "vssaros.dsh.marketplace",
      "title": {
        "zh": "商城",
        "en": "Marketplace"
      },
      "icon": "codicon:extensions",
      "order": 86
    },
    "view": {
      "kind": "page",
      "route": "/x/marketplace/"
    },
    "legacyCounterpart": "vssaros.dsh.marketplace",
    "workbench": {
      "title": "商城工作台",
      "description": "Agent / Skill / MCP / 工作台 / 知识库 / 插件的发现、收藏、安装、发布与管理。",
      "repository": "vssaros:marketplace",
      "customFrame": true
    },
    "ideCapabilities": [
      "marketplace"
    ]
  },
  "license": "MIT",
  "scripts": {
    "check:ui-state": "node --test test/run-marketplace-ui-state-check.mjs test/run-marketplace-preferences-check.mjs"
  }
}
