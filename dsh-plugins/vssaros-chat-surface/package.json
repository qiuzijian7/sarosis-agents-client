{
  "name": "@vssaros/dsh-chat-surface",
  "version": "0.2.195",
  "description": "VsSaros chat-surface plugin for DeepSeek Harness: binds the chat surface to the VsSaros-owned session (方案 5.13.2 / 7.x). Client-only; the host half is inert.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/client.*.js",
    "lib/client.account.js",
    "lib/client.agents.js",
    "lib/client.approval.js",
    "lib/client.botEntry.js",
    "lib/client.brand.js",
    "lib/client.capsule.js",
    "lib/client.cardActions.js",
    "lib/client.delegate.js",
    "lib/client.fileCards.js",
    "lib/client.footer.js",
    "lib/client.hero.js",
    "lib/client.hideBridgePing.js",
    "lib/client.js",
    "lib/client.market.js",
    "lib/client.openInApp.js",
    "lib/client.persona.js",
    "lib/client.preset.js",
    "lib/client.sessionLabel.js",
    "lib/client.sessions.js",
    "lib/client.settings.js",
    "lib/client.skin.js",
    "lib/client.subagents.js",
    "lib/client.todos.js",
    "lib/client.tools.js",
    "lib/client.usage.js",
    "lib/client.welcome.js",
    "lib/client.workbenchNav.js",
    "lib/client.workflowRun.js",
    "lib/client.workspace.js",
    "lib/client.workspaces.js",
    "lib/index.js",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-0 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-gateway"
      ]
    }
  },
  "license": "MIT"
}
