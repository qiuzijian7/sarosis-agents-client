{
  "name": "@vssaros/dsh-scheduler",
  "version": "0.9.3",
  "description": "VsSaros Scheduler: independent vssarosScheduler service and vssaros_schedule_* tools, compatible with the official schedule service. Existing tasks and Dream actions remain in <dataRoot>/scheduler/tasks.json; workbench APIs remain /x/scheduler/api/*.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/core/cron.js",
    "lib/core/task.js",
    "lib/engine.js",
    "lib/pageShell.js",
    "lib/foundationRef.js",
    "lib/migrate.js",
    "lib/store.js",
    "lib/tools.js",
    "lib/sessionBinding.js",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-0 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@vssaros/dsh-workbenches"
      ]
    }
  },
  "vssaros": {
    "manifestVersion": 1,
    "module": "scheduler",
    "activityBar": {
      "containerId": "vssaros.dsh.scheduler",
      "title": {
        "zh": "定时任务",
        "en": "Scheduled Tasks"
      },
      "icon": "codicon:clock",
      "order": 95
    },
    "view": {
      "kind": "page",
      "route": "/x/scheduler/"
    },
    "legacyCounterpart": "vssaros.dsh.scheduler",
    "workbench": {
      "title": "自动化任务",
      "description": "自动化任务（自建调度）：定时/周期/一次性任务，投递到会话并记录运行历史。",
      "icon": "codicon:clock",
      "repository": "vssaros:scheduler",
      "customFrame": false,
      "headerLayout": "default",
      "floatingActions": false,
      "splitConversation": false
    }
  },
  "license": "MIT",
  "scripts": {
    "check": "node --test ./test/service-isolation.test.js && node ./test/run-scheduler-check.mjs && node ./test/run-scheduler-host-check.mjs && node ./test/run-cron-check.mjs && node ./test/run-engine-check.mjs"
  }
}
