{
  "name": "@vssaros/dsh-scheduler",
  "version": "0.3.0",
  "description": "VsSaros Scheduler module for DeepSeek Harness: thin wrapper over the official @deepseek-ai/dsh-schedule service. 0.3.0 rewires the workbench to the NATIVE task-manager page (a verbatim MIT copy of @deepseek-ai/dsh-client-ui-schedule's client chunk in lib/client.native.js, whose apply() is replaced by a single desktopWorkbenches.register call). SSR page at /x/scheduler/ + legacy migration stay as before.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.native.js",
    "lib/pageShell.js",
    "lib/foundationRef.js",
    "lib/migrate.js",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-0 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@vssaros/dsh-workbenches"
      ]
    }
  },
  "vssaros": {
    "manifestVersion": 1,
    "module": "scheduler",
    "activityBar": {
      "containerId": "vssaros.dsh.scheduler",
      "title": {
        "zh": "定时任务",
        "en": "Scheduled Tasks"
      },
      "icon": "codicon:clock",
      "order": 95
    },
    "view": {
      "kind": "page",
      "route": "/x/scheduler/"
    },
    "legacyCounterpart": "vssaros.dsh.scheduler",
    "workbench": {
      "title": "自动化任务",
      "description": "自动化任务（原生界面）：搜索、状态筛选、查看详情与投递历史、改时间、删除。",
      "icon": "codicon:clock",
      "repository": "vssaros:scheduler",
      "customFrame": false,
      "headerLayout": "default"
    }
  },
  "license": "MIT",
  "scripts": {
    "check": "node ./test/run-scheduler-check.mjs"
  }
}
