# Transpile outputs — tsgo/esbuild generates旁路 .js files next to .ts sources.
# Already-tracked .js source files (third-party libs, test fixtures) are
# unaffected by .gitignore; only untracked transpile artifacts are ignored.
src/vs/**/*.js
!src/vs/base/browser/dompurify/dompurify.js
!src/vs/base/common/marked/marked.js
!src/vs/base/common/semver/semver.js
# Transpile outputs — .d.ts declaration files and .js.map source maps
src/vs/**/*.d.ts
src/vs/**/*.js.map
# Agent Studio webview esbuild bundles (debug/prod) — build artifacts
src/vs/sessions/contrib/agentStudio/webview/media-*/
